{
    "18": {
        "篇名": "論語·微子第十八",
        "1": {
            "3": {
                "1": "微子去之。",
                "2": "箕子爲之奴。",
                "3": "比干諫而死。",
                "4": "孔子曰。",
                "5": "殷有三仁焉。"
            }
        },
        "2": {
            "5": {
                "1": "柳下惠爲士師。",
                "2": "三黜。",
                "3": "人曰。",
                "4": "子未可以去乎。",
                "5": "曰。",
                "6": "直道而事人。",
                "7": "焉往而不三黜。",
                "8": "枉道而事人。",
                "9": "何必去父母之邦。"
            }
        },
        "3": {
            "7": {
                "1": "齊景公待孔子曰。",
                "2": "若季氏。",
                "3": "則吾不能。",
                "4": "以季。",
                "5": "孟之間待之。",
                "6": "曰。",
                "7": "吾老矣。",
                "8": "不能用也。",
                "9": "孔子行。"
            }
        },
        "4": {
            "9": {
                "1": "齊人歸女樂。",
                "2": "季桓子受之。",
                "3": "三日不朝。",
                "4": "孔子行。"
            }
        },
        "5": {
            "11": {
                "1": "楚狂接輿歌而過孔子。",
                "2": "曰。",
                "3": "鳳兮鳳兮。",
                "4": "何德之衰。",
                "5": "往者不可諫。",
                "6": "來者猶可追。",
                "7": "已而。",
                "8": "已而。",
                "9": "今之從政者殆而。"
            },
            "12": {
                "1": "孔子下。",
                "2": "欲與之言。",
                "3": "趨而辟之。",
                "4": "不得與之言。"
            }
        },
        "6": {
            "14": {
                "1": "長沮。",
                "2": "桀溺耦而耕。",
                "3": "孔子過之。",
                "4": "使子路問津焉。"
            },
            "15": {
                "1": "長沮曰。",
                "2": "夫執輿者爲誰。"
            },
            "16": {
                "1": "子路曰。",
                "2": "爲孔丘。"
            },
            "17": {
                "1": "曰。",
                "2": "是魯孔丘與。"
            },
            "18": {
                "1": "曰。",
                "2": "是也。"
            },
            "19": {
                "1": "曰。",
                "2": "是知津矣。"
            },
            "20": {
                "1": "問於桀溺。"
            },
            "21": {
                "1": "桀溺曰。",
                "2": "子爲誰。"
            },
            "22": {
                "1": "曰。",
                "2": "爲仲由。"
            },
            "23": {
                "1": "曰。",
                "2": "是魯孔丘之徒與。"
            },
            "24": {
                "1": "對曰。",
                "2": "然。"
            },
            "25": {
                "1": "曰。",
                "2": "滔滔者天下皆是也。",
                "3": "而誰以易之。",
                "4": "且而與其從辟人之士也。",
                "5": "豈若從辟世之士哉。",
                "6": "耰而不輟。"
            },
            "26": {
                "1": "子路行以告。"
            },
            "27": {
                "1": "夫子憮然。",
                "2": "曰。",
                "3": "鳥獸不可與同羣。",
                "4": "吾非斯人之徒與而誰與。",
                "5": "天下有道。",
                "6": "丘不與易也。"
            }
        },
        "7": {
            "29": {
                "1": "子路從而後。",
                "2": "遇丈人以杖荷蓧。"
            },
            "30": {
                "1": "子路問曰。",
                "2": "子見夫子乎。"
            },
            "31": {
                "1": "丈人曰。",
                "2": "四體不勤。",
                "3": "五穀不分。",
                "4": "孰爲夫子。",
                "5": "植其杖而芸。"
            },
            "32": {
                "1": "子路拱而立。"
            },
            "33": {
                "1": "止子路宿。",
                "2": "殺雞爲黍而食之。",
                "3": "見其二子焉。"
            },
            "34": {
                "1": "明日。",
                "2": "子路行以告。"
            },
            "35": {
                "1": "子曰。",
                "2": "隱者也。",
                "3": "使子路反見之。",
                "4": "至。",
                "5": "則行矣。"
            },
            "36": {
                "1": "子路曰。",
                "2": "不仕無義。",
                "3": "長幼之節。",
                "4": "不可廢也。",
                "5": "君臣之義。",
                "6": "如之何其廢之。",
                "7": "欲絜其身。",
                "8": "而亂大倫。",
                "9": "君子之仕也。",
                "10": "行其義也。",
                "11": "道之不行。",
                "12": "已知之矣。"
            }
        },
        "8": {
            "38": {
                "1": "逸民。",
                "2": "伯夷。",
                "3": "叔齊。",
                "4": "虞仲。",
                "5": "夷逸。",
                "6": "朱張。",
                "7": "柳下惠。",
                "8": "少連。",
                "9": "子曰。",
                "10": "不降其志。",
                "11": "不辱其身。",
                "12": "伯夷。",
                "13": "叔齊與。",
                "14": "謂柳下惠。",
                "15": "少連。",
                "16": "降志辱身矣。",
                "17": "言中倫。",
                "18": "行中慮。",
                "19": "其斯而已矣。",
                "20": "謂虞仲。",
                "21": "夷逸。",
                "22": "隱居放言。",
                "23": "身中清。",
                "24": "廢中權。",
                "25": "我則異於是。",
                "26": "無可無不可。"
            }
        },
        "9": {
            "40": {
                "1": "大師摯適齊。",
                "2": "亞飯干適楚。",
                "3": "三飯繚適蔡。",
                "4": "四飯缺適秦。",
                "5": "鼓方叔入於河。",
                "6": "播鼗武入於漢。",
                "7": "少師陽。",
                "8": "擊磬襄入於海。"
            }
        },
        "10": {
            "42": {
                "1": "周公謂魯公曰。",
                "2": "君子不施其親。",
                "3": "不使大臣怨乎不以。",
                "4": "故舊無大故。",
                "5": "則不棄也。",
                "6": "無求備於一人。"
            }
        },
        "11": {
            "44": {
                "1": "周有八士。",
                "2": "伯達。",
                "3": "伯适。",
                "4": "仲突。",
                "5": "仲忽。",
                "6": "叔夜。",
                "7": "叔夏。",
                "8": "季隨。",
                "9": "季騧。"
            }
        }
    }
}