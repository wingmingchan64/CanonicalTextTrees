{
    "03": {
        "篇名": "論語·八佾第三",
        "1": {
            "3": {
                "1": "孔子謂季氏。",
                "2": "八佾舞於庭。",
                "3": "是可忍也。",
                "4": "孰不可忍也。"
            }
        },
        "2": {
            "5": {
                "1": "三家者以雍徹。",
                "2": "子曰。",
                "3": "相維辟公。",
                "4": "天子穆穆。",
                "5": "奚取於三家之堂。"
            }
        },
        "3": {
            "7": {
                "1": "子曰。",
                "2": "人而不仁。",
                "3": "如禮何。",
                "4": "人而不仁。",
                "5": "如樂何。"
            }
        },
        "4": {
            "9": {
                "1": "林放問禮之本。",
                "2": "子曰。",
                "3": "大哉問。",
                "4": "禮。",
                "5": "與其奢也。",
                "6": "寧儉。",
                "7": "喪。",
                "8": "與其易也。",
                "9": "寧戚。"
            }
        },
        "5": {
            "11": {
                "1": "子曰。",
                "2": "夷狄之有君。",
                "3": "不如諸夏之亡也。"
            }
        },
        "6": {
            "13": {
                "1": "季氏旅於泰山。",
                "2": "子謂冉有曰。",
                "3": "女弗能救與。",
                "4": "對曰。",
                "5": "不能。",
                "6": "子曰。",
                "7": "嗚呼。",
                "8": "曾謂泰山不如林放乎。"
            }
        },
        "7": {
            "15": {
                "1": "子曰。",
                "2": "君子無所爭。",
                "3": "必也射乎。",
                "4": "揖讓而升。",
                "5": "下而飲。",
                "6": "其爭也君子。"
            }
        },
        "8": {
            "17": {
                "1": "子夏問曰。",
                "2": "巧笑倩兮。",
                "3": "美目盼兮。",
                "4": "素以爲絢兮。",
                "5": "何謂也。",
                "6": "子曰。",
                "7": "繪事後素。"
            },
            "18": {
                "1": "曰。",
                "2": "禮後乎。",
                "3": "子曰。",
                "4": "起予者商也。",
                "5": "始可與言詩已矣。"
            }
        },
        "9": {
            "20": {
                "1": "子曰。",
                "2": "夏禮。",
                "3": "吾能言之。",
                "4": "杞不足徵也。",
                "5": "殷禮。",
                "6": "吾能言之。",
                "7": "宋不足徵也。",
                "8": "文獻不足故也。",
                "9": "足。",
                "10": "則吾能徵之矣。"
            }
        },
        "10": {
            "22": {
                "1": "子曰。",
                "2": "禘自旣灌而往者。",
                "3": "吾不欲觀之矣。"
            }
        },
        "11": {
            "24": {
                "1": "或問禘之說。",
                "2": "子曰。",
                "3": "不知也。",
                "4": "知其說者之於天下也。",
                "5": "其如示諸斯乎。",
                "6": "指其掌。"
            }
        },
        "12": {
            "26": {
                "1": "祭如在。",
                "2": "祭神如神在。",
                "3": "子曰。",
                "4": "吾不與祭。",
                "5": "如不祭。"
            }
        },
        "13": {
            "28": {
                "1": "王孫賈問曰。",
                "2": "與其媚於奧。",
                "3": "寧媚於竈。",
                "4": "何謂也。",
                "5": "子曰。",
                "6": "不然。",
                "7": "獲罪於天。",
                "8": "無所禱也。"
            }
        },
        "14": {
            "30": {
                "1": "子曰。",
                "2": "周監於二代。",
                "3": "郁郁乎文哉。",
                "4": "吾從周。"
            }
        },
        "15": {
            "32": {
                "1": "子入太廟。",
                "2": "每事問。",
                "3": "或曰。",
                "4": "孰謂鄹人之子知禮乎。",
                "5": "入大廟。",
                "6": "每事問。",
                "7": "子聞之。",
                "8": "曰。",
                "9": "是禮也。"
            }
        },
        "16": {
            "34": {
                "1": "子曰。",
                "2": "射不主皮。",
                "3": "爲力不同科。",
                "4": "古之道也。"
            }
        },
        "17": {
            "36": {
                "1": "子貢欲去告朔之餼羊。",
                "2": "子曰。",
                "3": "賜也。",
                "4": "爾愛其羊。",
                "5": "我愛其禮。"
            }
        },
        "18": {
            "38": {
                "1": "子曰。",
                "2": "事君盡禮。",
                "3": "人以爲諂也。"
            }
        },
        "19": {
            "40": {
                "1": "定公問。",
                "2": "君使臣。",
                "3": "臣事君。",
                "4": "如之何。",
                "5": "孔子對曰。",
                "6": "君使臣以禮。",
                "7": "臣事君以忠。"
            }
        },
        "20": {
            "42": {
                "1": "子曰。",
                "2": "關雎。",
                "3": "樂而不淫。",
                "4": "哀而不傷。"
            }
        },
        "21": {
            "44": {
                "1": "哀公問社於宰我。",
                "2": "宰我對曰。",
                "3": "夏后氏以松。",
                "4": "殷人以柏。",
                "5": "周人以栗。",
                "6": "曰使民戰栗。",
                "7": "子聞之。",
                "8": "曰。",
                "9": "成事不說。",
                "10": "遂事不諫。",
                "11": "旣往不咎。"
            }
        },
        "22": {
            "46": {
                "1": "子曰。",
                "2": "管仲之器小哉。"
            },
            "47": {
                "1": "或曰。",
                "2": "管仲儉乎。",
                "3": "曰。",
                "4": "管氏有三歸。",
                "5": "官事不攝。",
                "6": "焉得儉。"
            },
            "48": {
                "1": "然則管仲知禮乎。",
                "2": "曰。",
                "3": "邦君樹塞門。",
                "4": "管氏亦樹塞門。",
                "5": "邦君爲兩君之好。",
                "6": "有反坫。",
                "7": "管氏亦有反坫。",
                "8": "管氏而知禮。",
                "9": "孰不知禮。"
            }
        },
        "23": {
            "50": {
                "1": "子語魯大師樂。",
                "2": "曰。",
                "3": "樂其可知也。",
                "4": "始作。",
                "5": "翕如也。",
                "6": "從之。",
                "7": "純如也。",
                "8": "皦如也。",
                "9": "繹如也。",
                "10": "以成。"
            }
        },
        "24": {
            "52": {
                "1": "儀封人請見。",
                "2": "曰。",
                "3": "君子之至於斯也。",
                "4": "吾未嘗不得見也。",
                "5": "從者見之。",
                "6": "出曰。",
                "7": "二三子何患於喪乎。",
                "8": "天下之無道也久矣。",
                "9": "天將以夫子爲木鐸。"
            }
        },
        "25": {
            "54": {
                "1": "子謂韶。",
                "2": "盡美矣。",
                "3": "又盡善也。",
                "4": "謂武。",
                "5": "盡美矣。",
                "6": "未盡善也。"
            }
        },
        "26": {
            "56": {
                "1": "子曰。",
                "2": "居上不寬。",
                "3": "爲禮不敬。",
                "4": "臨喪不哀。",
                "5": "吾何以觀之哉。"
            }
        }
    }
}