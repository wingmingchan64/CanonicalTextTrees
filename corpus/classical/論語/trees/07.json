{
    "07": {
        "篇名": "論語·述而第七",
        "1": {
            "3": {
                "1": "子曰。",
                "2": "述而不作。",
                "3": "信而好古。",
                "4": "竊比於我老彭。"
            }
        },
        "2": {
            "5": {
                "1": "子曰。",
                "2": "默而識之。",
                "3": "學而不厭。",
                "4": "誨人不倦。",
                "5": "何有於我哉。"
            }
        },
        "3": {
            "7": {
                "1": "子曰。",
                "2": "德之不修。",
                "3": "學之不講。",
                "4": "聞義不能徙。",
                "5": "不善不能改。",
                "6": "是吾憂也。"
            }
        },
        "4": {
            "9": {
                "1": "子之燕居。",
                "2": "申申如也。",
                "3": "夭夭如也。"
            }
        },
        "5": {
            "11": {
                "1": "子曰。",
                "2": "甚矣。",
                "3": "吾衰也。",
                "4": "久矣。",
                "5": "吾不復夢見周公。"
            }
        },
        "6": {
            "13": {
                "1": "子曰。",
                "2": "志於道。",
                "3": "據於德。",
                "4": "依於仁。",
                "5": "遊於藝。"
            }
        },
        "7": {
            "15": {
                "1": "子曰。",
                "2": "自行束脩以上。",
                "3": "吾未嘗無誨焉。"
            }
        },
        "8": {
            "17": {
                "1": "子曰。",
                "2": "不憤不啟。",
                "3": "不悱不發。",
                "4": "舉一隅不以三隅反。",
                "5": "則不復也。"
            }
        },
        "9": {
            "19": {
                "1": "子食於有喪者之側。",
                "2": "未嘗飽也。"
            }
        },
        "10": {
            "21": {
                "1": "子於是日哭。",
                "2": "則不歌。"
            }
        },
        "11": {
            "23": {
                "1": "子謂顏淵曰。",
                "2": "用之則行。",
                "3": "舍之則藏。",
                "4": "惟我與爾有是夫。"
            },
            "24": {
                "1": "子路曰。",
                "2": "子行三軍。",
                "3": "則誰與。"
            },
            "25": {
                "1": "子曰。",
                "2": "暴虎馮河。",
                "3": "死而無悔者。",
                "4": "吾不與也。",
                "5": "必也臨事而懼。",
                "6": "好謀而成者也。"
            }
        },
        "12": {
            "27": {
                "1": "子曰。",
                "2": "富而可求也。",
                "3": "雖執鞭之士。",
                "4": "吾亦爲之。",
                "5": "如不可求。",
                "6": "從吾所好。"
            }
        },
        "13": {
            "29": {
                "1": "子之所愼。",
                "2": "齋。",
                "3": "戰。",
                "4": "疾。"
            }
        },
        "14": {
            "31": {
                "1": "子在齊聞韶。",
                "2": "三月不知肉味。",
                "3": "曰。",
                "4": "不圖爲樂之至於斯也。"
            }
        },
        "15": {
            "33": {
                "1": "冉有曰。",
                "2": "夫子爲衞君乎。",
                "3": "子貢曰。",
                "4": "諾。",
                "5": "吾將問之。"
            },
            "34": {
                "1": "入。",
                "2": "曰。",
                "3": "伯夷。",
                "4": "叔齊何人也。",
                "5": "曰。",
                "6": "古之賢人也。",
                "7": "曰。",
                "8": "怨乎。",
                "9": "曰。",
                "10": "求仁而得仁。",
                "11": "又何怨。"
            },
            "35": {
                "1": "出。",
                "2": "曰。",
                "3": "夫子不爲也。"
            }
        },
        "16": {
            "37": {
                "1": "子曰。",
                "2": "飯疏食飲水。",
                "3": "曲肱而枕之。",
                "4": "樂亦在其中矣。",
                "5": "不義而富且貴。",
                "6": "於我如浮雲。"
            }
        },
        "17": {
            "39": {
                "1": "子曰。",
                "2": "加我數年。",
                "3": "五十以學易。",
                "4": "可以無大過矣。"
            }
        },
        "18": {
            "41": {
                "1": "子所雅言。",
                "2": "詩。",
                "3": "書。",
                "4": "執禮。",
                "5": "皆雅言也。"
            }
        },
        "19": {
            "43": {
                "1": "葉公問孔子於子路。",
                "2": "子路不對。",
                "3": "子曰。",
                "4": "女奚不曰。",
                "5": "其爲人也。",
                "6": "發憤忘食。",
                "7": "樂以忘憂。",
                "8": "不知老之將至云爾。"
            }
        },
        "20": {
            "45": {
                "1": "子曰。",
                "2": "我非生而知之者。",
                "3": "好古。",
                "4": "敏以求之者也。"
            }
        },
        "21": {
            "47": {
                "1": "子不語怪。",
                "2": "力。",
                "3": "亂。",
                "4": "神。"
            }
        },
        "22": {
            "49": {
                "1": "子曰。",
                "2": "三人行。",
                "3": "必有我師焉。",
                "4": "擇其善者而從之。",
                "5": "其不善者而改之。"
            }
        },
        "23": {
            "51": {
                "1": "子曰。",
                "2": "天生德於予。",
                "3": "桓魋其如予何。"
            }
        },
        "24": {
            "53": {
                "1": "子曰。",
                "2": "二三子以我爲隱乎。",
                "3": "吾無隱乎爾。",
                "4": "吾無行而不與二三子者。",
                "5": "是丘也。"
            }
        },
        "25": {
            "55": {
                "1": "子以四教。",
                "2": "文。",
                "3": "行。",
                "4": "忠。",
                "5": "信。"
            }
        },
        "26": {
            "57": {
                "1": "子曰。",
                "2": "聖人。",
                "3": "吾不得而見之矣。",
                "4": "得見君子者。",
                "5": "斯可矣。"
            },
            "58": {
                "1": "子曰。",
                "2": "善人。",
                "3": "吾不得而見之矣。",
                "4": "得見有恆者。",
                "5": "斯可矣。",
                "6": "亡而爲有。",
                "7": "虛而爲盈。",
                "8": "約而爲泰。",
                "9": "難乎有恆矣。"
            }
        },
        "27": {
            "60": {
                "1": "子釣而不綱。",
                "2": "弋不射宿。"
            }
        },
        "28": {
            "62": {
                "1": "子曰。",
                "2": "蓋有不知而作之者。",
                "3": "我無是也。",
                "4": "多聞。",
                "5": "擇其善者而從之。",
                "6": "多見而識之。",
                "7": "知之次也。"
            }
        },
        "29": {
            "64": {
                "1": "互鄕難與言。",
                "2": "童子見。",
                "3": "門人惑。",
                "4": "子曰。",
                "5": "與其進也。",
                "6": "不與其退也。",
                "7": "唯何甚。",
                "8": "人絜己以進。",
                "9": "與其絜也。",
                "10": "不保其往也。"
            }
        },
        "30": {
            "66": {
                "1": "子曰。",
                "2": "仁遠乎哉。",
                "3": "我欲仁。",
                "4": "斯仁至矣。"
            }
        },
        "31": {
            "68": {
                "1": "陳司敗問。",
                "2": "昭公知禮乎。",
                "3": "孔子曰。",
                "4": "知禮。"
            },
            "69": {
                "1": "孔子退。",
                "2": "揖巫馬期而進之。",
                "3": "曰。",
                "4": "吾聞君子不黨。",
                "5": "君子亦黨乎。",
                "6": "君取於吳。",
                "7": "爲同姓。",
                "8": "謂之吳孟子。",
                "9": "君而知禮。",
                "10": "孰不知禮。"
            },
            "70": {
                "1": "巫馬期以告。",
                "2": "子曰。",
                "3": "丘也幸。",
                "4": "苟有過。",
                "5": "人必知之。"
            }
        },
        "32": {
            "72": {
                "1": "子與人歌而善。",
                "2": "必使反之。",
                "3": "而後和之。"
            }
        },
        "33": {
            "74": {
                "1": "子曰。",
                "2": "文莫吾猶人也。",
                "3": "躬行君子。",
                "4": "則吾未之有得。"
            }
        },
        "34": {
            "76": {
                "1": "子曰。",
                "2": "若聖與仁。",
                "3": "則吾豈敢。",
                "4": "抑爲之不厭。",
                "5": "誨人不倦。",
                "6": "則可謂云爾已矣。",
                "7": "公西華曰。",
                "8": "正唯弟子不能學也。"
            }
        },
        "35": {
            "78": {
                "1": "子疾病。",
                "2": "子路請禱。",
                "3": "子曰。",
                "4": "有諸。",
                "5": "子路對曰。",
                "6": "有之。",
                "7": "誄曰。",
                "8": "禱爾於上下神祇。",
                "9": "子曰。",
                "10": "丘之禱久矣。"
            }
        },
        "36": {
            "80": {
                "1": "子曰。",
                "2": "奢則不孫。",
                "3": "儉則固。",
                "4": "與其不孫也。",
                "5": "寧固。"
            }
        },
        "37": {
            "82": {
                "1": "子曰。",
                "2": "君子坦蕩蕩。",
                "3": "小人長戚戚。"
            }
        },
        "38": {
            "84": {
                "1": "子溫而厲。",
                "2": "威而不猛。",
                "3": "恭而安。"
            }
        }
    }
}