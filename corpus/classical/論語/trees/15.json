{
    "15": {
        "篇名": "論語·衞靈公第十五",
        "1": {
            "3": {
                "1": "衞靈公問陳於孔子。",
                "2": "孔子對曰。",
                "3": "俎豆之事。",
                "4": "則嘗聞之矣。",
                "5": "軍旅之事。",
                "6": "未之學也。"
            }
        },
        "2": {
            "5": {
                "1": "明日遂行。",
                "2": "在陳絕糧。",
                "3": "從者病。",
                "4": "莫能興。",
                "5": "子路慍見曰。",
                "6": "君子亦有窮乎。",
                "7": "子曰。",
                "8": "君子固窮。",
                "9": "小人窮斯濫矣。"
            }
        },
        "3": {
            "7": {
                "1": "子曰。",
                "2": "賜也。",
                "3": "女以予爲多學而識之者與。",
                "4": "對曰。",
                "5": "然。",
                "6": "非與。",
                "7": "曰。",
                "8": "非也。",
                "9": "予一以貫之。"
            }
        },
        "4": {
            "9": {
                "1": "子曰。",
                "2": "由。",
                "3": "知德者鮮矣。"
            }
        },
        "5": {
            "11": {
                "1": "子曰。",
                "2": "無爲而治者。",
                "3": "其舜也與。",
                "4": "夫何爲哉。",
                "5": "恭己正南面而已矣。"
            }
        },
        "6": {
            "13": {
                "1": "子張問行。",
                "2": "子曰。",
                "3": "言忠信。",
                "4": "行篤敬。",
                "5": "雖蠻貊之邦。",
                "6": "行矣。",
                "7": "言不忠信。",
                "8": "行不篤敬。",
                "9": "雖州里。",
                "10": "行乎哉。",
                "11": "立則見其參於前也。",
                "12": "在輿則見其倚於衡也。",
                "13": "夫然後行。",
                "14": "子張書諸紳。"
            }
        },
        "7": {
            "15": {
                "1": "子曰。",
                "2": "直哉。",
                "3": "史魚。",
                "4": "邦有道。",
                "5": "如矢。",
                "6": "邦無道。",
                "7": "如矢。",
                "8": "君子哉。",
                "9": "蘧伯玉。",
                "10": "邦有道。",
                "11": "則仕。",
                "12": "邦無道。",
                "13": "則可卷而懷之。"
            }
        },
        "8": {
            "17": {
                "1": "子曰。",
                "2": "可與言而不與言。",
                "3": "失人。",
                "4": "不可與言而與之言。",
                "5": "失言。",
                "6": "知者不失人。",
                "7": "亦不失言。"
            }
        },
        "9": {
            "19": {
                "1": "子曰。",
                "2": "志士仁人。",
                "3": "無求生以害仁。",
                "4": "有殺身以成仁。"
            }
        },
        "10": {
            "21": {
                "1": "子貢問爲仁。",
                "2": "子曰。",
                "3": "工欲善其事。",
                "4": "必先利其器。",
                "5": "居是邦也。",
                "6": "事其大夫之賢者。",
                "7": "友其士之仁者。"
            }
        },
        "11": {
            "23": {
                "1": "顏淵問爲邦。",
                "2": "子曰。",
                "3": "行夏之時。",
                "4": "乘殷之輅。",
                "5": "服周之冕。",
                "6": "樂則韶舞。",
                "7": "放鄭聲。",
                "8": "遠佞人。",
                "9": "鄭聲淫。",
                "10": "佞人殆。"
            }
        },
        "12": {
            "25": {
                "1": "子曰。",
                "2": "人無遠慮。",
                "3": "必有近憂。"
            }
        },
        "13": {
            "27": {
                "1": "子曰。",
                "2": "已矣乎。",
                "3": "吾未見好德如好色者也。"
            }
        },
        "14": {
            "29": {
                "1": "子曰。",
                "2": "臧文仲其竊位者與。",
                "3": "知柳下惠之賢而不與立也。"
            }
        },
        "15": {
            "31": {
                "1": "子曰。",
                "2": "躬自厚。",
                "3": "而薄責於人。",
                "4": "則遠怨矣。"
            }
        },
        "16": {
            "33": {
                "1": "子曰。",
                "2": "不曰如之何。",
                "3": "如之何者。",
                "4": "吾末如之何也已矣。"
            }
        },
        "17": {
            "35": {
                "1": "子曰。",
                "2": "羣居終日。",
                "3": "言不及義。",
                "4": "好行小慧。",
                "5": "難矣哉。"
            }
        },
        "18": {
            "37": {
                "1": "子曰。",
                "2": "君子義以爲質。",
                "3": "禮以行之。",
                "4": "孫以出之。",
                "5": "信以成之。",
                "6": "君子哉。"
            }
        },
        "19": {
            "39": {
                "1": "子曰。",
                "2": "君子病無能焉。",
                "3": "不病人之不己知也。"
            }
        },
        "20": {
            "41": {
                "1": "子曰。",
                "2": "君子疾沒世而名不稱焉。"
            }
        },
        "21": {
            "43": {
                "1": "子曰。",
                "2": "君子求諸己。",
                "3": "小人求諸人。"
            }
        },
        "22": {
            "45": {
                "1": "子曰。",
                "2": "君子矜而不爭。",
                "3": "羣而不黨。"
            }
        },
        "23": {
            "47": {
                "1": "子曰。",
                "2": "君子不以言舉人。",
                "3": "不以人廢言。"
            }
        },
        "24": {
            "49": {
                "1": "子貢問曰。",
                "2": "有一言而可以終身行之者乎。",
                "3": "子曰。",
                "4": "其恕乎。",
                "5": "己所不欲。",
                "6": "勿施於人。"
            }
        },
        "25": {
            "51": {
                "1": "子曰。",
                "2": "吾之於人也。",
                "3": "誰毀誰譽。",
                "4": "如有所譽者。",
                "5": "其有所試矣。",
                "6": "斯民也。",
                "7": "三代之所以直道而行也。"
            }
        },
        "26": {
            "53": {
                "1": "子曰。",
                "2": "吾猶及史之闕文也。",
                "3": "有馬者借人乘之。",
                "4": "今亡矣夫。"
            }
        },
        "27": {
            "55": {
                "1": "子曰。",
                "2": "巧言亂德。",
                "3": "小不忍。",
                "4": "則亂大謀。"
            }
        },
        "28": {
            "57": {
                "1": "子曰。",
                "2": "眾惡之。",
                "3": "必察焉。",
                "4": "眾好之。",
                "5": "必察焉。"
            }
        },
        "29": {
            "59": {
                "1": "子曰。",
                "2": "人能弘道。",
                "3": "非道弘人。"
            }
        },
        "30": {
            "61": {
                "1": "子曰。",
                "2": "過而不改。",
                "3": "是謂過矣。"
            }
        },
        "31": {
            "63": {
                "1": "子曰。",
                "2": "吾嘗終日不食。",
                "3": "終夜不寢。",
                "4": "以思。",
                "5": "無益。",
                "6": "不如學也。"
            }
        },
        "32": {
            "65": {
                "1": "子曰。",
                "2": "君子謀道不謀食。",
                "3": "耕也。",
                "4": "餒在其中矣。",
                "5": "學也。",
                "6": "祿在其中矣。",
                "7": "君子憂道不憂貧。"
            }
        },
        "33": {
            "67": {
                "1": "子曰。",
                "2": "知及之。",
                "3": "仁不能守之。",
                "4": "雖得之。",
                "5": "必失之。",
                "6": "知及之。",
                "7": "仁能守之。",
                "8": "不莊以涖之。",
                "9": "則民不敬。",
                "10": "知及之。",
                "11": "仁能守之。",
                "12": "莊以涖之。",
                "13": "動之不以禮。",
                "14": "未善也。"
            }
        },
        "34": {
            "69": {
                "1": "子曰。",
                "2": "君子不可小知而可大受也。",
                "3": "小人不可大受而可小知也。"
            }
        },
        "35": {
            "71": {
                "1": "子曰。",
                "2": "民之於仁也。",
                "3": "甚於水火。",
                "4": "水火。",
                "5": "吾見蹈而死者矣。",
                "6": "未見蹈仁而死者也。"
            }
        },
        "36": {
            "73": {
                "1": "子曰。",
                "2": "當仁不讓於師。"
            }
        },
        "37": {
            "75": {
                "1": "子曰。",
                "2": "君子貞而不諒。"
            }
        },
        "38": {
            "77": {
                "1": "子曰。",
                "2": "事君。",
                "3": "敬其事而後其食。"
            }
        },
        "39": {
            "79": {
                "1": "子曰。",
                "2": "有教無類。"
            }
        },
        "40": {
            "81": {
                "1": "子曰。",
                "2": "道不同。",
                "3": "不相爲謀。"
            }
        },
        "41": {
            "83": {
                "1": "子曰。",
                "2": "辭達而已矣。"
            }
        },
        "42": {
            "85": {
                "1": "師冕見。",
                "2": "及階。",
                "3": "子曰。",
                "4": "階也。",
                "5": "及席。",
                "6": "子曰。",
                "7": "席也。",
                "8": "皆坐。",
                "9": "子告之曰。",
                "10": "某在斯。",
                "11": "某在斯。"
            },
            "86": {
                "1": "師冕出。",
                "2": "子張問曰。",
                "3": "與師言之道與。",
                "4": "子曰。",
                "5": "然。",
                "6": "固相師之道也。"
            }
        }
    }
}