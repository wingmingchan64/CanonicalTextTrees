{
    "08": {
        "篇名": "論語·泰伯第八",
        "1": {
            "3": {
                "1": "子曰。",
                "2": "泰伯。",
                "3": "其可謂至德也已矣。",
                "4": "三以天下讓。",
                "5": "民無得而稱焉。"
            }
        },
        "2": {
            "5": {
                "1": "子曰。",
                "2": "恭而無禮則勞。",
                "3": "愼而無禮則葸。",
                "4": "勇而無禮則亂。",
                "5": "直而無禮則絞。",
                "6": "君子篤於親。",
                "7": "則民興於仁。",
                "8": "故舊不遺。",
                "9": "則民不偸。"
            }
        },
        "3": {
            "7": {
                "1": "曾子有疾。",
                "2": "召門弟子曰。",
                "3": "啟予足。",
                "4": "啟予手。",
                "5": "詩云。",
                "6": "戰戰兢兢。",
                "7": "如臨深淵。",
                "8": "如履薄冰。",
                "9": "而今而後。",
                "10": "吾知免夫。",
                "11": "小子。"
            }
        },
        "4": {
            "9": {
                "1": "曾子有疾。",
                "2": "孟敬子問之。",
                "3": "曾子言曰。",
                "4": "鳥之將死。",
                "5": "其鳴也哀。",
                "6": "人之將死。",
                "7": "其言也善。",
                "8": "君子所貴乎道者三。",
                "9": "動容貌。",
                "10": "斯遠暴慢矣。",
                "11": "正顏色。",
                "12": "斯近信矣。",
                "13": "出辭氣。",
                "14": "斯遠鄙倍矣。",
                "15": "籩豆之事。",
                "16": "則有司存。"
            }
        },
        "5": {
            "11": {
                "1": "曾子曰。",
                "2": "以能問於不能。",
                "3": "以多問於寡。",
                "4": "有若無。",
                "5": "實若虛。",
                "6": "犯而不校。",
                "7": "昔者吾友嘗從事於斯矣。"
            }
        },
        "6": {
            "13": {
                "1": "曾子曰。",
                "2": "可以託六尺之孤。",
                "3": "可以寄百里之命。",
                "4": "臨大節而不可奪也。",
                "5": "君子人與。",
                "6": "君子人也。"
            }
        },
        "7": {
            "15": {
                "1": "曾子曰。",
                "2": "士不可以不弘毅。",
                "3": "任重而道遠。",
                "4": "仁以爲己任。",
                "5": "不亦重乎。",
                "6": "死而後已。",
                "7": "不亦遠乎。"
            }
        },
        "8": {
            "17": {
                "1": "子曰。",
                "2": "興於詩。",
                "3": "立於禮。",
                "4": "成於樂。"
            }
        },
        "9": {
            "19": {
                "1": "子曰。",
                "2": "民可使由之。",
                "3": "不可使知之。"
            }
        },
        "10": {
            "21": {
                "1": "子曰。",
                "2": "好勇疾貧。",
                "3": "亂也。",
                "4": "人而不仁。",
                "5": "疾之已甚。",
                "6": "亂也。"
            }
        },
        "11": {
            "23": {
                "1": "子曰。",
                "2": "如有周公之才之美。",
                "3": "使驕且吝。",
                "4": "其餘不足觀也已矣。"
            }
        },
        "12": {
            "25": {
                "1": "子曰。",
                "2": "三年學。",
                "3": "不至於穀。",
                "4": "不易得也。"
            }
        },
        "13": {
            "27": {
                "1": "子曰。",
                "2": "篤信好學。",
                "3": "守死善道。",
                "4": "危邦不入。",
                "5": "亂邦不居。",
                "6": "天下有道則見。",
                "7": "無道則隱。",
                "8": "邦有道。",
                "9": "貧且賤焉。",
                "10": "恥也。",
                "11": "邦無道。",
                "12": "富且貴焉。",
                "13": "恥也。"
            }
        },
        "14": {
            "29": {
                "1": "子曰。",
                "2": "不在其位。",
                "3": "不謀其政。"
            }
        },
        "15": {
            "31": {
                "1": "子曰。",
                "2": "師摯之始。",
                "3": "關雎之亂。",
                "4": "洋洋乎盈耳哉。"
            }
        },
        "16": {
            "33": {
                "1": "子曰。",
                "2": "狂而不直。",
                "3": "侗而不愿。",
                "4": "悾悾而不信。",
                "5": "吾不知之矣。"
            }
        },
        "17": {
            "35": {
                "1": "子曰。",
                "2": "學如不及。",
                "3": "猶恐失之。"
            }
        },
        "18": {
            "37": {
                "1": "子曰。",
                "2": "巍巍乎。",
                "3": "舜禹之有天下也而不與焉。"
            }
        },
        "19": {
            "39": {
                "1": "子曰。",
                "2": "大哉。",
                "3": "堯之爲君也。",
                "4": "巍巍乎。",
                "5": "唯天爲大。",
                "6": "唯堯則之。",
                "7": "蕩蕩乎。",
                "8": "民無能名焉。",
                "9": "巍巍乎。",
                "10": "其有成功也。",
                "11": "煥乎。",
                "12": "其有文章。"
            }
        },
        "20": {
            "41": {
                "1": "舜有臣五人而天下治。",
                "2": "武王曰。",
                "3": "予有亂臣十人。",
                "4": "孔子曰。",
                "5": "才難。",
                "6": "不其然乎。",
                "7": "唐虞之際。",
                "8": "於斯爲盛。",
                "9": "有婦人焉。",
                "10": "九人而已。",
                "11": "三分天下有其二。",
                "12": "以服事殷。",
                "13": "周之德。",
                "14": "其可謂至德也已矣。"
            }
        },
        "21": {
            "43": {
                "1": "子曰。",
                "2": "禹。",
                "3": "吾無間然矣。",
                "4": "菲飲食而致孝乎鬼神。",
                "5": "惡衣服而致美乎黻冕。",
                "6": "卑宮室而盡力乎溝洫。",
                "7": "禹。",
                "8": "吾無間然矣。"
            }
        }
    }
}