{
    "20": {
        "篇名": "論語·堯曰第二十",
        "1": {
            "3": {
                "1": "堯曰。",
                "2": "咨。",
                "3": "爾舜。",
                "4": "天之歷數在爾躬。",
                "5": "允執其中。",
                "6": "四海困窮。",
                "7": "天祿永終。"
            },
            "4": {
                "1": "舜亦以命禹。"
            },
            "5": {
                "1": "曰。",
                "2": "予小子履。",
                "3": "敢用玄牡。",
                "4": "敢昭告於皇皇后帝。",
                "5": "有罪不敢赦。",
                "6": "帝臣不蔽。",
                "7": "簡在帝心。",
                "8": "朕躬有罪。",
                "9": "無以萬方。",
                "10": "萬方有罪。",
                "11": "罪在朕躬。"
            },
            "6": {
                "1": "周有大賚。",
                "2": "善人是富。",
                "3": "雖有周親。",
                "4": "不如仁人。",
                "5": "百姓有過。",
                "6": "在予一人。"
            },
            "7": {
                "1": "謹權量。",
                "2": "審法度。",
                "3": "修廢官。",
                "4": "四方之政行焉。",
                "5": "興滅國。",
                "6": "繼絕世。",
                "7": "舉逸民。",
                "8": "天下之民歸心焉。"
            },
            "8": {
                "1": "所重。",
                "2": "民。",
                "3": "食。",
                "4": "喪。",
                "5": "祭。"
            },
            "9": {
                "1": "寬則得眾。",
                "2": "信則民任焉。",
                "3": "敏則有功。",
                "4": "公則說。"
            }
        },
        "2": {
            "11": {
                "1": "子張問於孔子曰。",
                "2": "何如斯可以從政矣。"
            },
            "12": {
                "1": "子曰。",
                "2": "尊五美。",
                "3": "屛四惡。",
                "4": "斯可以從政矣。"
            },
            "13": {
                "1": "子張曰。",
                "2": "何謂五美。"
            },
            "14": {
                "1": "子曰。",
                "2": "君子惠而不費。",
                "3": "勞而不怨。",
                "4": "欲而不貪。",
                "5": "泰而不驕。",
                "6": "威而不猛。"
            },
            "15": {
                "1": "子張曰。",
                "2": "何謂惠而不費。"
            },
            "16": {
                "1": "子曰。",
                "2": "因民之所利而利之。",
                "3": "斯不亦惠而不費乎。",
                "4": "擇可勞而勞之。",
                "5": "又誰怨。",
                "6": "欲仁而得仁。",
                "7": "又焉貪。",
                "8": "君子無眾寡。",
                "9": "無小大。",
                "10": "無敢慢。",
                "11": "斯不亦泰而不驕乎。",
                "12": "君子正其衣冠。",
                "13": "尊其瞻視。",
                "14": "儼然人望而畏之。",
                "15": "斯不亦威而不猛乎。"
            },
            "17": {
                "1": "子張曰。",
                "2": "何謂四惡。"
            },
            "18": {
                "1": "子曰。",
                "2": "不教而殺謂之虐。",
                "3": "不戒視成謂之暴。",
                "4": "慢令致期謂之賊。",
                "5": "猶之與人也。",
                "6": "出納之吝謂之有司。"
            }
        },
        "3": {
            "20": {
                "1": "孔子曰。",
                "2": "不知命。",
                "3": "無以爲君子也。",
                "4": "不知禮。",
                "5": "無以立也。",
                "6": "不知言。",
                "7": "無以知人也。"
            }
        }
    }
}