{
    "05": {
        "篇名": "論語·公冶長第五",
        "1": {
            "3": {
                "1": "子謂公冶長。",
                "2": "可妻也。",
                "3": "雖在縲絏之中。",
                "4": "非其罪也。",
                "5": "以其子妻之。"
            }
        },
        "2": {
            "5": {
                "1": "子謂南容。",
                "2": "邦有道。",
                "3": "不廢。",
                "4": "邦無道。",
                "5": "免於刑戮。",
                "6": "以其兄之子妻之。"
            }
        },
        "3": {
            "7": {
                "1": "子謂子賤。",
                "2": "君子哉若人。",
                "3": "魯無君子者。",
                "4": "斯焉取斯。"
            }
        },
        "4": {
            "9": {
                "1": "子貢問曰。",
                "2": "賜也何如。",
                "3": "子曰。",
                "4": "女。",
                "5": "器也。",
                "6": "曰。",
                "7": "何器也。",
                "8": "曰。",
                "9": "瑚璉也。"
            }
        },
        "5": {
            "11": {
                "1": "或曰。",
                "2": "雍也仁而不佞。",
                "3": "子曰。",
                "4": "焉用佞。",
                "5": "禦人以口給。",
                "6": "屢憎於人。",
                "7": "不知其仁。",
                "8": "焉用佞。"
            }
        },
        "6": {
            "13": {
                "1": "子使漆雕開仕。",
                "2": "對曰。",
                "3": "吾斯之未能信。",
                "4": "子說。"
            }
        },
        "7": {
            "15": {
                "1": "子曰。",
                "2": "道不行。",
                "3": "乘桴浮於海。",
                "4": "從我者。",
                "5": "其由與。",
                "6": "子路聞之喜。",
                "7": "子曰。",
                "8": "由也好勇過我。",
                "9": "無所取材。"
            }
        },
        "8": {
            "17": {
                "1": "孟武伯問。",
                "2": "子路仁乎。",
                "3": "子曰。",
                "4": "不知也。",
                "5": "又問。",
                "6": "子曰。",
                "7": "由也。",
                "8": "千乘之國。",
                "9": "可使治其賦也。",
                "10": "不知其仁也。"
            },
            "18": {
                "1": "求也何如。",
                "2": "子曰。",
                "3": "求也。",
                "4": "千室之邑。",
                "5": "百乘之家。",
                "6": "可使爲之宰也。",
                "7": "不知其仁也。"
            },
            "19": {
                "1": "赤也何如。",
                "2": "子曰。",
                "3": "赤也。",
                "4": "束帶立於朝。",
                "5": "可使與賓客言也。",
                "6": "不知其仁也。"
            }
        },
        "9": {
            "21": {
                "1": "子謂子貢曰。",
                "2": "女與回也孰愈。",
                "3": "對曰。",
                "4": "賜也何敢望回。",
                "5": "回也聞一以知十。",
                "6": "賜也聞一以知二。",
                "7": "子曰。",
                "8": "弗如也。",
                "9": "吾與女弗如也。"
            }
        },
        "10": {
            "23": {
                "1": "宰予晝寢。",
                "2": "子曰。",
                "3": "朽木不可雕也。",
                "4": "糞土之牆不可杇也。",
                "5": "於予與何誅。",
                "6": "子曰。",
                "7": "始吾於人也。",
                "8": "聽其言而信其行。",
                "9": "今吾於人也。",
                "10": "聽其言而觀其行。",
                "11": "於予與改是。"
            }
        },
        "11": {
            "25": {
                "1": "子曰。",
                "2": "吾未見剛者。",
                "3": "或對曰。",
                "4": "申棖。",
                "5": "子曰。",
                "6": "棖也慾。",
                "7": "焉得剛。"
            }
        },
        "12": {
            "27": {
                "1": "子貢曰。",
                "2": "我不欲人之加諸我也。",
                "3": "吾亦欲無加諸人。",
                "4": "子曰。",
                "5": "賜也。",
                "6": "非爾所及也。"
            }
        },
        "13": {
            "29": {
                "1": "子貢曰。",
                "2": "夫子之文章。",
                "3": "可得而聞也。",
                "4": "夫子之言性與天道。",
                "5": "不可得而聞也。"
            }
        },
        "14": {
            "31": {
                "1": "子路有聞。",
                "2": "未之能行。",
                "3": "唯恐有聞。"
            }
        },
        "15": {
            "33": {
                "1": "子貢問曰。",
                "2": "孔文子何以謂之文也。",
                "3": "子曰。",
                "4": "敏而好學。",
                "5": "不恥下問。",
                "6": "是以謂之文也。"
            }
        },
        "16": {
            "35": {
                "1": "子謂子產。",
                "2": "有君子之道四焉。",
                "3": "其行己也恭。",
                "4": "其事上也敬。",
                "5": "其養民也惠。",
                "6": "其使民也義。"
            }
        },
        "17": {
            "37": {
                "1": "子曰。",
                "2": "晏平仲善與人交。",
                "3": "久而敬之。"
            }
        },
        "18": {
            "39": {
                "1": "子曰。",
                "2": "臧文仲居蔡。",
                "3": "山節藻梲。",
                "4": "何如其知也。"
            }
        },
        "19": {
            "41": {
                "1": "子張問曰。",
                "2": "令尹子文三仕爲令尹。",
                "3": "無喜色。",
                "4": "三已之。",
                "5": "無慍色。",
                "6": "舊令尹之政。",
                "7": "必以告新令尹。",
                "8": "何如。",
                "9": "子曰。",
                "10": "忠矣。",
                "11": "曰。",
                "12": "仁矣乎。",
                "13": "曰。",
                "14": "未知。",
                "15": "焉得仁。"
            },
            "42": {
                "1": "崔子弒齊君。",
                "2": "陳文子有馬十乘。",
                "3": "棄而違之。",
                "4": "至於他邦。",
                "5": "則曰。",
                "6": "猶吾大夫崔子也。",
                "7": "違之。",
                "8": "之一邦。",
                "9": "則又曰。",
                "10": "猶吾大夫崔子也。",
                "11": "違之。",
                "12": "何如。",
                "13": "子曰。",
                "14": "清矣。",
                "15": "曰。",
                "16": "仁矣乎。",
                "17": "曰。",
                "18": "未知。",
                "19": "焉得仁。"
            }
        },
        "20": {
            "44": {
                "1": "季文子三思而後行。",
                "2": "子聞之。",
                "3": "曰。",
                "4": "再。",
                "5": "斯可矣。"
            }
        },
        "21": {
            "46": {
                "1": "子曰。",
                "2": "甯武子。",
                "3": "邦有道則知。",
                "4": "邦無道則愚。",
                "5": "其知可及也。",
                "6": "其愚不可及也。"
            }
        },
        "22": {
            "48": {
                "1": "子在陳。",
                "2": "曰。",
                "3": "歸與。",
                "4": "歸與。",
                "5": "吾黨之小子狂簡。",
                "6": "斐然成章。",
                "7": "不知所以裁之。"
            }
        },
        "23": {
            "50": {
                "1": "子曰。",
                "2": "伯夷。",
                "3": "叔齊不念舊惡。",
                "4": "怨是用希。"
            }
        },
        "24": {
            "52": {
                "1": "子曰。",
                "2": "孰謂微生高直。",
                "3": "或乞醯焉。",
                "4": "乞諸其鄰而與之。"
            }
        },
        "25": {
            "54": {
                "1": "子曰。",
                "2": "巧言。",
                "3": "令色。",
                "4": "足恭。",
                "5": "左丘明恥之。",
                "6": "丘亦恥之。",
                "7": "匿怨而友其人。",
                "8": "左丘明恥之。",
                "9": "丘亦恥之。"
            }
        },
        "26": {
            "56": {
                "1": "顏淵。",
                "2": "季路侍。",
                "3": "子曰。",
                "4": "盍各言爾志。"
            },
            "57": {
                "1": "子路曰。",
                "2": "願車馬衣輕裘。",
                "3": "與朋友共。",
                "4": "敝之而無憾。"
            },
            "58": {
                "1": "顏淵曰。",
                "2": "願無伐善。",
                "3": "無施勞。"
            },
            "59": {
                "1": "子路曰。",
                "2": "願聞子之志。"
            },
            "60": {
                "1": "子曰。",
                "2": "老者安之。",
                "3": "朋友信之。",
                "4": "少者懷之。"
            }
        },
        "27": {
            "62": {
                "1": "子曰。",
                "2": "已矣乎。",
                "3": "吾未見能見其過而內自訟者也。"
            }
        },
        "28": {
            "64": {
                "1": "子曰。",
                "2": "十室之邑。",
                "3": "必有忠信如丘者焉。",
                "4": "不如丘之好學也。"
            }
        }
    }
}