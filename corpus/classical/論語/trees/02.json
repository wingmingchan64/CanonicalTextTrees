{
    "02": {
        "篇名": "論語·爲政第二",
        "1": {
            "3": {
                "1": "子曰。",
                "2": "爲政以德。",
                "3": "譬如北辰居其所而眾星共之。"
            }
        },
        "2": {
            "5": {
                "1": "子曰。",
                "2": "詩三百。",
                "3": "一言以蔽之。",
                "4": "曰。",
                "5": "思無邪。"
            }
        },
        "3": {
            "7": {
                "1": "子曰。",
                "2": "道之以政。",
                "3": "齊之以刑。",
                "4": "民免而無恥。",
                "5": "道之以德。",
                "6": "齊之以禮。",
                "7": "有恥且格。"
            }
        },
        "4": {
            "9": {
                "1": "子曰。",
                "2": "吾十有五而志於學。",
                "3": "三十而立。",
                "4": "四十而不惑。",
                "5": "五十而知天命。",
                "6": "六十而耳順。",
                "7": "七十而從心所欲不踰矩。"
            }
        },
        "5": {
            "11": {
                "1": "孟懿子問孝。",
                "2": "子曰。",
                "3": "無違。"
            },
            "12": {
                "1": "樊遲御。",
                "2": "子告之曰。",
                "3": "孟孫問孝於我。",
                "4": "我對曰。",
                "5": "無違。",
                "6": "樊遲曰。",
                "7": "何謂也。",
                "8": "子曰。",
                "9": "生。",
                "10": "事之以禮。",
                "11": "死。",
                "12": "葬之以禮。",
                "13": "祭之以禮。"
            }
        },
        "6": {
            "14": {
                "1": "孟武伯問孝。",
                "2": "子曰。",
                "3": "父母唯其疾之憂。"
            }
        },
        "7": {
            "16": {
                "1": "子游問孝。",
                "2": "子曰。",
                "3": "今之孝者。",
                "4": "是謂能養。",
                "5": "至於犬馬。",
                "6": "皆能有養。",
                "7": "不敬。",
                "8": "何以別乎。"
            }
        },
        "8": {
            "18": {
                "1": "子夏問孝。",
                "2": "子曰。",
                "3": "色難。",
                "4": "有事。",
                "5": "弟子服其勞。",
                "6": "有酒食。",
                "7": "先生饌。",
                "8": "曾是以爲孝乎。"
            }
        },
        "9": {
            "20": {
                "1": "子曰。",
                "2": "吾與回言終日。",
                "3": "不違。",
                "4": "如愚。",
                "5": "退而省其私。",
                "6": "亦足以發。",
                "7": "回也不愚。"
            }
        },
        "10": {
            "22": {
                "1": "子曰。",
                "2": "視其所以。",
                "3": "觀其所由。",
                "4": "察其所安。",
                "5": "人焉廋哉。",
                "6": "人焉廋哉。"
            }
        },
        "11": {
            "24": {
                "1": "子曰。",
                "2": "溫故而知新。",
                "3": "可以爲師矣。"
            }
        },
        "12": {
            "26": {
                "1": "子曰。",
                "2": "君子不器。"
            }
        },
        "13": {
            "28": {
                "1": "子貢問君子。",
                "2": "子曰。",
                "3": "先行其言而後從之。"
            }
        },
        "14": {
            "30": {
                "1": "子曰。",
                "2": "君子周而不比。",
                "3": "小人比而不周。"
            }
        },
        "15": {
            "32": {
                "1": "子曰。",
                "2": "學而不思則罔。",
                "3": "思而不學則殆。"
            }
        },
        "16": {
            "34": {
                "1": "子曰。",
                "2": "攻乎異端。",
                "3": "斯害也已矣。"
            }
        },
        "17": {
            "36": {
                "1": "子曰。",
                "2": "由。",
                "3": "誨女知之乎。",
                "4": "知之爲知之。",
                "5": "不知爲不知。",
                "6": "是知也。"
            }
        },
        "18": {
            "38": {
                "1": "子張學干祿。",
                "2": "子曰。",
                "3": "多聞闕疑。",
                "4": "愼言其餘。",
                "5": "則寡尤。",
                "6": "多見闕殆。",
                "7": "愼行其餘。",
                "8": "則寡悔。",
                "9": "言寡尤。",
                "10": "行寡悔。",
                "11": "祿在其中矣。"
            }
        },
        "19": {
            "40": {
                "1": "哀公問曰。",
                "2": "何爲則民服。",
                "3": "孔子對曰。",
                "4": "舉直錯諸枉。",
                "5": "則民服。",
                "6": "舉枉錯諸直。",
                "7": "則民不服。"
            }
        },
        "20": {
            "42": {
                "1": "季康子問。",
                "2": "使民敬。",
                "3": "忠以勸。",
                "4": "如之何。",
                "5": "子曰。",
                "6": "臨之以莊。",
                "7": "則敬。",
                "8": "孝慈。",
                "9": "則忠。",
                "10": "舉善而教不能。",
                "11": "則勸。"
            }
        },
        "21": {
            "44": {
                "1": "或謂孔子曰。",
                "2": "子奚不爲政。",
                "3": "子曰。",
                "4": "書云。",
                "5": "孝乎惟孝。",
                "6": "友于兄弟。",
                "7": "施於有政。",
                "8": "是亦爲政。",
                "9": "奚其爲爲政。"
            }
        },
        "22": {
            "46": {
                "1": "子曰。",
                "2": "人而無信。",
                "3": "不知其可也。",
                "4": "大車無輗。",
                "5": "小車無軏。",
                "6": "其何以行之哉。"
            }
        },
        "23": {
            "48": {
                "1": "子張問。",
                "2": "十世可知也。",
                "3": "子曰。",
                "4": "殷因於夏禮。",
                "5": "所損益。",
                "6": "可知也。",
                "7": "周因於殷禮。",
                "8": "所損益。",
                "9": "可知也。",
                "10": "其或繼周者。",
                "11": "雖百世。",
                "12": "可知也。"
            }
        },
        "24": {
            "50": {
                "1": "子曰。",
                "2": "非其鬼而祭之。",
                "3": "諂也。",
                "4": "見義不爲。",
                "5": "無勇也。"
            }
        }
    }
}