{
    "17": {
        "篇名": "論語·陽貨第十七",
        "1": {
            "3": {
                "1": "陽貨欲見孔子。",
                "2": "孔子不見。",
                "3": "歸孔子豚。"
            },
            "4": {
                "1": "孔子時其亡也。",
                "2": "而往拜之。"
            },
            "5": {
                "1": "遇諸塗。"
            },
            "6": {
                "1": "謂孔子曰。",
                "2": "來。",
                "3": "予與爾言。",
                "4": "曰。",
                "5": "懷其寶而迷其邦。",
                "6": "可謂仁乎。",
                "7": "曰。",
                "8": "不可。",
                "9": "好從事而亟失時。",
                "10": "可謂知乎。",
                "11": "曰。",
                "12": "不可。",
                "13": "日月逝矣。",
                "14": "歲不我與。"
            },
            "7": {
                "1": "孔子曰。",
                "2": "諾。",
                "3": "吾將仕矣。"
            }
        },
        "2": {
            "9": {
                "1": "子曰。",
                "2": "性相近也。",
                "3": "習相遠也。",
                "4": "子曰。",
                "5": "唯上知與下愚不移。"
            }
        },
        "3": {
            "11": {
                "1": "子之武城。",
                "2": "聞弦歌之聲。",
                "3": "夫子莞爾而笑。",
                "4": "曰。",
                "5": "割雞焉用牛刀。"
            },
            "12": {
                "1": "子游對曰。",
                "2": "昔者。",
                "3": "偃也聞諸夫子曰。",
                "4": "君子學道則愛人。",
                "5": "小人學道則易使也。"
            },
            "13": {
                "1": "子曰。",
                "2": "二三子。",
                "3": "偃之言是也。",
                "4": "前言戲之耳。"
            }
        },
        "4": {
            "15": {
                "1": "公山弗擾以費畔。",
                "2": "召。",
                "3": "子欲往。"
            },
            "16": {
                "1": "子路不說。",
                "2": "曰。",
                "3": "末之也已。",
                "4": "何必公山氏之之也。"
            },
            "17": {
                "1": "子曰。",
                "2": "夫召我者。",
                "3": "而豈徒哉。",
                "4": "如有用我者。",
                "5": "吾其爲東周乎。"
            }
        },
        "5": {
            "19": {
                "1": "子張問仁於孔子。",
                "2": "孔子曰。",
                "3": "能行五者於天下。",
                "4": "爲仁矣。"
            },
            "20": {
                "1": "請問之。",
                "2": "曰。",
                "3": "恭。",
                "4": "寬。",
                "5": "信。",
                "6": "敏。",
                "7": "惠。",
                "8": "恭則不侮。",
                "9": "寬則得眾。",
                "10": "信則人任焉。",
                "11": "敏則有功。",
                "12": "惠則足以使人。"
            }
        },
        "6": {
            "22": {
                "1": "佛肸召。",
                "2": "子欲往。"
            },
            "23": {
                "1": "子路曰。",
                "2": "昔者由也聞諸夫子曰。",
                "3": "親於其身爲不善者。",
                "4": "君子不入也。",
                "5": "佛肸以中牟畔。",
                "6": "子之往也。",
                "7": "如之何。"
            },
            "24": {
                "1": "子曰。",
                "2": "然。",
                "3": "有是言也。",
                "4": "不曰堅乎。",
                "5": "磨而不磷。",
                "6": "不曰白乎。",
                "7": "涅而不緇。",
                "8": "吾豈匏瓜也哉。",
                "9": "焉能繫而不食。"
            }
        },
        "7": {
            "26": {
                "1": "子曰。",
                "2": "由也。",
                "3": "女聞六言六蔽矣乎。",
                "4": "對曰。",
                "5": "未也。"
            },
            "27": {
                "1": "居。",
                "2": "吾語女。",
                "3": "好仁不好學。",
                "4": "其蔽也愚。",
                "5": "好知不好學。",
                "6": "其蔽也蕩。",
                "7": "好信不好學。",
                "8": "其蔽也賊。",
                "9": "好直不好學。",
                "10": "其蔽也絞。",
                "11": "好勇不好學。",
                "12": "其蔽也亂。",
                "13": "好剛不好學。",
                "14": "其蔽也狂。"
            }
        },
        "8": {
            "29": {
                "1": "子曰。",
                "2": "小子何莫學夫詩。",
                "3": "詩可以興。",
                "4": "可以觀。",
                "5": "可以羣。",
                "6": "可以怨。",
                "7": "邇之事父。",
                "8": "遠之事君。",
                "9": "多識於鳥獸草木之名。",
                "10": "子謂伯魚曰。",
                "11": "女爲周南。",
                "12": "召南矣乎。",
                "13": "人而不爲周南。",
                "14": "召南。",
                "15": "其猶正牆面而立也與。"
            }
        },
        "9": {
            "31": {
                "1": "子曰。",
                "2": "禮云禮云。",
                "3": "玉帛云乎哉。",
                "4": "樂云樂云。",
                "5": "鐘鼓云乎哉。"
            }
        },
        "10": {
            "33": {
                "1": "子曰。",
                "2": "色厲而內荏。",
                "3": "譬諸小人。",
                "4": "其猶穿窬之盜也與。"
            }
        },
        "11": {
            "35": {
                "1": "子曰。",
                "2": "鄕原。",
                "3": "德之賊也。"
            }
        },
        "12": {
            "37": {
                "1": "子曰。",
                "2": "道聽而塗說。",
                "3": "德之棄也。"
            }
        },
        "13": {
            "39": {
                "1": "子曰。",
                "2": "鄙夫可與事君也與哉。",
                "3": "其未得之也。",
                "4": "患得之。",
                "5": "旣得之。",
                "6": "患失之。",
                "7": "苟患失之。",
                "8": "無所不至矣。"
            }
        },
        "14": {
            "41": {
                "1": "子曰。",
                "2": "古者民有三疾。",
                "3": "今也或是之亡也。",
                "4": "古之狂也肆。",
                "5": "今之狂也蕩。",
                "6": "古之矜也廉。",
                "7": "今之矜也忿戾。",
                "8": "古之愚也直。",
                "9": "今之愚也詐而已矣。"
            }
        },
        "15": {
            "43": {
                "1": "子曰。",
                "2": "巧言令色。",
                "3": "鮮矣仁。"
            }
        },
        "16": {
            "45": {
                "1": "子曰。",
                "2": "惡紫之奪朱也。",
                "3": "惡鄭聲之亂雅樂也。",
                "4": "惡利口之覆邦家者。"
            }
        },
        "17": {
            "47": {
                "1": "子曰。",
                "2": "予欲無言。",
                "3": "子貢曰。",
                "4": "子如不言。",
                "5": "則小子何述焉。",
                "6": "子曰。",
                "7": "天何言哉。",
                "8": "四時行焉。",
                "9": "百物生焉。",
                "10": "天何言哉。"
            }
        },
        "18": {
            "49": {
                "1": "孺悲欲見孔子。",
                "2": "孔子辭以疾。",
                "3": "將命者出戶。",
                "4": "取瑟而歌。",
                "5": "使之聞之。"
            }
        },
        "19": {
            "51": {
                "1": "宰我問。",
                "2": "三年之喪。",
                "3": "期已久矣。",
                "4": "君子三年不爲禮。",
                "5": "禮必壞。",
                "6": "三年不爲樂。",
                "7": "樂必崩。",
                "8": "舊穀旣沒。",
                "9": "新穀旣升。",
                "10": "鑽燧改火。",
                "11": "期可已矣。"
            },
            "52": {
                "1": "子曰。",
                "2": "食夫稻。",
                "3": "衣夫錦。",
                "4": "於女安乎。"
            },
            "53": {
                "1": "曰。",
                "2": "安。"
            },
            "54": {
                "1": "女安。",
                "2": "則爲之。",
                "3": "夫君子之居喪。",
                "4": "食旨不甘。",
                "5": "聞樂不樂。",
                "6": "居處不安。",
                "7": "故不爲也。",
                "8": "今女安。",
                "9": "則爲之。"
            },
            "55": {
                "1": "宰我出。",
                "2": "子曰。",
                "3": "予之不仁也。",
                "4": "子生三年。",
                "5": "然後免於父母之懷。",
                "6": "夫三年之喪。",
                "7": "天下之通喪也。",
                "8": "予也有三年之愛於其父母乎。"
            }
        },
        "20": {
            "57": {
                "1": "子曰。",
                "2": "飽食終日。",
                "3": "無所用心。",
                "4": "難矣哉。",
                "5": "不有博弈者乎。",
                "6": "爲之。",
                "7": "猶賢乎已。"
            }
        },
        "21": {
            "59": {
                "1": "子路曰。",
                "2": "君子尙勇乎。",
                "3": "子曰。",
                "4": "君子義以爲上。",
                "5": "君子有勇而無義爲亂。",
                "6": "小人有勇而無義爲盜。"
            }
        },
        "22": {
            "61": {
                "1": "子貢曰。",
                "2": "君子亦有惡乎。",
                "3": "子曰。",
                "4": "有惡。",
                "5": "惡稱人之惡者。",
                "6": "惡居下流而訕上者。",
                "7": "惡勇而無禮者。",
                "8": "惡果敢而窒者。"
            },
            "62": {
                "1": "曰。",
                "2": "賜也亦有惡乎。",
                "3": "惡徼以爲知者。",
                "4": "惡不孫以爲勇者。",
                "5": "惡訐以爲直者。"
            }
        },
        "23": {
            "64": {
                "1": "子曰。",
                "2": "唯女子與小人爲難養也。",
                "3": "近之則不孫。",
                "4": "遠之則怨。"
            }
        },
        "24": {
            "66": {
                "1": "子曰。",
                "2": "年四十而見惡焉。",
                "3": "其終也已。"
            }
        }
    }
}