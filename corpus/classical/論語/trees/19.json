{
    "19": {
        "篇名": "論語·子張第十九",
        "1": {
            "3": {
                "1": "子張曰。",
                "2": "士見危致命。",
                "3": "見得思義。",
                "4": "祭思敬。",
                "5": "喪思哀。",
                "6": "其可已矣。"
            }
        },
        "2": {
            "5": {
                "1": "子張曰。",
                "2": "執德不弘。",
                "3": "信道不篤。",
                "4": "焉能爲有。",
                "5": "焉能爲亡。"
            }
        },
        "3": {
            "7": {
                "1": "子夏之門人問交於子張。",
                "2": "子張曰。",
                "3": "子夏云何。"
            },
            "8": {
                "1": "對曰。",
                "2": "子夏曰。",
                "3": "可者與之。",
                "4": "其不可者拒之。"
            },
            "9": {
                "1": "子張曰。",
                "2": "異乎吾所聞。",
                "3": "君子尊賢而容眾。",
                "4": "嘉善而矜不能。",
                "5": "我之大賢與。",
                "6": "於人何所不容。",
                "7": "我之不賢與。",
                "8": "人將拒我。",
                "9": "如之何其拒人也。"
            }
        },
        "4": {
            "11": {
                "1": "子夏曰。",
                "2": "雖小道。",
                "3": "必有可觀者焉。",
                "4": "致遠恐泥。",
                "5": "是以君子不爲也。"
            }
        },
        "5": {
            "13": {
                "1": "子夏曰。",
                "2": "日知其所亡。",
                "3": "月無忘其所能。",
                "4": "可謂好學也已矣。"
            }
        },
        "6": {
            "15": {
                "1": "子夏曰。",
                "2": "博學而篤志。",
                "3": "切問而近思。",
                "4": "仁在其中矣。"
            }
        },
        "7": {
            "17": {
                "1": "子夏曰。",
                "2": "百工居肆以成其事。",
                "3": "君子學以致其道。"
            }
        },
        "8": {
            "19": {
                "1": "子夏曰。",
                "2": "小人之過也必文。"
            }
        },
        "9": {
            "21": {
                "1": "子夏曰。",
                "2": "君子有三變。",
                "3": "望之儼然。",
                "4": "卽之也溫。",
                "5": "聽其言也厲。"
            }
        },
        "10": {
            "23": {
                "1": "子夏曰。",
                "2": "君子信而後勞其民。",
                "3": "未信則以爲厲己也。",
                "4": "信而後諫。",
                "5": "未信則以爲謗己也。"
            }
        },
        "11": {
            "25": {
                "1": "子夏曰。",
                "2": "大德不踰閑。",
                "3": "小德出入可也。"
            }
        },
        "12": {
            "27": {
                "1": "子游曰。",
                "2": "子夏之門人小子。",
                "3": "當洒掃應對進退。",
                "4": "則可矣。",
                "5": "抑末也。",
                "6": "本之則無。",
                "7": "如之何。"
            },
            "28": {
                "1": "子夏聞之。",
                "2": "曰。",
                "3": "噫。",
                "4": "言游過矣。",
                "5": "君子之道。",
                "6": "孰先傳焉。",
                "7": "孰後倦焉。",
                "8": "譬諸草木。",
                "9": "區以別矣。",
                "10": "君子之道。",
                "11": "焉可誣也。",
                "12": "有始有卒者。",
                "13": "其惟聖人乎。"
            }
        },
        "13": {
            "30": {
                "1": "子夏曰。",
                "2": "仕而優則學。",
                "3": "學而優則仕。"
            }
        },
        "14": {
            "32": {
                "1": "子游曰。",
                "2": "喪致乎哀而止。"
            }
        },
        "15": {
            "34": {
                "1": "子游曰。",
                "2": "吾友張也爲難能也。",
                "3": "然而未仁。"
            }
        },
        "16": {
            "36": {
                "1": "曾子曰。",
                "2": "堂堂乎張也。",
                "3": "難與並爲仁矣。"
            }
        },
        "17": {
            "38": {
                "1": "曾子曰。",
                "2": "吾聞諸夫子。",
                "3": "人未有自致者也。",
                "4": "必也親喪乎。"
            }
        },
        "18": {
            "40": {
                "1": "曾子曰。",
                "2": "吾聞諸夫子。",
                "3": "孟莊子之孝也。",
                "4": "其他可能也。",
                "5": "其不改父之臣與父之政。",
                "6": "是難能也。"
            }
        },
        "19": {
            "42": {
                "1": "孟氏使陽膚爲士師。",
                "2": "問於曾子。",
                "3": "曾子曰。",
                "4": "上失其道。",
                "5": "民散久矣。",
                "6": "如得其情。",
                "7": "則哀矜而勿喜。"
            }
        },
        "20": {
            "44": {
                "1": "子貢曰。",
                "2": "紂之不善。",
                "3": "不如是之甚也。",
                "4": "是以君子惡居下流。",
                "5": "天下之惡皆歸焉。"
            }
        },
        "21": {
            "46": {
                "1": "子貢曰。",
                "2": "君子之過也。",
                "3": "如日月之食焉。",
                "4": "過也。",
                "5": "人皆見之。",
                "6": "更也。",
                "7": "人皆仰之。"
            }
        },
        "22": {
            "48": {
                "1": "衞公孫朝問於子貢曰。",
                "2": "仲尼焉學。",
                "3": "子貢曰。",
                "4": "文。",
                "5": "武之道。",
                "6": "未墜於地。",
                "7": "在人。",
                "8": "賢者識其大者。",
                "9": "不賢者識其小者。",
                "10": "莫不有文。",
                "11": "武之道焉。",
                "12": "夫子焉不學。",
                "13": "而亦何常師之有。"
            }
        },
        "23": {
            "50": {
                "1": "叔孫武叔語大夫於朝曰。",
                "2": "子貢賢於仲尼。"
            },
            "51": {
                "1": "子服景伯以告子貢。"
            },
            "52": {
                "1": "子貢曰。",
                "2": "譬之宮牆。",
                "3": "賜之牆也及肩。",
                "4": "窺見室家之好。",
                "5": "夫子之牆數仞。",
                "6": "不得其門而入。",
                "7": "不見宗廟之美。",
                "8": "百官之富。",
                "9": "得其門者或寡矣。",
                "10": "夫子之云。",
                "11": "不亦宜乎。"
            }
        },
        "24": {
            "54": {
                "1": "叔孫武叔毀仲尼。",
                "2": "子貢曰。",
                "3": "無以爲也。",
                "4": "仲尼不可毀也。",
                "5": "他人之賢者。",
                "6": "丘陵也。",
                "7": "猶可踰也。",
                "8": "仲尼。",
                "9": "日月也。",
                "10": "無得而踰焉。",
                "11": "人雖欲自絕。",
                "12": "其何傷於日月乎。",
                "13": "多見其不知量也。"
            }
        },
        "25": {
            "56": {
                "1": "陳子禽謂子貢曰。",
                "2": "子爲恭也。",
                "3": "仲尼豈賢於子乎。"
            },
            "57": {
                "1": "子貢曰。",
                "2": "君子一言以爲知。",
                "3": "一言以爲不知。",
                "4": "言不可不愼也。",
                "5": "夫子之不可及也。",
                "6": "猶天之不可階而升也。",
                "7": "夫子之得邦家者。",
                "8": "所謂立之斯立。",
                "9": "道之斯行。",
                "10": "綏之斯來。",
                "11": "動之斯和。",
                "12": "其生也榮。",
                "13": "其死也哀。",
                "14": "如之何其可及也。"
            }
        }
    }
}