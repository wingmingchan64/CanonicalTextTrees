{
    "09": {
        "篇名": "論語·子罕第九",
        "1": {
            "3": {
                "1": "子罕言利與命與仁。"
            }
        },
        "2": {
            "5": {
                "1": "達巷黨人曰。",
                "2": "大哉孔子。",
                "3": "博學而無所成名。",
                "4": "子聞之。",
                "5": "謂門弟子曰。",
                "6": "吾何執。",
                "7": "執御乎。",
                "8": "執射乎。",
                "9": "吾執御矣。"
            }
        },
        "3": {
            "7": {
                "1": "子曰。",
                "2": "麻冕。",
                "3": "禮也。",
                "4": "今也純。",
                "5": "儉。",
                "6": "吾從眾。",
                "7": "拜下。",
                "8": "禮也。",
                "9": "今拜乎上。",
                "10": "泰也。",
                "11": "雖違眾。",
                "12": "吾從下。"
            }
        },
        "4": {
            "9": {
                "1": "子絕四。",
                "2": "毋意。",
                "3": "毋必。",
                "4": "毋固。",
                "5": "毋我。"
            }
        },
        "5": {
            "11": {
                "1": "子畏于匡。",
                "2": "曰。",
                "3": "文王旣沒。",
                "4": "文不在茲乎。",
                "5": "天之將喪斯文也。",
                "6": "後死者不得與於斯文也。",
                "7": "天之未喪斯文也。",
                "8": "匡人其如予何。"
            }
        },
        "6": {
            "13": {
                "1": "大宰問於子貢曰。",
                "2": "夫子聖者與。",
                "3": "何其多能也。",
                "4": "子貢曰。",
                "5": "固天縱之將聖。",
                "6": "又多能也。"
            },
            "14": {
                "1": "子聞之。",
                "2": "曰。",
                "3": "大宰知我乎。",
                "4": "吾少也賤。",
                "5": "故多能鄙事。",
                "6": "君子多乎哉。",
                "7": "不多也。"
            }
        },
        "7": {
            "16": {
                "1": "牢曰。",
                "2": "子云。",
                "3": "吾不試。",
                "4": "故藝。"
            }
        },
        "8": {
            "18": {
                "1": "子曰。",
                "2": "吾有知乎哉。",
                "3": "無知也。",
                "4": "有鄙夫問於我。",
                "5": "空空如也。",
                "6": "我叩其兩端而竭焉。"
            }
        },
        "9": {
            "20": {
                "1": "子曰。",
                "2": "鳳鳥不至。",
                "3": "河不出圖。",
                "4": "吾已矣夫。"
            }
        },
        "10": {
            "22": {
                "1": "子見齊衰者。",
                "2": "冕衣裳者與瞽者。",
                "3": "見之。",
                "4": "雖少。",
                "5": "必作。",
                "6": "過之。",
                "7": "必趨。"
            }
        },
        "11": {
            "24": {
                "1": "顏淵喟然歎曰。",
                "2": "仰之彌高。",
                "3": "鑽之彌堅。",
                "4": "瞻之在前。",
                "5": "忽焉在後。",
                "6": "夫子循循然善誘人。",
                "7": "博我以文。",
                "8": "約我以禮。",
                "9": "欲罷不能。",
                "10": "旣竭吾才。",
                "11": "如有所立卓爾。",
                "12": "雖欲從之。",
                "13": "末由也已。"
            }
        },
        "12": {
            "26": {
                "1": "子疾病。",
                "2": "子路使門人爲臣。",
                "3": "病間。",
                "4": "曰。",
                "5": "久矣哉。",
                "6": "由之行詐也。",
                "7": "無臣而爲有臣。",
                "8": "吾誰欺。",
                "9": "欺天乎。",
                "10": "且予與其死於臣之手也。",
                "11": "無寧死於二三子之手乎。",
                "12": "且予縱不得大葬。",
                "13": "予死於道路乎。"
            }
        },
        "13": {
            "28": {
                "1": "子貢曰。",
                "2": "有美玉於斯。",
                "3": "韞匵而藏諸。",
                "4": "求善賈而沽諸。",
                "5": "子曰。",
                "6": "沽之哉。",
                "7": "沽之哉。",
                "8": "我待賈者也。"
            }
        },
        "14": {
            "30": {
                "1": "子欲居九夷。",
                "2": "或曰。",
                "3": "陋。",
                "4": "如之何。",
                "5": "子曰。",
                "6": "君子居之。",
                "7": "何陋之有。"
            }
        },
        "15": {
            "32": {
                "1": "子曰。",
                "2": "吾自衞反魯。",
                "3": "然後樂正。",
                "4": "雅。",
                "5": "頌各得其所。"
            }
        },
        "16": {
            "34": {
                "1": "子曰。",
                "2": "出則事公卿。",
                "3": "入則事父兄。",
                "4": "喪事不敢不勉。",
                "5": "不爲酒困。",
                "6": "何有於我哉。"
            }
        },
        "17": {
            "36": {
                "1": "子在川上曰。",
                "2": "逝者如斯夫。",
                "3": "不舍晝夜。"
            }
        },
        "18": {
            "38": {
                "1": "子曰。",
                "2": "吾未見好德如好色者也。"
            }
        },
        "19": {
            "40": {
                "1": "子曰。",
                "2": "譬如爲山。",
                "3": "未成一簣。",
                "4": "止。",
                "5": "吾止也。",
                "6": "譬如平地。",
                "7": "雖覆一簣。",
                "8": "進。",
                "9": "吾往也。"
            }
        },
        "20": {
            "42": {
                "1": "子曰。",
                "2": "語之而不惰者。",
                "3": "其回也與。"
            }
        },
        "21": {
            "44": {
                "1": "子謂顏淵。",
                "2": "曰。",
                "3": "惜乎。",
                "4": "吾見其進也。",
                "5": "未見其止也。"
            }
        },
        "22": {
            "46": {
                "1": "子曰。",
                "2": "苗而不秀者有矣夫。",
                "3": "秀而不實者有矣夫。"
            }
        },
        "23": {
            "48": {
                "1": "子曰。",
                "2": "後生可畏。",
                "3": "焉知來者之不如今也。",
                "4": "四十。",
                "5": "五十而無聞焉。",
                "6": "斯亦不足畏也已矣。"
            }
        },
        "24": {
            "50": {
                "1": "子曰。",
                "2": "法語之言。",
                "3": "能無從乎。",
                "4": "改之爲貴。",
                "5": "巽與之言。",
                "6": "能無說乎。",
                "7": "繹之爲貴。",
                "8": "說而不繹。",
                "9": "從而不改。",
                "10": "吾末如之何也已矣。"
            }
        },
        "25": {
            "52": {
                "1": "子曰。",
                "2": "主忠信。",
                "3": "毋友不如己者。",
                "4": "過則勿憚改。"
            }
        },
        "26": {
            "54": {
                "1": "子曰。",
                "2": "三軍可奪帥也。",
                "3": "匹夫不可奪志也。"
            }
        },
        "27": {
            "56": {
                "1": "子曰。",
                "2": "衣敝縕袍。",
                "3": "與衣狐貉者立。",
                "4": "而不恥者。",
                "5": "其由也與。",
                "6": "不忮不求。",
                "7": "何用不臧。",
                "8": "子路終身誦之。",
                "9": "子曰。",
                "10": "是道也。",
                "11": "何足以臧。"
            }
        },
        "28": {
            "58": {
                "1": "子曰。",
                "2": "歲寒。",
                "3": "然後知松柏之後彫也。"
            }
        },
        "29": {
            "60": {
                "1": "子曰。",
                "2": "知者不惑。",
                "3": "仁者不憂。",
                "4": "勇者不懼。"
            }
        },
        "30": {
            "62": {
                "1": "子曰。",
                "2": "可與共學。",
                "3": "未可與適道。",
                "4": "可與適道。",
                "5": "未可與立。",
                "6": "可與立。",
                "7": "未可與權。"
            }
        },
        "31": {
            "64": {
                "1": "唐棣之華。",
                "2": "偏其反而。",
                "3": "豈不爾思。",
                "4": "室是遠而。",
                "5": "子曰。",
                "6": "未之思也。",
                "7": "夫何遠之有。"
            }
        }
    }
}