{
    "06": {
        "篇名": "論語·雍也第六",
        "1": {
            "3": {
                "1": "子曰。",
                "2": "雍也。",
                "3": "可使南面。"
            }
        },
        "2": {
            "5": {
                "1": "仲弓問子桑伯子。",
                "2": "子曰。",
                "3": "可也簡。"
            },
            "6": {
                "1": "仲弓曰。",
                "2": "居敬而行簡。",
                "3": "以臨其民。",
                "4": "不亦可乎。",
                "5": "居簡而行簡。",
                "6": "無乃大簡乎。",
                "7": "子曰。",
                "8": "雍之言然。"
            }
        },
        "3": {
            "8": {
                "1": "哀公問。",
                "2": "弟子孰爲好學。",
                "3": "孔子對曰。",
                "4": "有顏回者好學。",
                "5": "不遷怒。",
                "6": "不貳過。",
                "7": "不幸短命死矣。",
                "8": "今也則亡。",
                "9": "未聞好學者也。"
            }
        },
        "4": {
            "10": {
                "1": "子華使於齊。",
                "2": "冉子爲其母請粟。",
                "3": "子曰。",
                "4": "與之釜。"
            },
            "11": {
                "1": "請益。",
                "2": "曰。",
                "3": "與之庾。"
            },
            "12": {
                "1": "冉子與之粟五秉。"
            },
            "13": {
                "1": "子曰。",
                "2": "赤之適齊也。",
                "3": "乘肥馬。",
                "4": "衣輕裘。",
                "5": "吾聞之也。",
                "6": "君子周急不繼富。"
            }
        },
        "5": {
            "15": {
                "1": "原思爲之宰。",
                "2": "與之粟九百。",
                "3": "辭。",
                "4": "子曰。",
                "5": "毋。",
                "6": "以與爾鄰里鄕黨乎。"
            }
        },
        "6": {
            "17": {
                "1": "子謂仲弓。",
                "2": "曰。",
                "3": "犂牛之子騂且角。",
                "4": "雖欲勿用。",
                "5": "山川其舍諸。"
            }
        },
        "7": {
            "19": {
                "1": "子曰。",
                "2": "回也。",
                "3": "其心三月不違仁。",
                "4": "其餘則日月至焉而已矣。"
            }
        },
        "8": {
            "21": {
                "1": "季康子問。",
                "2": "仲由可使從政也與。",
                "3": "子曰。",
                "4": "由也果。",
                "5": "於從政乎何有。"
            },
            "22": {
                "1": "曰。",
                "2": "賜也可使從政也與。",
                "3": "曰。",
                "4": "賜也達。",
                "5": "於從政乎何有。"
            },
            "23": {
                "1": "曰。",
                "2": "求也可使從政也與。",
                "3": "曰。",
                "4": "求也藝。",
                "5": "於從政乎何有。"
            }
        },
        "9": {
            "25": {
                "1": "季氏使閔子騫爲費宰。",
                "2": "閔子騫曰。",
                "3": "善爲我辭焉。",
                "4": "如有復我者。",
                "5": "則吾必在汶上矣。"
            }
        },
        "10": {
            "27": {
                "1": "伯牛有疾。",
                "2": "子問之。",
                "3": "自牖執其手。",
                "4": "曰。",
                "5": "亡之。",
                "6": "命矣夫。",
                "7": "斯人也而有斯疾也。",
                "8": "斯人也而有斯疾也。"
            }
        },
        "11": {
            "29": {
                "1": "子曰。",
                "2": "賢哉。",
                "3": "回也。",
                "4": "一簞食。",
                "5": "一瓢飲。",
                "6": "在陋巷。",
                "7": "人不堪其憂。",
                "8": "回也不改其樂。",
                "9": "賢哉。",
                "10": "回也。"
            }
        },
        "12": {
            "31": {
                "1": "冉求曰。",
                "2": "非不說子之道。",
                "3": "力不足也。",
                "4": "子曰。",
                "5": "力不足者。",
                "6": "中道而廢。",
                "7": "今女畫。"
            }
        },
        "13": {
            "33": {
                "1": "子謂子夏曰。",
                "2": "女爲君子儒。",
                "3": "無爲小人儒。"
            }
        },
        "14": {
            "35": {
                "1": "子游爲武城宰。",
                "2": "子曰。",
                "3": "女得人焉耳乎。",
                "4": "曰。",
                "5": "有澹臺滅明者。",
                "6": "行不由徑。",
                "7": "非公事。",
                "8": "未嘗至於偃之室也。"
            }
        },
        "15": {
            "37": {
                "1": "子曰。",
                "2": "孟之反不伐。",
                "3": "奔而殿。",
                "4": "將入門。",
                "5": "策其馬。",
                "6": "曰。",
                "7": "非敢後也。",
                "8": "馬不進也。"
            }
        },
        "16": {
            "39": {
                "1": "子曰。",
                "2": "不有祝鮀之佞。",
                "3": "而有宋朝之美。",
                "4": "難乎免於今之世矣。"
            }
        },
        "17": {
            "41": {
                "1": "子曰。",
                "2": "誰能出不由戶。",
                "3": "何莫由斯道也。"
            }
        },
        "18": {
            "43": {
                "1": "子曰。",
                "2": "質勝文則野。",
                "3": "文勝質則史。",
                "4": "文質彬彬。",
                "5": "然後君子。"
            }
        },
        "19": {
            "45": {
                "1": "子曰。",
                "2": "人之生也直。",
                "3": "罔之生也幸而免。"
            }
        },
        "20": {
            "47": {
                "1": "子曰。",
                "2": "知之者不如好之者。",
                "3": "好之者不如樂之者。"
            }
        },
        "21": {
            "49": {
                "1": "子曰。",
                "2": "中人以上。",
                "3": "可以語上也。",
                "4": "中人以下。",
                "5": "不可以語上也。"
            }
        },
        "22": {
            "51": {
                "1": "樊遲問知。",
                "2": "子曰。",
                "3": "務民之義。",
                "4": "敬鬼神而遠之。",
                "5": "可謂知矣。"
            },
            "52": {
                "1": "問仁。",
                "2": "曰。",
                "3": "仁者先難而後獲。",
                "4": "可謂仁矣。"
            }
        },
        "23": {
            "54": {
                "1": "子曰。",
                "2": "知者樂水。",
                "3": "仁者樂山。",
                "4": "知者動。",
                "5": "仁者靜。",
                "6": "知者樂。",
                "7": "仁者壽。"
            }
        },
        "24": {
            "56": {
                "1": "子曰。",
                "2": "齊一變。",
                "3": "至於魯。",
                "4": "魯一變。",
                "5": "至於道。"
            }
        },
        "25": {
            "58": {
                "1": "子曰。",
                "2": "觚不觚。",
                "3": "觚哉。",
                "4": "觚哉。"
            }
        },
        "26": {
            "60": {
                "1": "宰我問曰。",
                "2": "仁者。",
                "3": "雖告之曰。",
                "4": "井有仁焉。",
                "5": "其從之也。",
                "6": "子曰。",
                "7": "何爲其然也。",
                "8": "君子可逝也。",
                "9": "不可陷也。",
                "10": "可欺也。",
                "11": "不可罔也。"
            }
        },
        "27": {
            "62": {
                "1": "子曰。",
                "2": "君子博學於文。",
                "3": "約之以禮。",
                "4": "亦可以弗畔矣夫。"
            }
        },
        "28": {
            "64": {
                "1": "子見南子。",
                "2": "子路不說。",
                "3": "夫子矢之曰。",
                "4": "予所否者。",
                "5": "天厭之。",
                "6": "天厭之。"
            }
        },
        "29": {
            "66": {
                "1": "子曰。",
                "2": "中庸之爲德也。",
                "3": "其至矣乎。",
                "4": "民鮮久矣。"
            }
        },
        "30": {
            "68": {
                "1": "子貢曰。",
                "2": "如有博施於民而能濟眾。",
                "3": "何如。",
                "4": "可謂仁乎。",
                "5": "子曰。",
                "6": "何事於仁。",
                "7": "必也聖乎。",
                "8": "堯舜其猶病諸。",
                "9": "夫仁者。",
                "10": "己欲立而立人。",
                "11": "己欲達而達人。",
                "12": "能近取譬。",
                "13": "可謂仁之方也已。"
            }
        }
    }
}