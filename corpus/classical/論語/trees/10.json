{
    "10": {
        "篇名": "論語·鄕黨第十",
        "1": {
            "3": {
                "1": "孔子於鄕黨。",
                "2": "恂恂如也。",
                "3": "似不能言者。"
            },
            "4": {
                "1": "其在宗廟朝廷。",
                "2": "便便言。",
                "3": "唯謹爾。"
            },
            "5": {
                "1": "朝。",
                "2": "與下大夫言。",
                "3": "侃侃如也。",
                "4": "與上大夫言。",
                "5": "誾誾如也。",
                "6": "君在。",
                "7": "踧踖如也。",
                "8": "與與如也。"
            }
        },
        "2": {
            "7": {
                "1": "君召使擯。",
                "2": "色勃如也。",
                "3": "足躩如也。",
                "4": "揖所與立。",
                "5": "左右手。",
                "6": "衣前後。",
                "7": "襜如也。",
                "8": "趨進。",
                "9": "翼如也。",
                "10": "賓退。",
                "11": "必復命曰。",
                "12": "賓不顧矣。"
            }
        },
        "3": {
            "9": {
                "1": "入公門。",
                "2": "鞠躬如也。",
                "3": "如不容。"
            },
            "10": {
                "1": "立不中門。",
                "2": "行不履閾。"
            },
            "11": {
                "1": "過位。",
                "2": "色勃如也。",
                "3": "足躩如也。",
                "4": "其言似不足者。"
            },
            "12": {
                "1": "攝齊升堂。",
                "2": "鞠躬如也。",
                "3": "屛氣似不息者。"
            },
            "13": {
                "1": "出。",
                "2": "降一等。",
                "3": "逞顏色。",
                "4": "怡怡如也。"
            },
            "14": {
                "1": "沒階。",
                "2": "趨進。",
                "3": "翼如也。"
            },
            "15": {
                "1": "復其位。",
                "2": "踧踖如也。"
            }
        },
        "4": {
            "17": {
                "1": "執圭。",
                "2": "鞠躬如也。",
                "3": "如不勝。",
                "4": "上如揖。",
                "5": "下如授。",
                "6": "勃如戰色。",
                "7": "足蹜蹜如有循。"
            },
            "18": {
                "1": "享禮。",
                "2": "有容色。"
            },
            "19": {
                "1": "私覿。",
                "2": "愉愉如也。"
            }
        },
        "5": {
            "21": {
                "1": "君子不以紺緅飾。",
                "2": "紅紫不以爲褻服。"
            },
            "22": {
                "1": "當暑。",
                "2": "袗絺綌。",
                "3": "必表而出之。"
            },
            "23": {
                "1": "緇衣。",
                "2": "羔裘。",
                "3": "素衣。",
                "4": "麑裘。",
                "5": "黃衣。",
                "6": "狐裘。"
            },
            "24": {
                "1": "褻裘長。",
                "2": "短右袂。"
            },
            "25": {
                "1": "必有寢衣。",
                "2": "長一身有半。"
            },
            "26": {
                "1": "狐貈之厚以居。"
            },
            "27": {
                "1": "去喪。",
                "2": "無所不佩。"
            },
            "28": {
                "1": "非帷裳。",
                "2": "必殺之。"
            },
            "29": {
                "1": "羔裘玄冠不以弔。"
            },
            "30": {
                "1": "吉月。",
                "2": "必朝服而朝。"
            },
            "31": {
                "1": "齋必有明衣。",
                "2": "布。"
            }
        },
        "6": {
            "33": {
                "1": "齊必變食。",
                "2": "居必遷坐。"
            },
            "34": {
                "1": "食不厭精。",
                "2": "膾不厭細。"
            },
            "35": {
                "1": "食饐而餲。",
                "2": "魚餒而肉敗。",
                "3": "不食。",
                "4": "色惡。",
                "5": "不食。",
                "6": "臭惡。",
                "7": "不食。",
                "8": "失飪。",
                "9": "不食。",
                "10": "不時。",
                "11": "不食。",
                "12": "割不正。",
                "13": "不食。",
                "14": "不得其醬。",
                "15": "不食。"
            },
            "36": {
                "1": "肉雖多。",
                "2": "不使勝食氣。"
            },
            "37": {
                "1": "唯酒無量。",
                "2": "不及亂。"
            },
            "38": {
                "1": "沽酒市脯不食。"
            },
            "39": {
                "1": "不撤薑食。",
                "2": "不多食。"
            },
            "40": {
                "1": "祭於公。",
                "2": "不宿肉。",
                "3": "祭肉不出三日。",
                "4": "出三日。",
                "5": "不食之矣。"
            },
            "41": {
                "1": "食不語。",
                "2": "寢不言。",
                "3": "雖疏食菜羹瓜。",
                "4": "祭。",
                "5": "必齊如也。"
            }
        },
        "7": {
            "43": {
                "1": "席不正。",
                "2": "不坐。",
                "3": "鄕人飲酒。",
                "4": "杖者出。",
                "5": "斯出矣。"
            }
        },
        "8": {
            "45": {
                "1": "鄕人儺。",
                "2": "朝服而立於阼階。"
            }
        },
        "9": {
            "47": {
                "1": "問人於他邦。",
                "2": "再拜而送之。"
            }
        },
        "10": {
            "49": {
                "1": "康子饋藥。",
                "2": "拜而受之。",
                "3": "曰。",
                "4": "丘未達。",
                "5": "不敢嘗。"
            }
        },
        "11": {
            "51": {
                "1": "廏焚。",
                "2": "子退朝。",
                "3": "曰。",
                "4": "傷人乎。",
                "5": "不問馬。"
            }
        },
        "12": {
            "53": {
                "1": "君賜食。",
                "2": "必正席先嘗之。",
                "3": "君賜腥。",
                "4": "必熟而薦之。",
                "5": "君賜生。",
                "6": "必畜之。"
            },
            "54": {
                "1": "侍食於君。",
                "2": "君祭。",
                "3": "先飯。"
            }
        },
        "13": {
            "56": {
                "1": "疾。",
                "2": "君視之。",
                "3": "東首。",
                "4": "加朝服。",
                "5": "拖紳。"
            }
        },
        "14": {
            "58": {
                "1": "君命召。",
                "2": "不俟駕行矣。"
            }
        },
        "15": {
            "60": {
                "1": "入太廟。",
                "2": "每事問。"
            }
        },
        "16": {
            "62": {
                "1": "朋友死。",
                "2": "無所歸。",
                "3": "曰。",
                "4": "於我殯。"
            }
        },
        "17": {
            "64": {
                "1": "朋友之饋。",
                "2": "雖車馬。",
                "3": "非祭肉。",
                "4": "不拜。"
            }
        },
        "18": {
            "66": {
                "1": "寢不尸。",
                "2": "居不容。"
            }
        },
        "19": {
            "68": {
                "1": "見齊衰者。",
                "2": "雖狎。",
                "3": "必變。",
                "4": "見冕者與瞽者。",
                "5": "雖褻。",
                "6": "必以貌。"
            },
            "69": {
                "1": "凶服者式之。",
                "2": "式負版者。"
            },
            "70": {
                "1": "有盛饌。",
                "2": "必變色而作。"
            },
            "71": {
                "1": "迅雷風烈必變。"
            }
        },
        "20": {
            "73": {
                "1": "升車。",
                "2": "必正立執綏。"
            },
            "74": {
                "1": "車中。",
                "2": "不內顧。",
                "3": "不疾言。",
                "4": "不親指。"
            }
        },
        "21": {
            "76": {
                "1": "色斯舉矣。",
                "2": "翔而後集。",
                "3": "曰。",
                "4": "山梁雌雉。",
                "5": "時哉時哉。",
                "6": "子路共之。",
                "7": "三嗅而作。"
            }
        }
    }
}