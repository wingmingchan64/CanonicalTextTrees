{
    "14": {
        "篇名": "論語·憲問第十四",
        "1": {
            "3": {
                "1": "憲問恥。",
                "2": "子曰。",
                "3": "邦有道。",
                "4": "穀。",
                "5": "邦無道。",
                "6": "穀。",
                "7": "恥也。"
            },
            "4": {
                "1": "克。",
                "2": "伐。",
                "3": "怨。",
                "4": "欲不行焉。",
                "5": "可以爲仁矣。",
                "6": "子曰。",
                "7": "可以爲難矣。",
                "8": "仁則吾不知也。"
            }
        },
        "2": {
            "6": {
                "1": "子曰。",
                "2": "士而懷居。",
                "3": "不足以爲士矣。"
            }
        },
        "3": {
            "8": {
                "1": "子曰。",
                "2": "邦有道。",
                "3": "危言危行。",
                "4": "邦無道。",
                "5": "危行言孫。"
            }
        },
        "4": {
            "10": {
                "1": "子曰。",
                "2": "有德者必有言。",
                "3": "有言者不必有德。",
                "4": "仁者必有勇。",
                "5": "勇者不必有仁。"
            }
        },
        "5": {
            "12": {
                "1": "南宮适問於孔子曰。",
                "2": "羿善射。",
                "3": "奡盪舟。",
                "4": "俱不得其死然。",
                "5": "禹。",
                "6": "稷躬稼而有天下。",
                "7": "夫子不答。"
            },
            "13": {
                "1": "南宮适出。",
                "2": "子曰。",
                "3": "君子哉若人。",
                "4": "尙德哉若人。"
            }
        },
        "6": {
            "15": {
                "1": "子曰。",
                "2": "君子而不仁者有矣夫。",
                "3": "未有小人而仁者也。"
            }
        },
        "7": {
            "17": {
                "1": "子曰。",
                "2": "愛之。",
                "3": "能勿勞乎。",
                "4": "忠焉。",
                "5": "能勿誨乎。"
            }
        },
        "8": {
            "19": {
                "1": "子曰。",
                "2": "爲命。",
                "3": "裨諶草創之。",
                "4": "世叔討論之。",
                "5": "行人子羽修飾之。",
                "6": "東里子產潤色之。"
            }
        },
        "9": {
            "21": {
                "1": "或問子產。",
                "2": "子曰。",
                "3": "惠人也。"
            },
            "22": {
                "1": "問子西。",
                "2": "曰。",
                "3": "彼哉。",
                "4": "彼哉。"
            },
            "23": {
                "1": "問管仲。",
                "2": "曰。",
                "3": "人也。",
                "4": "奪伯氏騈邑三百。",
                "5": "飯疏食。",
                "6": "沒齒無怨言。"
            }
        },
        "10": {
            "25": {
                "1": "子曰。",
                "2": "貧而無怨。",
                "3": "難。",
                "4": "富而無驕。",
                "5": "易。"
            }
        },
        "11": {
            "27": {
                "1": "子曰。",
                "2": "孟公綽爲趙。",
                "3": "魏老則優。",
                "4": "不可以爲滕。",
                "5": "薛大夫。"
            }
        },
        "12": {
            "29": {
                "1": "子路問成人。",
                "2": "子曰。",
                "3": "若臧武仲之知。",
                "4": "公綽之不欲。",
                "5": "卞莊子之勇。",
                "6": "冉求之藝。",
                "7": "文之以禮樂。",
                "8": "亦可以爲成人矣。",
                "9": "曰。",
                "10": "今之成人者何必然。",
                "11": "見利思義。",
                "12": "見危授命。",
                "13": "久要不忘平生之言。",
                "14": "亦可以爲成人矣。"
            }
        },
        "13": {
            "31": {
                "1": "子問公叔文子於公明賈曰。",
                "2": "信乎。",
                "3": "夫子不言。",
                "4": "不笑。",
                "5": "不取乎。"
            },
            "32": {
                "1": "公明賈對曰。",
                "2": "以告者過也。",
                "3": "夫子時然後言。",
                "4": "人不厭其言。",
                "5": "樂然後笑。",
                "6": "人不厭其笑。",
                "7": "義然後取。",
                "8": "人不厭其取。"
            },
            "33": {
                "1": "子曰。",
                "2": "其然。",
                "3": "豈其然乎。"
            }
        },
        "14": {
            "35": {
                "1": "子曰。",
                "2": "臧武仲以防求爲後於魯。",
                "3": "雖曰不要君。",
                "4": "吾不信也。"
            }
        },
        "15": {
            "37": {
                "1": "子曰。",
                "2": "晉文公譎而不正。",
                "3": "齊桓公正而不譎。"
            }
        },
        "16": {
            "39": {
                "1": "子路曰。",
                "2": "桓公殺公子糾。",
                "3": "召忽死之。",
                "4": "管仲不死。",
                "5": "曰。",
                "6": "未仁乎。",
                "7": "子曰。",
                "8": "桓公九合諸侯。",
                "9": "不以兵車。",
                "10": "管仲之力也。",
                "11": "如其仁。",
                "12": "如其仁。"
            }
        },
        "17": {
            "41": {
                "1": "子貢曰。",
                "2": "管仲非仁者與。",
                "3": "桓公殺公子糾。",
                "4": "不能死。",
                "5": "又相之。",
                "6": "子曰。",
                "7": "管仲相桓公。",
                "8": "霸諸侯。",
                "9": "一匡天下。",
                "10": "民到於今受其賜。",
                "11": "微管仲。",
                "12": "吾其被髮左衽矣。",
                "13": "豈若匹夫匹婦之爲諒也。",
                "14": "自經於溝瀆而莫之知也。"
            }
        },
        "18": {
            "43": {
                "1": "公叔文子之臣大夫僎與文子同升諸公。",
                "2": "子聞之。",
                "3": "曰。",
                "4": "可以爲文矣。"
            }
        },
        "19": {
            "45": {
                "1": "子言衞靈公之無道也。",
                "2": "康子曰。",
                "3": "夫如是。",
                "4": "奚而不喪。",
                "5": "孔子曰。",
                "6": "仲叔圉治賓客。",
                "7": "祝鮀治宗廟。",
                "8": "王孫賈治軍旅。",
                "9": "夫如是。",
                "10": "奚其喪。"
            }
        },
        "20": {
            "47": {
                "1": "子曰。",
                "2": "其言之不怍。",
                "3": "則爲之也難。"
            }
        },
        "21": {
            "49": {
                "1": "陳成子弒簡公。",
                "2": "孔子沐浴而朝。",
                "3": "告於哀公曰。",
                "4": "陳恆弒其君。",
                "5": "請討之。",
                "6": "公曰。",
                "7": "告夫三子。"
            },
            "50": {
                "1": "孔。"
            },
            "51": {
                "1": "子曰。",
                "2": "以吾從大夫之後。",
                "3": "不敢不告也。",
                "4": "君曰告夫三子者。"
            },
            "52": {
                "1": "之三子告。",
                "2": "不可。",
                "3": "孔子曰。",
                "4": "以吾從大夫之後。",
                "5": "不敢不告也。"
            }
        },
        "22": {
            "54": {
                "1": "子路問事君。",
                "2": "子曰。",
                "3": "勿欺也。",
                "4": "而犯之。"
            }
        },
        "23": {
            "56": {
                "1": "子曰。",
                "2": "君子上達。",
                "3": "小人下達。"
            }
        },
        "24": {
            "58": {
                "1": "子曰。",
                "2": "古之學者爲己。",
                "3": "今之學者爲人。"
            }
        },
        "25": {
            "60": {
                "1": "蘧伯玉使人於孔子。",
                "2": "孔子與之坐而問焉。",
                "3": "曰。",
                "4": "夫子何爲。",
                "5": "對曰。",
                "6": "夫子欲寡其過而未能也。"
            },
            "61": {
                "1": "使者出。",
                "2": "子曰。",
                "3": "使乎。",
                "4": "使乎。"
            }
        },
        "26": {
            "63": {
                "1": "子曰。",
                "2": "不在其位。",
                "3": "不謀其政。"
            }
        },
        "27": {
            "65": {
                "1": "曾子曰。",
                "2": "君子思不出其位。"
            }
        },
        "28": {
            "67": {
                "1": "子曰。",
                "2": "君子恥其言而過其行。"
            }
        },
        "29": {
            "69": {
                "1": "子曰。",
                "2": "君子道者三。",
                "3": "我無能焉。",
                "4": "仁者不憂。",
                "5": "知者不惑。",
                "6": "勇者不懼。",
                "7": "子貢曰。",
                "8": "夫子自道也。"
            }
        },
        "30": {
            "71": {
                "1": "子貢方人。",
                "2": "子曰。",
                "3": "賜也賢乎哉。",
                "4": "夫我則不暇。"
            }
        },
        "31": {
            "73": {
                "1": "子曰。",
                "2": "不患人之不己知。",
                "3": "患其不能也。"
            }
        },
        "32": {
            "75": {
                "1": "子曰。",
                "2": "不逆詐。",
                "3": "不億不信。",
                "4": "抑亦先覺者。",
                "5": "是賢乎。"
            }
        },
        "33": {
            "77": {
                "1": "微生畝謂孔子曰。",
                "2": "丘何爲是栖栖者與。",
                "3": "無乃爲佞乎。",
                "4": "孔子曰。",
                "5": "非敢爲佞也。",
                "6": "疾固也。"
            }
        },
        "34": {
            "79": {
                "1": "子曰。",
                "2": "驥不稱其力。",
                "3": "稱其德也。"
            }
        },
        "35": {
            "81": {
                "1": "或曰。",
                "2": "以德報怨。",
                "3": "何如。",
                "4": "子曰。",
                "5": "何以報德。",
                "6": "以直報怨。",
                "7": "以德報德。"
            }
        },
        "36": {
            "83": {
                "1": "子曰。",
                "2": "莫我知也夫。",
                "3": "子貢曰。",
                "4": "何爲其莫知子也。",
                "5": "子曰。",
                "6": "不怨天。",
                "7": "不尤人。",
                "8": "下學而上達。",
                "9": "知我者其天乎。"
            }
        },
        "37": {
            "85": {
                "1": "公伯寮愬子路於季孫。",
                "2": "子服景伯以告。",
                "3": "曰。",
                "4": "夫子固有惑志於公伯寮。",
                "5": "吾力猶能肆諸市朝。"
            },
            "86": {
                "1": "子曰。",
                "2": "道之將行也與。",
                "3": "命也。",
                "4": "道之將廢也與。",
                "5": "命也。",
                "6": "公伯寮其如命何。"
            }
        },
        "38": {
            "88": {
                "1": "子曰。",
                "2": "賢者辟世。",
                "3": "其次辟地。",
                "4": "其次辟色。",
                "5": "其次辟言。"
            },
            "89": {
                "1": "子曰。",
                "2": "作者七人矣。"
            }
        },
        "39": {
            "91": {
                "1": "子路宿於石門。",
                "2": "晨門曰。",
                "3": "奚自。",
                "4": "子路曰。",
                "5": "自孔氏。",
                "6": "曰。",
                "7": "是知其不可而爲之者與。"
            }
        },
        "40": {
            "93": {
                "1": "子擊磬於衞。",
                "2": "有荷蕢而過孔氏之門者。",
                "3": "曰。",
                "4": "有心哉。",
                "5": "擊磬乎。",
                "6": "旣而曰。",
                "7": "鄙哉。",
                "8": "硜硜乎。",
                "9": "莫己知也。",
                "10": "斯己而已矣。",
                "11": "深則厲。",
                "12": "淺則揭。"
            },
            "94": {
                "1": "子曰。",
                "2": "果哉。",
                "3": "末之難矣。"
            }
        },
        "41": {
            "96": {
                "1": "子張曰。",
                "2": "書云。",
                "3": "高宗諒陰。",
                "4": "三年不言。",
                "5": "何謂也。",
                "6": "子曰。",
                "7": "何必高宗。",
                "8": "古之人皆然。",
                "9": "君薨。",
                "10": "百官總己以聽於冢宰三年。"
            }
        },
        "42": {
            "98": {
                "1": "子曰。",
                "2": "上好禮。",
                "3": "則民易使也。"
            }
        },
        "43": {
            "100": {
                "1": "子路問君子。",
                "2": "子曰。",
                "3": "修己以敬。"
            },
            "101": {
                "1": "曰。",
                "2": "如斯而已乎。",
                "3": "曰。",
                "4": "修己以安人。"
            },
            "102": {
                "1": "曰。",
                "2": "如斯而已乎。",
                "3": "曰。",
                "4": "修己以安百姓。",
                "5": "修己以安百姓。",
                "6": "堯。",
                "7": "舜其猶病諸。"
            }
        },
        "44": {
            "104": {
                "1": "原壤夷俟。",
                "2": "子曰。",
                "3": "幼而不孫弟。",
                "4": "長而無述焉。",
                "5": "老而不死。",
                "6": "是爲賊。",
                "7": "以杖叩其脛。"
            }
        },
        "45": {
            "106": {
                "1": "闕黨童子將命。",
                "2": "或問之曰。",
                "3": "益者與。",
                "4": "子曰。",
                "5": "吾見其居於位也。",
                "6": "見其與先生並行也。",
                "7": "非求益者也。",
                "8": "欲速成者也。"
            }
        }
    }
}