{
    "11": {
        "篇名": "論語·先進第十一",
        "1": {
            "3": {
                "1": "子曰。",
                "2": "先進於禮樂。",
                "3": "野人也。",
                "4": "後進於禮樂。",
                "5": "君子也。",
                "6": "如用之。",
                "7": "則吾從先進。"
            }
        },
        "2": {
            "5": {
                "1": "子曰。",
                "2": "從我於陳。",
                "3": "蔡者。",
                "4": "皆不及門也。"
            }
        },
        "3": {
            "7": {
                "1": "德行。",
                "2": "顏淵。",
                "3": "閔子騫。",
                "4": "冉伯牛。",
                "5": "仲弓。",
                "6": "言語。",
                "7": "宰我。",
                "8": "子貢。",
                "9": "政事。",
                "10": "冉有。",
                "11": "季路。",
                "12": "文學。",
                "13": "子游。",
                "14": "子夏。"
            }
        },
        "4": {
            "9": {
                "1": "子曰。",
                "2": "回也。",
                "3": "非助我者也。",
                "4": "於吾言無所不說。"
            }
        },
        "5": {
            "11": {
                "1": "子曰。",
                "2": "孝哉。",
                "3": "閔子騫。",
                "4": "人不間於其父母昆弟之言。"
            }
        },
        "6": {
            "13": {
                "1": "南容三復白圭。",
                "2": "孔子以其兄之子妻之。"
            }
        },
        "7": {
            "15": {
                "1": "季康子問。",
                "2": "弟子孰爲好學。",
                "3": "孔子對曰。",
                "4": "有顏回者好學。",
                "5": "不幸短命死矣。",
                "6": "今也則亡。"
            }
        },
        "8": {
            "17": {
                "1": "顏淵死。",
                "2": "顏路請子之車以爲之椁。",
                "3": "子曰。",
                "4": "才不才。",
                "5": "亦各言其子也。",
                "6": "鯉也死。",
                "7": "有棺而無椁。",
                "8": "吾不徒行以爲之椁。",
                "9": "以吾從大夫之後。",
                "10": "不可徒行也。"
            }
        },
        "9": {
            "19": {
                "1": "顏淵死。",
                "2": "子曰。",
                "3": "噫。",
                "4": "天喪予。",
                "5": "天喪予。"
            }
        },
        "10": {
            "21": {
                "1": "顏淵死。",
                "2": "子哭之慟。",
                "3": "從者曰。",
                "4": "子慟矣。",
                "5": "曰。",
                "6": "有慟乎。",
                "7": "非夫人之爲慟而誰爲。"
            }
        },
        "11": {
            "23": {
                "1": "顏淵死。",
                "2": "門人欲厚葬之。",
                "3": "子曰。",
                "4": "不可。"
            },
            "24": {
                "1": "門人厚葬之。",
                "2": "子曰。",
                "3": "回也視予猶父也。",
                "4": "予不得視猶子也。",
                "5": "非我也。",
                "6": "夫二三子也。"
            }
        },
        "12": {
            "26": {
                "1": "季路問事鬼神。",
                "2": "子曰。",
                "3": "未能事人。",
                "4": "焉能事鬼。"
            },
            "27": {
                "1": "曰。",
                "2": "敢問死。",
                "3": "曰。",
                "4": "未知生。",
                "5": "焉知死。"
            }
        },
        "13": {
            "29": {
                "1": "閔子侍側。",
                "2": "誾誾如也。",
                "3": "子路。",
                "4": "行行如也。",
                "5": "冉有。",
                "6": "子貢。",
                "7": "侃侃如也。",
                "8": "子樂。",
                "9": "若由也。",
                "10": "不得其死然。"
            }
        },
        "14": {
            "31": {
                "1": "魯人爲長府。",
                "2": "閔子騫曰。",
                "3": "仍舊貫。",
                "4": "如之何。",
                "5": "何必改作。",
                "6": "子曰。",
                "7": "夫人不言。",
                "8": "言必有中。"
            }
        },
        "15": {
            "33": {
                "1": "子曰。",
                "2": "由之瑟。",
                "3": "奚爲於丘之門。",
                "4": "門人不敬子路。",
                "5": "子曰。",
                "6": "由也升堂矣。",
                "7": "未入於室也。"
            }
        },
        "16": {
            "35": {
                "1": "子貢問。",
                "2": "師與商也孰賢。",
                "3": "子曰。",
                "4": "師也過。",
                "5": "商也不及。"
            },
            "36": {
                "1": "曰。",
                "2": "然則師愈與。",
                "3": "子曰。",
                "4": "過猶不及。"
            }
        },
        "17": {
            "38": {
                "1": "季氏富於周公。",
                "2": "而求也爲之聚斂而附益之。",
                "3": "子曰。",
                "4": "非吾徒也。",
                "5": "小子鳴鼓而攻之。",
                "6": "可也。"
            }
        },
        "18": {
            "40": {
                "1": "柴也愚。",
                "2": "參也魯。",
                "3": "師也辟。",
                "4": "由也喭。"
            }
        },
        "19": {
            "42": {
                "1": "子曰。",
                "2": "回也。",
                "3": "其庶乎。",
                "4": "屢空。",
                "5": "賜不受命。",
                "6": "而貨殖焉。",
                "7": "億則屢中。"
            }
        },
        "20": {
            "44": {
                "1": "子張問善人之道。",
                "2": "子曰。",
                "3": "不踐迹。",
                "4": "亦不入於室。"
            }
        },
        "21": {
            "46": {
                "1": "子曰。",
                "2": "論篤是與。",
                "3": "君子者乎。",
                "4": "色莊者乎。"
            }
        },
        "22": {
            "48": {
                "1": "子路問。",
                "2": "聞斯行諸。",
                "3": "子曰。",
                "4": "有父兄在。",
                "5": "如之何其聞斯行之。"
            },
            "49": {
                "1": "冉有問。",
                "2": "聞斯行諸。",
                "3": "子曰。",
                "4": "聞斯行之。"
            },
            "50": {
                "1": "公西華曰。",
                "2": "由也問聞斯行諸。",
                "3": "子曰。",
                "4": "有父兄在。",
                "5": "求也問聞所行諸。",
                "6": "子曰。",
                "7": "聞斯行之。",
                "8": "赤也惑。",
                "9": "敢問。",
                "10": "子曰。",
                "11": "求也退。",
                "12": "故進之。",
                "13": "由也兼人。",
                "14": "故退之。"
            }
        },
        "23": {
            "52": {
                "1": "子畏於匡。",
                "2": "顏淵後。",
                "3": "子曰。",
                "4": "吾以女爲死矣。",
                "5": "曰。",
                "6": "子在。",
                "7": "回何敢死。"
            }
        },
        "24": {
            "54": {
                "1": "季子然問。",
                "2": "仲由。",
                "3": "冉求可謂大臣與。",
                "4": "子曰。",
                "5": "吾以子爲異之問。",
                "6": "曾由與求之問。",
                "7": "所謂大臣者。",
                "8": "以道事君。",
                "9": "不可則止。",
                "10": "今由與求也。",
                "11": "可謂具臣矣。"
            },
            "55": {
                "1": "曰。",
                "2": "然則從之者與。",
                "3": "子曰。",
                "4": "弑父與君。",
                "5": "亦不從也。"
            }
        },
        "25": {
            "57": {
                "1": "子路使子羔爲費宰。",
                "2": "子曰。",
                "3": "賊夫人之子。"
            },
            "58": {
                "1": "子路曰。",
                "2": "有民人焉。",
                "3": "有社稷焉。",
                "4": "何必讀書。",
                "5": "然後爲學。"
            },
            "59": {
                "1": "子曰。",
                "2": "是故惡夫佞者。"
            }
        },
        "26": {
            "61": {
                "1": "子路。",
                "2": "曾皙。",
                "3": "冉有。",
                "4": "公西華侍坐。"
            },
            "62": {
                "1": "子曰。",
                "2": "以吾一日長乎爾。",
                "3": "毋吾以也。",
                "4": "居則曰。",
                "5": "不吾知也。",
                "6": "如或知爾。",
                "7": "則何以哉。"
            },
            "63": {
                "1": "子路率爾而對。",
                "2": "曰。",
                "3": "千乘之國。",
                "4": "攝乎大國之間。",
                "5": "加之以師旅。",
                "6": "因之以饑饉。",
                "7": "由也爲之。",
                "8": "比及三年。",
                "9": "可使有勇。",
                "10": "且知方也。"
            },
            "64": {
                "1": "夫子哂之。"
            },
            "65": {
                "1": "求。",
                "2": "爾何如。"
            },
            "66": {
                "1": "對曰。",
                "2": "方六七十。",
                "3": "如五六十。",
                "4": "求也爲之。",
                "5": "比及三年。",
                "6": "可使足民。",
                "7": "如其禮樂。",
                "8": "以俟君子。"
            },
            "67": {
                "1": "赤。",
                "2": "爾何如。"
            },
            "68": {
                "1": "對曰。",
                "2": "非曰能之。",
                "3": "願學焉。",
                "4": "宗廟之事。",
                "5": "如會同。",
                "6": "端章甫。",
                "7": "願爲小相焉。"
            },
            "69": {
                "1": "點。",
                "2": "爾何如。"
            },
            "70": {
                "1": "鼓瑟希。",
                "2": "鏗爾。",
                "3": "舍瑟而作。",
                "4": "對曰。",
                "5": "異乎三子者之撰。"
            },
            "71": {
                "1": "子曰。",
                "2": "何傷乎。",
                "3": "亦各言其志也。"
            },
            "72": {
                "1": "曰。",
                "2": "莫春者。",
                "3": "春服旣成。",
                "4": "冠者五六人。",
                "5": "童子六七人。",
                "6": "浴乎沂。",
                "7": "風乎舞雩。",
                "8": "詠而歸。"
            },
            "73": {
                "1": "夫子喟然歎曰。",
                "2": "吾與點也。"
            },
            "74": {
                "1": "三子者出。",
                "2": "曾皙後。",
                "3": "曾皙曰。",
                "4": "夫三子者之言何如。"
            },
            "75": {
                "1": "子曰。",
                "2": "亦各有其志也已矣。"
            },
            "76": {
                "1": "曰。",
                "2": "夫子何哂由也。"
            },
            "77": {
                "1": "曰。",
                "2": "爲國以禮。",
                "3": "其言不讓。",
                "4": "是故哂之。"
            },
            "78": {
                "1": "唯求則非邦也與。"
            },
            "79": {
                "1": "安見方六七十如五六十而非邦也者。"
            },
            "80": {
                "1": "唯赤則非邦也與。"
            },
            "81": {
                "1": "宗廟會同。",
                "2": "非諸侯而何。",
                "3": "赤也爲之小。",
                "4": "孰能爲之大。"
            }
        }
    }
}