{
    "04": {
        "篇名": "論語·里仁第四",
        "1": {
            "3": {
                "1": "子曰。",
                "2": "里仁爲美。",
                "3": "擇不處仁。",
                "4": "焉得知。"
            }
        },
        "2": {
            "5": {
                "1": "子曰。",
                "2": "不仁者不可以久處約。",
                "3": "不可以長處樂。",
                "4": "仁者安仁。",
                "5": "知者利仁。"
            }
        },
        "3": {
            "7": {
                "1": "子曰。",
                "2": "唯仁者能好人。",
                "3": "能惡人。"
            }
        },
        "4": {
            "9": {
                "1": "子曰。",
                "2": "苟志於仁矣。",
                "3": "無惡也。"
            }
        },
        "5": {
            "11": {
                "1": "子曰。",
                "2": "富與貴。",
                "3": "是人之所欲也。",
                "4": "不以其道得之。",
                "5": "不處也。",
                "6": "貧與賤。",
                "7": "是人之所惡也。",
                "8": "不以其道得之。",
                "9": "不去也。",
                "10": "君子去仁。",
                "11": "惡乎成名。",
                "12": "君子無終食之間違仁。",
                "13": "造次必於是。",
                "14": "顚沛必於是。"
            }
        },
        "6": {
            "13": {
                "1": "子曰。",
                "2": "我未見好仁者。",
                "3": "惡不仁者。",
                "4": "好仁者。",
                "5": "無以尙之。",
                "6": "惡不仁者。",
                "7": "其爲仁矣。",
                "8": "不使不仁者加乎其身。",
                "9": "有能一日用其力於仁矣乎。",
                "10": "我未見力不足者。",
                "11": "蓋有之矣。",
                "12": "我未之見也。"
            }
        },
        "7": {
            "15": {
                "1": "子曰。",
                "2": "人之過也。",
                "3": "各於其黨。",
                "4": "觀過。",
                "5": "斯知仁矣。"
            }
        },
        "8": {
            "17": {
                "1": "子曰。",
                "2": "朝聞道。",
                "3": "夕死可矣。"
            }
        },
        "9": {
            "19": {
                "1": "子曰。",
                "2": "士志於道。",
                "3": "而恥惡衣惡食者。",
                "4": "未足與議也。"
            }
        },
        "10": {
            "21": {
                "1": "子曰。",
                "2": "君子之於天下也。",
                "3": "無適也。",
                "4": "無莫也。",
                "5": "義之與比。"
            }
        },
        "11": {
            "23": {
                "1": "子曰。",
                "2": "君子懷德。",
                "3": "小人懷土。",
                "4": "君子懷刑。",
                "5": "小人懷惠。"
            }
        },
        "12": {
            "25": {
                "1": "子曰。",
                "2": "放於利而行。",
                "3": "多怨。"
            }
        },
        "13": {
            "27": {
                "1": "子曰。",
                "2": "能以禮讓爲國乎。",
                "3": "何有。",
                "4": "不能以禮讓爲國。",
                "5": "如禮何。"
            }
        },
        "14": {
            "29": {
                "1": "子曰。",
                "2": "不患無位。",
                "3": "患所以立。",
                "4": "不患莫己知。",
                "5": "求爲可知也。"
            }
        },
        "15": {
            "31": {
                "1": "子曰。",
                "2": "參乎。",
                "3": "吾道一以貫之。",
                "4": "曾子曰。",
                "5": "唯。",
                "6": "子出。",
                "7": "門人問曰。",
                "8": "何謂也。",
                "9": "曾子曰。",
                "10": "夫子之道。",
                "11": "忠恕而已矣。"
            }
        },
        "16": {
            "33": {
                "1": "子曰。",
                "2": "君子喩於義。",
                "3": "小人喩於利。"
            }
        },
        "17": {
            "35": {
                "1": "子曰。",
                "2": "見賢思齊焉。",
                "3": "見不賢而內自省也。"
            }
        },
        "18": {
            "37": {
                "1": "子曰。",
                "2": "事父母幾諫。",
                "3": "見志不從。",
                "4": "又敬不違。",
                "5": "勞而不怨。"
            }
        },
        "19": {
            "39": {
                "1": "子曰。",
                "2": "父母在。",
                "3": "不遠遊。",
                "4": "遊必有方。"
            }
        },
        "20": {
            "41": {
                "1": "子曰。",
                "2": "三年無改於父之道。",
                "3": "可謂孝矣。"
            }
        },
        "21": {
            "43": {
                "1": "子曰。",
                "2": "父母之年。",
                "3": "不可不知也。",
                "4": "一則以喜。",
                "5": "一則以懼。"
            }
        },
        "22": {
            "45": {
                "1": "子曰。",
                "2": "古者言之不出。",
                "3": "恥躬之不逮也。"
            }
        },
        "23": {
            "47": {
                "1": "子曰。",
                "2": "以約失之者。",
                "3": "鮮矣。"
            }
        },
        "24": {
            "49": {
                "1": "子曰。",
                "2": "君子欲訥於言而敏於行。"
            }
        },
        "25": {
            "51": {
                "1": "子曰。",
                "2": "德不孤。",
                "3": "必有鄰。"
            }
        },
        "26": {
            "53": {
                "1": "子游曰。",
                "2": "事君數。",
                "3": "斯辱矣。",
                "4": "朋友數。",
                "5": "斯疏矣。"
            }
        }
    }
}