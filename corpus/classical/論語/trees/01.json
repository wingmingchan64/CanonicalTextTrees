{
    "01": {
        "篇名": "論語·學而第一",
        "1": {
            "3": {
                "1": "子曰。",
                "2": "學而時習之。",
                "3": "不亦說乎。",
                "4": "有朋自遠方來。",
                "5": "不亦樂乎。",
                "6": "人不知而不慍。",
                "7": "不亦君子乎。"
            }
        },
        "2": {
            "5": {
                "1": "有子曰。",
                "2": "其爲人也孝弟。",
                "3": "而好犯上者。",
                "4": "鮮矣。",
                "5": "不好犯上。",
                "6": "而好作亂者。",
                "7": "未之有也。",
                "8": "君子務本。",
                "9": "本立而道生。",
                "10": "孝弟也者。",
                "11": "其爲仁之本與。"
            }
        },
        "3": {
            "7": {
                "1": "子曰。",
                "2": "巧言令色。",
                "3": "鮮矣仁。"
            }
        },
        "4": {
            "9": {
                "1": "曾子曰。",
                "2": "吾日三省吾身。",
                "3": "爲人謀而不忠乎。",
                "4": "與朋友交而不信乎。",
                "5": "傳不習乎。"
            }
        },
        "5": {
            "11": {
                "1": "子曰。",
                "2": "道千乘之國。",
                "3": "敬事而信。",
                "4": "節用而愛人。",
                "5": "使民以時。"
            }
        },
        "6": {
            "13": {
                "1": "子曰。",
                "2": "弟子入則孝。",
                "3": "出則悌。",
                "4": "謹而信。",
                "5": "泛愛眾而親仁。",
                "6": "行有餘力。",
                "7": "則以學文。"
            }
        },
        "7": {
            "15": {
                "1": "子夏曰。",
                "2": "賢賢易色。",
                "3": "事父母。",
                "4": "能竭其力。",
                "5": "事君。",
                "6": "能致其身。",
                "7": "與朋友交。",
                "8": "言而有信。",
                "9": "雖曰未學。",
                "10": "吾必謂之學矣。"
            }
        },
        "8": {
            "17": {
                "1": "子曰。",
                "2": "君子不重則不威。",
                "3": "學則不固。",
                "4": "主忠信。",
                "5": "無友不如己者。",
                "6": "過。",
                "7": "則勿憚改。"
            }
        },
        "9": {
            "19": {
                "1": "曾子曰。",
                "2": "愼終。",
                "3": "追遠。",
                "4": "民德歸厚矣。"
            }
        },
        "10": {
            "21": {
                "1": "子禽問於子貢曰。",
                "2": "夫子至於是邦也。",
                "3": "必聞其政。",
                "4": "求之與。",
                "5": "抑與之與。",
                "6": "子貢曰。",
                "7": "夫子溫。",
                "8": "良。",
                "9": "恭。",
                "10": "儉。",
                "11": "讓以得之。",
                "12": "夫子之求之也。",
                "13": "其諸異乎人之求之與。"
            }
        },
        "11": {
            "23": {
                "1": "子曰。",
                "2": "父在。",
                "3": "觀其志。",
                "4": "父沒。",
                "5": "觀其行。",
                "6": "三年無改於父之道。",
                "7": "可謂孝矣。"
            }
        },
        "12": {
            "25": {
                "1": "有子曰。",
                "2": "禮之用。",
                "3": "和爲貴。",
                "4": "先王之道。",
                "5": "斯爲美。",
                "6": "小大由之。",
                "7": "有所不行。",
                "8": "知和而和。",
                "9": "不以禮節之。",
                "10": "亦不可行也。"
            }
        },
        "13": {
            "27": {
                "1": "有子曰。",
                "2": "信近於義。",
                "3": "言可復也。",
                "4": "恭近於禮。",
                "5": "遠恥辱也。",
                "6": "因不失其親。",
                "7": "亦可宗也。"
            }
        },
        "14": {
            "29": {
                "1": "子曰。",
                "2": "君子食無求飽。",
                "3": "居無求安。",
                "4": "敏於事而愼於言。",
                "5": "就有道而正焉。",
                "6": "可謂好學也已。"
            }
        },
        "15": {
            "31": {
                "1": "子貢曰。",
                "2": "貧而無諂。",
                "3": "富而無驕。",
                "4": "何如。",
                "5": "子曰。",
                "6": "可也。",
                "7": "未若貧而樂。",
                "8": "富而好禮者也。",
                "9": "子貢曰。",
                "10": "詩云。",
                "11": "如切如磋。",
                "12": "如琢如磨。",
                "13": "其斯之謂與。",
                "14": "子曰。",
                "15": "賜也。",
                "16": "始可與言詩已矣。",
                "17": "告諸往而知來者。"
            }
        },
        "16": {
            "33": {
                "1": "子曰。",
                "2": "不患人之不己知。",
                "3": "患不知人也。"
            }
        }
    }
}