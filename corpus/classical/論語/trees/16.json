{
    "16": {
        "篇名": "論語·季氏第十六",
        "1": {
            "3": {
                "1": "季氏將伐顓臾。",
                "2": "冉有。",
                "3": "季路見於孔子曰。",
                "4": "季氏將有事於顓臾。"
            },
            "4": {
                "1": "孔子曰。",
                "2": "求。",
                "3": "無乃爾是過與。",
                "4": "夫顓臾。",
                "5": "昔者先王以爲東蒙主。",
                "6": "且在邦域之中矣。",
                "7": "是社稷之臣也。",
                "8": "何以伐爲。"
            },
            "5": {
                "1": "冉有曰。",
                "2": "夫子欲之。",
                "3": "吾二臣者皆不欲也。"
            },
            "6": {
                "1": "孔子曰。",
                "2": "求。",
                "3": "周任有言曰。",
                "4": "陳力就列。",
                "5": "不能者止。",
                "6": "危而不持。",
                "7": "顚而不扶。",
                "8": "則將焉用彼相矣。",
                "9": "且爾言過矣。",
                "10": "虎兕出於柙。",
                "11": "龜玉毀於櫝中。",
                "12": "是誰之過與。"
            },
            "7": {
                "1": "冉有曰。",
                "2": "今夫顓臾。",
                "3": "固而近於費。",
                "4": "今不取。",
                "5": "後世必爲子孫憂。"
            },
            "8": {
                "1": "孔子曰。",
                "2": "求。",
                "3": "君子疾夫。",
                "4": "舍曰欲之。",
                "5": "而必爲之辭。",
                "6": "丘也聞有國有家者。",
                "7": "不患寡而患不均。",
                "8": "不患貧而患不安。",
                "9": "蓋均無貧。",
                "10": "和無寡。",
                "11": "安無傾。",
                "12": "夫如是。",
                "13": "故遠人不服。",
                "14": "則修文德以來之。",
                "15": "旣來之。",
                "16": "則安之。",
                "17": "今由與求也。",
                "18": "相夫子。",
                "19": "遠人不服。",
                "20": "而不能來也。",
                "21": "邦分崩離析。",
                "22": "而不能守也。",
                "23": "而謀動干戈於邦內。",
                "24": "吾恐季孫之憂。",
                "25": "不在顓臾。",
                "26": "而在蕭牆之內也。"
            }
        },
        "2": {
            "10": {
                "1": "孔子曰。",
                "2": "天下有道。",
                "3": "則禮樂征伐自天子出。",
                "4": "天下無道。",
                "5": "則禮樂征伐自諸侯出。",
                "6": "自諸侯出。",
                "7": "蓋十世希不失矣。",
                "8": "自大夫出。",
                "9": "五世希不失矣。",
                "10": "陪臣執國命。",
                "11": "三世希不失矣。",
                "12": "天下有道。",
                "13": "則政不在大夫。",
                "14": "天下有道。",
                "15": "則庶人不議。"
            }
        },
        "3": {
            "12": {
                "1": "孔子曰。",
                "2": "祿之去公室五世矣。",
                "3": "政逮於大夫四世矣。",
                "4": "故夫三桓之子孫微矣。"
            }
        },
        "4": {
            "14": {
                "1": "孔子曰。",
                "2": "益者三友。",
                "3": "損者三友。",
                "4": "友直。",
                "5": "友諒。",
                "6": "友多聞。",
                "7": "益矣。",
                "8": "友便辟。",
                "9": "友善柔。",
                "10": "友便佞。",
                "11": "損矣。"
            }
        },
        "5": {
            "16": {
                "1": "孔子曰。",
                "2": "益者三樂。",
                "3": "損者三樂。",
                "4": "樂節禮樂。",
                "5": "樂道人之善。",
                "6": "樂多賢友。",
                "7": "益矣。",
                "8": "樂驕樂。",
                "9": "樂佚遊。",
                "10": "樂宴樂。",
                "11": "損矣。"
            }
        },
        "6": {
            "18": {
                "1": "孔子曰。",
                "2": "侍於君子有三愆。",
                "3": "言未及之而言謂之躁。",
                "4": "言及之而不言謂之隱。",
                "5": "未見顏色而言謂之瞽。"
            }
        },
        "7": {
            "20": {
                "1": "孔子曰。",
                "2": "君子有三戒。",
                "3": "少之時。",
                "4": "血氣未定。",
                "5": "戒之在色。",
                "6": "及其壯也。",
                "7": "血氣方剛。",
                "8": "戒之在鬭。",
                "9": "及其老也。",
                "10": "血氣旣衰。",
                "11": "戒之在得。"
            }
        },
        "8": {
            "22": {
                "1": "孔子曰。",
                "2": "君子有三畏。",
                "3": "畏天命。",
                "4": "畏大人。",
                "5": "畏聖人之言。",
                "6": "小人不知天命而不畏也。",
                "7": "狎大人。",
                "8": "侮聖人之言。"
            }
        },
        "9": {
            "24": {
                "1": "孔子曰。",
                "2": "生而知之者。",
                "3": "上也。",
                "4": "學而知之者。",
                "5": "次也。",
                "6": "困而學之。",
                "7": "又其次也。",
                "8": "困而不學。",
                "9": "民斯爲下矣。"
            }
        },
        "10": {
            "26": {
                "1": "孔子曰。",
                "2": "君子有九思。",
                "3": "視思明。",
                "4": "聽思聰。",
                "5": "色思溫。",
                "6": "貌思恭。",
                "7": "言思忠。",
                "8": "事思敬。",
                "9": "疑思問。",
                "10": "忿思難。",
                "11": "見得思義。"
            }
        },
        "11": {
            "28": {
                "1": "孔子曰。",
                "2": "見善如不及。",
                "3": "見不善如探湯。",
                "4": "吾見其人矣。",
                "5": "吾聞其語矣。",
                "6": "隱居以求其志。",
                "7": "行義以達其道。",
                "8": "吾聞其語矣。",
                "9": "未見其人也。"
            }
        },
        "12": {
            "30": {
                "1": "齊景公有馬千駟。",
                "2": "死之日。",
                "3": "民無德而稱焉。",
                "4": "伯夷。",
                "5": "叔齊餓於首陽之下。",
                "6": "民到於今稱之。",
                "7": "其斯之謂與。"
            }
        },
        "13": {
            "32": {
                "1": "陳亢問於伯魚曰。",
                "2": "子亦有異聞乎。"
            },
            "33": {
                "1": "對曰。",
                "2": "未也。",
                "3": "嘗獨立。",
                "4": "鯉趨而過庭。",
                "5": "曰。",
                "6": "學詩乎。",
                "7": "對曰。",
                "8": "未也。",
                "9": "不學詩。",
                "10": "無以言。",
                "11": "鯉退而學詩。",
                "12": "他日又獨立。",
                "13": "鯉趨而過庭。",
                "14": "曰。",
                "15": "學禮乎。",
                "16": "對曰。",
                "17": "未也。",
                "18": "不學禮。",
                "19": "無以立。",
                "20": "鯉退而學禮。",
                "21": "聞斯二者。"
            },
            "34": {
                "1": "陳亢退而喜曰。",
                "2": "問一得三。",
                "3": "聞詩。",
                "4": "聞禮。",
                "5": "又聞君子之遠其子也。"
            }
        },
        "14": {
            "36": {
                "1": "邦君之妻。",
                "2": "君稱之曰夫人。",
                "3": "夫人自稱曰小童。",
                "4": "邦人稱之曰君夫人。",
                "5": "稱諸異邦曰寡小君。",
                "6": "異邦人稱之亦曰君夫人。"
            }
        }
    }
}