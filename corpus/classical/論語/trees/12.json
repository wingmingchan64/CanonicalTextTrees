{
    "12": {
        "篇名": "論語·顏淵第十二",
        "1": {
            "3": {
                "1": "顏淵問仁。",
                "2": "子曰。",
                "3": "克己復禮爲仁。",
                "4": "一日克己復禮。",
                "5": "天下歸仁焉。",
                "6": "爲仁由己。",
                "7": "而由人乎哉。"
            },
            "4": {
                "1": "顏淵曰。",
                "2": "請問其目。",
                "3": "子曰。",
                "4": "非禮勿視。",
                "5": "非禮勿聽。",
                "6": "非禮勿言。",
                "7": "非禮勿動。"
            },
            "5": {
                "1": "顏淵曰。",
                "2": "回雖不敏。",
                "3": "請事斯語矣。"
            }
        },
        "2": {
            "7": {
                "1": "仲弓問仁。",
                "2": "子曰。",
                "3": "出門如見大賓。",
                "4": "使民如承大祭。",
                "5": "己所不欲。",
                "6": "勿施於人。",
                "7": "在邦無怨。",
                "8": "在家無怨。"
            },
            "8": {
                "1": "仲弓曰。",
                "2": "雍雖不敏。",
                "3": "請事斯語矣。"
            }
        },
        "3": {
            "10": {
                "1": "司馬牛問仁。",
                "2": "子曰。",
                "3": "仁者。",
                "4": "其言也訒。"
            },
            "11": {
                "1": "曰。",
                "2": "其言也訒。",
                "3": "斯謂之仁已乎。",
                "4": "子曰。",
                "5": "爲之難。",
                "6": "言之得無訒乎。"
            }
        },
        "4": {
            "13": {
                "1": "司馬牛問君子。",
                "2": "子曰。",
                "3": "君子不憂不懼。"
            },
            "14": {
                "1": "曰。",
                "2": "不憂不懼。",
                "3": "斯謂之君子已乎。",
                "4": "子曰。",
                "5": "內省不疚。",
                "6": "夫何憂何懼。"
            }
        },
        "5": {
            "16": {
                "1": "司馬牛憂曰。",
                "2": "人皆有兄弟。",
                "3": "我獨亡。",
                "4": "子夏曰。",
                "5": "商聞之矣。",
                "6": "死生有命。",
                "7": "富貴在天。",
                "8": "君子敬而無失。",
                "9": "與人恭而有禮。",
                "10": "四海之內。",
                "11": "皆兄弟也。",
                "12": "君子何患乎無兄弟也。"
            }
        },
        "6": {
            "18": {
                "1": "子張問明。",
                "2": "子曰。",
                "3": "浸潤之譖。",
                "4": "膚受之愬。",
                "5": "不行焉。",
                "6": "可謂明也已矣。",
                "7": "浸潤之譖。",
                "8": "膚受之愬。",
                "9": "不行焉。",
                "10": "可謂遠也已矣。"
            }
        },
        "7": {
            "20": {
                "1": "子貢問政。",
                "2": "子曰。",
                "3": "足食。",
                "4": "足兵。",
                "5": "民信之矣。"
            },
            "21": {
                "1": "子貢曰。",
                "2": "必不得已而去。",
                "3": "於斯三者何先。",
                "4": "曰。",
                "5": "去兵。"
            },
            "22": {
                "1": "子貢曰。",
                "2": "必不得已而去。",
                "3": "於斯二者何先。",
                "4": "曰。",
                "5": "去食。",
                "6": "自古皆有死。",
                "7": "民無信不立。"
            }
        },
        "8": {
            "24": {
                "1": "棘子成曰。",
                "2": "君子質而已矣。",
                "3": "何以文爲。",
                "4": "子貢曰。",
                "5": "惜乎。",
                "6": "夫子之說君子也。",
                "7": "駟不及舌。",
                "8": "文猶質也。",
                "9": "質猶文也。",
                "10": "虎豹之鞹猶犬羊之鞟。"
            }
        },
        "9": {
            "26": {
                "1": "哀公問於有若曰。",
                "2": "年饑。",
                "3": "用不足。",
                "4": "如之何。"
            },
            "27": {
                "1": "有若對曰。",
                "2": "盍徹乎。"
            },
            "28": {
                "1": "曰。",
                "2": "二。",
                "3": "吾猶不足。",
                "4": "如之何其徹也。"
            },
            "29": {
                "1": "對曰。",
                "2": "百姓足。",
                "3": "君孰與不足。",
                "4": "百姓不足。",
                "5": "君孰與足。"
            }
        },
        "10": {
            "31": {
                "1": "子張問崇德辨惑。",
                "2": "子曰。",
                "3": "主忠信。",
                "4": "徙義。",
                "5": "崇德也。",
                "6": "愛之欲其生。",
                "7": "惡之欲其死。",
                "8": "旣欲其生。",
                "9": "又欲其死。",
                "10": "是惑也。",
                "11": "誠不以富。",
                "12": "亦祇以異。"
            }
        },
        "11": {
            "33": {
                "1": "齊景公問政於孔子。",
                "2": "孔子對曰。",
                "3": "君君。",
                "4": "臣臣。",
                "5": "父父。",
                "6": "子子。",
                "7": "公曰。",
                "8": "善哉。",
                "9": "信如君不君。",
                "10": "臣不臣。",
                "11": "父不父。",
                "12": "子不子。",
                "13": "雖有粟。",
                "14": "吾得而食諸。"
            }
        },
        "12": {
            "35": {
                "1": "子曰。",
                "2": "片言可以折獄者。",
                "3": "其由也與。"
            },
            "36": {
                "1": "子路無宿諾。"
            }
        },
        "13": {
            "38": {
                "1": "子曰。",
                "2": "聽訟。",
                "3": "吾猶人也。",
                "4": "必也使無訟乎。"
            }
        },
        "14": {
            "40": {
                "1": "子張問政。",
                "2": "子曰。",
                "3": "居之無倦。",
                "4": "行之以忠。"
            }
        },
        "15": {
            "42": {
                "1": "子曰。",
                "2": "博學於文。",
                "3": "約之以禮。",
                "4": "亦可以弗畔矣夫。"
            }
        },
        "16": {
            "44": {
                "1": "子曰。",
                "2": "君子成人之美。",
                "3": "不成人之惡。",
                "4": "小人反是。"
            }
        },
        "17": {
            "46": {
                "1": "季康子問政於孔子。",
                "2": "孔子對曰。",
                "3": "政者。",
                "4": "正也。",
                "5": "子帥以正。",
                "6": "孰敢不正。"
            }
        },
        "18": {
            "48": {
                "1": "季康子患盜。",
                "2": "問於孔子。",
                "3": "孔子對曰。",
                "4": "苟子之不欲。",
                "5": "雖賞之不竊。"
            }
        },
        "19": {
            "50": {
                "1": "季康子問政於孔子曰。",
                "2": "如殺無道。",
                "3": "以就有道。",
                "4": "何如。",
                "5": "孔子對曰。",
                "6": "子爲政。",
                "7": "焉用殺。",
                "8": "子欲善而民善矣。",
                "9": "君子之德風。",
                "10": "小人之德草。",
                "11": "草上之風。",
                "12": "必偃。"
            }
        },
        "20": {
            "52": {
                "1": "子張問。",
                "2": "士何如斯可謂之達矣。",
                "3": "子曰。",
                "4": "何哉。",
                "5": "爾所謂達者。",
                "6": "子張對曰。",
                "7": "在邦必聞。",
                "8": "在家必聞。",
                "9": "子曰。",
                "10": "是聞也。",
                "11": "非達也。",
                "12": "夫達也者。",
                "13": "質直而好義。",
                "14": "察言而觀色。",
                "15": "慮以下人。",
                "16": "在邦必達。",
                "17": "在家必達。",
                "18": "夫聞也者。",
                "19": "色取仁而行違。",
                "20": "居之不疑。",
                "21": "在邦必聞。",
                "22": "在家必聞。"
            }
        },
        "21": {
            "54": {
                "1": "樊遲從遊於舞雩之下。",
                "2": "曰。",
                "3": "敢問崇德。",
                "4": "修慝。",
                "5": "辨惑。",
                "6": "子曰。",
                "7": "善哉問。",
                "8": "先事後得。",
                "9": "非崇德與。",
                "10": "攻其惡。",
                "11": "無攻人之惡。",
                "12": "非修慝與。",
                "13": "一朝之忿。",
                "14": "忘其身。",
                "15": "以及其親。",
                "16": "非惑與。"
            }
        },
        "22": {
            "56": {
                "1": "樊遲問仁。",
                "2": "子曰。",
                "3": "愛人。",
                "4": "問知。",
                "5": "子曰。",
                "6": "知人。"
            },
            "57": {
                "1": "樊遲未達。",
                "2": "子曰。",
                "3": "舉直錯諸枉。",
                "4": "能使枉者直。"
            },
            "58": {
                "1": "樊遲退。",
                "2": "見子夏曰。",
                "3": "鄕也吾見於夫子而問知。",
                "4": "子曰。",
                "5": "舉直錯諸枉。",
                "6": "能使枉者直。",
                "7": "何謂也。"
            },
            "59": {
                "1": "子夏曰。",
                "2": "富哉言乎。",
                "3": "舜有天下。",
                "4": "選於眾。",
                "5": "舉皋陶。",
                "6": "不仁者遠矣。",
                "7": "湯有天下。",
                "8": "選於眾。",
                "9": "舉伊尹。",
                "10": "不仁者遠矣。"
            }
        },
        "23": {
            "61": {
                "1": "子貢問友。",
                "2": "子曰。",
                "3": "忠告而善道之。",
                "4": "不可則止。",
                "5": "毋自辱焉。"
            }
        },
        "24": {
            "63": {
                "1": "曾子曰。",
                "2": "君子以文會友。",
                "3": "以友輔仁。"
            }
        }
    }
}