{
    "13": {
        "篇名": "論語·子路第十三",
        "1": {
            "3": {
                "1": "子路問政。",
                "2": "子曰。",
                "3": "先之。",
                "4": "勞之。",
                "5": "請益。",
                "6": "曰。",
                "7": "無倦。"
            }
        },
        "2": {
            "5": {
                "1": "仲弓爲季氏宰。",
                "2": "問政。",
                "3": "子曰。",
                "4": "先有司。",
                "5": "赦小過。",
                "6": "舉賢才。"
            },
            "6": {
                "1": "曰。",
                "2": "焉知賢才而舉之。",
                "3": "曰。",
                "4": "舉爾所知。",
                "5": "爾所不知。",
                "6": "人其舍諸。"
            }
        },
        "3": {
            "8": {
                "1": "子路曰。",
                "2": "衞君待子而爲政。",
                "3": "子將奚先。"
            },
            "9": {
                "1": "子曰。",
                "2": "必也正名乎。"
            },
            "10": {
                "1": "子路曰。",
                "2": "有是哉。",
                "3": "子之迂也。",
                "4": "奚其正。"
            },
            "11": {
                "1": "子曰。",
                "2": "野哉。",
                "3": "由也。",
                "4": "君子於其所不知。",
                "5": "蓋闕如也。",
                "6": "名不正。",
                "7": "則言不順。",
                "8": "言不順。",
                "9": "則事不成。",
                "10": "事不成。",
                "11": "則禮樂不興。",
                "12": "禮樂不興。",
                "13": "則刑罰不中。",
                "14": "刑罰不中。",
                "15": "則民無所錯手足。",
                "16": "故君子名之必可言也。",
                "17": "言之必可行也。",
                "18": "君子於其言。",
                "19": "無所苟而已矣。"
            }
        },
        "4": {
            "13": {
                "1": "樊遲請學稼。",
                "2": "子曰。",
                "3": "吾不如老農。",
                "4": "請學爲圃。",
                "5": "曰。",
                "6": "吾不如老圃。"
            },
            "14": {
                "1": "樊遲出。",
                "2": "子曰。",
                "3": "小人哉。",
                "4": "樊須也。",
                "5": "上好禮。",
                "6": "則民莫敢不敬。",
                "7": "上好義。",
                "8": "則民莫敢不服。",
                "9": "上好信。",
                "10": "則民莫敢不用情。",
                "11": "夫如是。",
                "12": "則四方之民襁負其子而至矣。",
                "13": "焉用稼。"
            }
        },
        "5": {
            "16": {
                "1": "子曰。",
                "2": "誦詩三百。",
                "3": "授之以政。",
                "4": "不達。",
                "5": "使於四方。",
                "6": "不能專對。",
                "7": "雖多。",
                "8": "亦奚以爲。"
            }
        },
        "6": {
            "18": {
                "1": "子曰。",
                "2": "其身正。",
                "3": "不令而行。",
                "4": "其身不正。",
                "5": "雖令不從。"
            }
        },
        "7": {
            "20": {
                "1": "子曰。",
                "2": "魯衞之政。",
                "3": "兄弟也。"
            }
        },
        "8": {
            "22": {
                "1": "子謂衞公子荊。",
                "2": "善居室。",
                "3": "始有。",
                "4": "曰。",
                "5": "苟合矣。",
                "6": "少有。",
                "7": "曰。",
                "8": "苟完矣。",
                "9": "富有。",
                "10": "曰。",
                "11": "苟美矣。"
            }
        },
        "9": {
            "24": {
                "1": "子適衞。",
                "2": "冉有僕。",
                "3": "子曰。",
                "4": "庶矣哉。"
            },
            "25": {
                "1": "冉有曰。",
                "2": "旣庶矣。",
                "3": "又何加焉。",
                "4": "曰。",
                "5": "富之。"
            },
            "26": {
                "1": "曰。",
                "2": "旣富矣。",
                "3": "又何加焉。",
                "4": "曰。",
                "5": "教之。"
            }
        },
        "10": {
            "28": {
                "1": "子曰。",
                "2": "苟有用我者。",
                "3": "期月而已可也。",
                "4": "三年有成。"
            }
        },
        "11": {
            "30": {
                "1": "子曰。",
                "2": "善人爲邦百年。",
                "3": "亦可以勝殘去殺矣。",
                "4": "誠哉是言也。"
            }
        },
        "12": {
            "32": {
                "1": "子曰。",
                "2": "如有王者。",
                "3": "必世而後仁。"
            }
        },
        "13": {
            "34": {
                "1": "子曰。",
                "2": "苟正其身矣。",
                "3": "於從政乎何有。",
                "4": "不能正其身。",
                "5": "如正人何。"
            }
        },
        "14": {
            "36": {
                "1": "冉子退朝。",
                "2": "子曰。",
                "3": "何晏也。",
                "4": "對曰。",
                "5": "有政。",
                "6": "子曰。",
                "7": "其事也。",
                "8": "如有政。",
                "9": "雖不吾以。",
                "10": "吾其與聞之。"
            }
        },
        "15": {
            "38": {
                "1": "定公問。",
                "2": "一言而可以興邦。",
                "3": "有諸。"
            },
            "39": {
                "1": "孔子對曰。",
                "2": "言不可以若是其幾也。",
                "3": "人之言曰。",
                "4": "爲君難。",
                "5": "爲臣不易。",
                "6": "如知爲君之難也。",
                "7": "不幾乎一言而興邦乎。"
            },
            "40": {
                "1": "曰。",
                "2": "一言而喪邦。",
                "3": "有諸。"
            },
            "41": {
                "1": "孔子對曰。",
                "2": "言不可以若是其幾也。",
                "3": "人之言曰。",
                "4": "予無樂乎爲君。",
                "5": "唯其言而莫予違也。",
                "6": "如其善而莫之違也。",
                "7": "不亦善乎。",
                "8": "如不善而莫之違也。",
                "9": "不幾乎一言而喪邦乎。"
            }
        },
        "16": {
            "43": {
                "1": "葉公問政。",
                "2": "子曰。",
                "3": "近者說。",
                "4": "遠者來。"
            }
        },
        "17": {
            "45": {
                "1": "子夏爲莒父宰。",
                "2": "問政。",
                "3": "子曰。",
                "4": "無欲速。",
                "5": "無見小利。",
                "6": "欲速則不達。",
                "7": "見小利則大事不成。"
            }
        },
        "18": {
            "47": {
                "1": "葉公語孔子曰。",
                "2": "吾黨有直躬者。",
                "3": "其父攘羊。",
                "4": "而子證之。",
                "5": "孔子曰。",
                "6": "吾黨之直者異於是。",
                "7": "父爲子隱。",
                "8": "子爲父隱。",
                "9": "直在其中矣。"
            }
        },
        "19": {
            "49": {
                "1": "樊遲問仁。",
                "2": "子曰。",
                "3": "居處恭。",
                "4": "執事敬。",
                "5": "與人忠。",
                "6": "雖之夷狄。",
                "7": "不可棄也。"
            }
        },
        "20": {
            "51": {
                "1": "子貢問曰。",
                "2": "何如斯可謂之士矣。",
                "3": "子曰。",
                "4": "行己有恥。",
                "5": "使於四方。",
                "6": "不辱君命。",
                "7": "可謂士矣。"
            },
            "52": {
                "1": "曰。",
                "2": "敢問其次。",
                "3": "曰。",
                "4": "宗族稱孝焉。",
                "5": "鄕黨稱弟焉。"
            },
            "53": {
                "1": "曰。",
                "2": "敢問其次。",
                "3": "曰。",
                "4": "言必信。",
                "5": "行必果。",
                "6": "硜硜然小人哉。",
                "7": "抑亦可以爲次矣。"
            },
            "54": {
                "1": "曰。",
                "2": "今之從政者何如。",
                "3": "子曰。",
                "4": "噫。",
                "5": "斗筲之人。",
                "6": "何足算也？。"
            }
        },
        "21": {
            "56": {
                "1": "子曰。",
                "2": "不得中行而與之。",
                "3": "必也狂。",
                "4": "狷乎。",
                "5": "狂者進取。",
                "6": "狷者有所不爲也。"
            }
        },
        "22": {
            "58": {
                "1": "子曰。",
                "2": "南人有言曰。",
                "3": "人而無恆。",
                "4": "不可以作巫醫。",
                "5": "善夫。"
            },
            "59": {
                "1": "不恆其德。",
                "2": "或承之羞。",
                "3": "子曰。",
                "4": "不占而已矣。"
            }
        },
        "23": {
            "61": {
                "1": "子曰。",
                "2": "君子和而不同。",
                "3": "小人同而不和。"
            }
        },
        "24": {
            "63": {
                "1": "子貢問曰。",
                "2": "鄕人皆好之。",
                "3": "何如。",
                "4": "子曰。",
                "5": "未可也。"
            },
            "64": {
                "1": "鄕人皆惡之。",
                "2": "何如。",
                "3": "子曰。",
                "4": "未可也。",
                "5": "不如鄕人之善者好之。",
                "6": "其不善者惡之。"
            }
        },
        "25": {
            "66": {
                "1": "子曰。",
                "2": "君子易事而難說也。",
                "3": "說之不以道。",
                "4": "不說也。",
                "5": "及其使人也。",
                "6": "器之。",
                "7": "小人難事而易說也。",
                "8": "說之雖不以道。",
                "9": "說也。",
                "10": "及其使人也。",
                "11": "求備焉。"
            }
        },
        "26": {
            "68": {
                "1": "子曰。",
                "2": "君子泰而不驕。",
                "3": "小人驕而不泰。"
            }
        },
        "27": {
            "70": {
                "1": "子曰。",
                "2": "剛、毅。",
                "3": "木、訥近仁。"
            }
        },
        "28": {
            "72": {
                "1": "子路問曰。",
                "2": "何如斯可謂之士矣。",
                "3": "子曰。",
                "4": "切切偲偲。",
                "5": "怡怡如也。",
                "6": "可謂士矣。",
                "7": "朋友切切偲偲。",
                "8": "兄弟怡怡。"
            }
        },
        "29": {
            "74": {
                "1": "子曰。",
                "2": "善人教民七年。",
                "3": "亦可以卽戎矣。"
            }
        },
        "30": {
            "76": {
                "1": "子曰。",
                "2": "以不教民戰。",
                "3": "是謂棄之。"
            }
        }
    }
}