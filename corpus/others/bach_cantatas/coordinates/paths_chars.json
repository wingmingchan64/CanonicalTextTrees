{
    "BACH_CANTATAS,140_DE,篇名": "BWV 140 - \"Wachet auf, ruft uns die Stimme\"",
    "BACH_CANTATAS,140_DE,1,3": "1. Choral",
    "BACH_CANTATAS,140_DE,1,4": "Wachet auf, ruft uns die Stimme,",
    "BACH_CANTATAS,140_DE,1,5": "der Wächter sehr hoch auf der Zinne,",
    "BACH_CANTATAS,140_DE,1,6": "wach auf, du Stadt Jerusalem!",
    "BACH_CANTATAS,140_DE,1,7": "Mitternacht heißt diese Stunde,",
    "BACH_CANTATAS,140_DE,1,8": "sie rufen uns mit hellem Munde,",
    "BACH_CANTATAS,140_DE,1,9": "wo seid ihr klugen Jungfrauen?",
    "BACH_CANTATAS,140_DE,1,10": "Wohl auf, der Bräut’gam kömmt,",
    "BACH_CANTATAS,140_DE,1,11": "steht auf, die Lampen nehmt,",
    "BACH_CANTATAS,140_DE,1,12": "Alleluia!",
    "BACH_CANTATAS,140_DE,1,13": "Macht euch bereit",
    "BACH_CANTATAS,140_DE,1,14": "zu der Hochzeit,",
    "BACH_CANTATAS,140_DE,1,15": "ihr müsset ihm entgegen gehn.",
    "BACH_CANTATAS,140_DE,2,17": "2. Rezitativ T",
    "BACH_CANTATAS,140_DE,2,18": "Er kommt, er kommt,",
    "BACH_CANTATAS,140_DE,2,19": "der Bräut’gam kommt,",
    "BACH_CANTATAS,140_DE,2,20": "ihr Töchter Zions, kommt heraus,",
    "BACH_CANTATAS,140_DE,2,21": "Sein Ausgang eilet aus der Höhe",
    "BACH_CANTATAS,140_DE,2,22": "in euer Mutter Haus.",
    "BACH_CANTATAS,140_DE,2,23": "Der Bräut’gam kommt, der einen Rehe",
    "BACH_CANTATAS,140_DE,2,24": "und jungen Hirschen gleich",
    "BACH_CANTATAS,140_DE,2,25": "auf denen Hügeln springt",
    "BACH_CANTATAS,140_DE,2,26": "und euch das Mahl der Hochzeit bringt.",
    "BACH_CANTATAS,140_DE,2,27": "Wacht auf, ermuntert euch,",
    "BACH_CANTATAS,140_DE,2,28": "den Bräut’gam zu empfangen;",
    "BACH_CANTATAS,140_DE,2,29": "dort, sehet, kommt er hergegangen.",
    "BACH_CANTATAS,140_DE,3,31": "3. Arie- Duett S B (Dialog - Seele, Jesus)",
    "BACH_CANTATAS,140_DE,3,32": "Wenn kömmst du, mein Heil?",
    "BACH_CANTATAS,140_DE,3,33": "- Ich komme, dein Teil. -",
    "BACH_CANTATAS,140_DE,3,34": "Ich warte mit brennenden Öle.",
    "BACH_CANTATAS,140_DE,3,35": "Eröffne den Saal",
    "BACH_CANTATAS,140_DE,3,36": "- Ich öffne den Saal -",
    "BACH_CANTATAS,140_DE,3,37": "zum himmlischen Mahl.",
    "BACH_CANTATAS,140_DE,3,38": "Komm, Jesu.",
    "BACH_CANTATAS,140_DE,3,39": "- Ich komme, komm, liebliche Seele. -",
    "BACH_CANTATAS,140_DE,4,41": "4. Choral T",
    "BACH_CANTATAS,140_DE,4,42": "Zion hört die Wächter singen,",
    "BACH_CANTATAS,140_DE,4,43": "das Herz tut ihr vor Freuden springen,",
    "BACH_CANTATAS,140_DE,4,44": "sie wachet und steht eilend auf.",
    "BACH_CANTATAS,140_DE,4,45": "Ihr Freund kommt von Himmel prächtig,",
    "BACH_CANTATAS,140_DE,4,46": "von Gnaden stark, von Wahrheit mächtig,",
    "BACH_CANTATAS,140_DE,4,47": "ihr Licht wird hell, ihr Stern geht auf.",
    "BACH_CANTATAS,140_DE,4,48": "Nun komm, du werte Kron’,",
    "BACH_CANTATAS,140_DE,4,49": "Herr Jesu, Gottes Sohn,",
    "BACH_CANTATAS,140_DE,4,50": "Hosianna!",
    "BACH_CANTATAS,140_DE,4,51": "Wir folgen all",
    "BACH_CANTATAS,140_DE,4,52": "zum Freudensaal",
    "BACH_CANTATAS,140_DE,4,53": "und halten mit das Abendmahl.",
    "BACH_CANTATAS,140_DE,5,55": "5. Rezitativ B",
    "BACH_CANTATAS,140_DE,5,56": "So geh herein zu mir,",
    "BACH_CANTATAS,140_DE,5,57": "du mir erwählte Braut!",
    "BACH_CANTATAS,140_DE,5,58": "Ich habe mich mit dir",
    "BACH_CANTATAS,140_DE,5,59": "von Ewigkeit vertraut.",
    "BACH_CANTATAS,140_DE,5,60": "Dich will ich auf mein Herz,",
    "BACH_CANTATAS,140_DE,5,61": "auf meinen Arm gleich wie ein Sigel setzen,",
    "BACH_CANTATAS,140_DE,5,62": "und dein betrübtes Aug’ ergötzen.",
    "BACH_CANTATAS,140_DE,5,63": "Vergiß, o Seele, nun",
    "BACH_CANTATAS,140_DE,5,64": "die Angst, den Schmerz,",
    "BACH_CANTATAS,140_DE,5,65": "den du erdulden müssen;",
    "BACH_CANTATAS,140_DE,5,66": "auf meiner Linken sollst du ruhn,",
    "BACH_CANTATAS,140_DE,5,67": "und meine Rechte soll dich küssen.",
    "BACH_CANTATAS,140_DE,6,69": "6. Arie - Duett S B (Dialog - Seele, Jesus)",
    "BACH_CANTATAS,140_DE,6,70": "Mein Freund ist mein,",
    "BACH_CANTATAS,140_DE,6,71": "-und ich bin sein,-",
    "BACH_CANTATAS,140_DE,6,72": "die Liebe soll nichts scheiden.",
    "BACH_CANTATAS,140_DE,6,73": "Ich will mit dir",
    "BACH_CANTATAS,140_DE,6,74": "-du sollst mit mir",
    "BACH_CANTATAS,140_DE,6,75": "im Himmels Rosen weiden,",
    "BACH_CANTATAS,140_DE,6,76": "da Freude die Fülle, da Wonne wird sein.",
    "BACH_CANTATAS,140_DE,7,78": "7. Choral",
    "BACH_CANTATAS,140_DE,7,79": "Gloria sei dir gesungen,",
    "BACH_CANTATAS,140_DE,7,80": "mit Menschen- und englischen Zungen,",
    "BACH_CANTATAS,140_DE,7,81": "mit Harfen und mit Zimbeln schon.",
    "BACH_CANTATAS,140_DE,7,82": "Von zwölf Perlen sind die Pforten,",
    "BACH_CANTATAS,140_DE,7,83": "an deiner Stadt sind wir Konsorten",
    "BACH_CANTATAS,140_DE,7,84": "der Engel hoch um deine Thron.",
    "BACH_CANTATAS,140_DE,7,85": "Kein Aug’ hat je gespürt,",
    "BACH_CANTATAS,140_DE,7,86": "kein Ohr hat je gehört",
    "BACH_CANTATAS,140_DE,7,87": "solche Freude,",
    "BACH_CANTATAS,140_DE,7,88": "des sind wir froh,",
    "BACH_CANTATAS,140_DE,7,89": "io, io,",
    "BACH_CANTATAS,140_DE,7,90": "ewig in dulci jubilo.",
    "BACH_CANTATAS,140_EN1,篇名": "BWV 140 - Awake, calls the voice to us",
    "BACH_CANTATAS,140_EN1,1,3": "1. Chorus",
    "BACH_CANTATAS,140_EN1,1,4": "Awake, calls the voice to us",
    "BACH_CANTATAS,140_EN1,1,5": "of the watchmen high up in the tower;",
    "BACH_CANTATAS,140_EN1,1,6": "awake, you city of Jerusalem.",
    "BACH_CANTATAS,140_EN1,1,7": "Midnight the hour is named;",
    "BACH_CANTATAS,140_EN1,1,8": "they call to us with bright voices;",
    "BACH_CANTATAS,140_EN1,1,9": "where are you, wise virgins?",
    "BACH_CANTATAS,140_EN1,1,10": "Indeed, the Bridegroom comes;",
    "BACH_CANTATAS,140_EN1,1,11": "rise up and take your lamps,",
    "BACH_CANTATAS,140_EN1,1,12": "Alleluia!",
    "BACH_CANTATAS,140_EN1,1,13": "Make yourselves ready",
    "BACH_CANTATAS,140_EN1,1,14": "for the wedding,",
    "BACH_CANTATAS,140_EN1,1,15": "you must go to meet him.",
    "BACH_CANTATAS,140_EN1,2,17": "2. Recitative T",
    "BACH_CANTATAS,140_EN1,2,18": "He comes, he comes,",
    "BACH_CANTATAS,140_EN1,2,19": "the Bridegroom comes,",
    "BACH_CANTATAS,140_EN1,2,20": "O daughters of Zion, come out,",
    "BACH_CANTATAS,140_EN1,2,21": "his course runs from the heights",
    "BACH_CANTATAS,140_EN1,2,22": "into your mother's house.",
    "BACH_CANTATAS,140_EN1,2,23": "The Bridegroom comes, who like a roe",
    "BACH_CANTATAS,140_EN1,2,24": "and young stag",
    "BACH_CANTATAS,140_EN1,2,25": "leaps upon the hills;",
    "BACH_CANTATAS,140_EN1,2,26": "to you he brings the wedding feast.",
    "BACH_CANTATAS,140_EN1,2,27": "Rise up, take heart,",
    "BACH_CANTATAS,140_EN1,2,28": "to embrace the bridegroom;",
    "BACH_CANTATAS,140_EN1,2,29": "there, look, he comes this way.",
    "BACH_CANTATAS,140_EN1,3,31": "3. Aria - Duet S B (Dialogue - Soul, Jesus)",
    "BACH_CANTATAS,140_EN1,3,32": "When will you come, my Savior?",
    "BACH_CANTATAS,140_EN1,3,33": "– I come, as your portion. –",
    "BACH_CANTATAS,140_EN1,3,34": "I wait with burning oil.",
    "BACH_CANTATAS,140_EN1,3,35": "Now open the hall",
    "BACH_CANTATAS,140_EN1,3,36": "– I open the hall –",
    "BACH_CANTATAS,140_EN1,3,37": "for the heavenly meal.",
    "BACH_CANTATAS,140_EN1,3,38": "Come, Jesus!",
    "BACH_CANTATAS,140_EN1,3,39": "– I come, come, beloved soul! –",
    "BACH_CANTATAS,140_EN1,4,41": "4. Chorale T",
    "BACH_CANTATAS,140_EN1,4,42": "Zion hears the watchmen sing,",
    "BACH_CANTATAS,140_EN1,4,43": "her heart leaps for joy within her,",
    "BACH_CANTATAS,140_EN1,4,44": "she wakens and hastily arises.",
    "BACH_CANTATAS,140_EN1,4,45": "Her glorious beloved comes from heaven,",
    "BACH_CANTATAS,140_EN1,4,46": "strong in mercy, powerful in truth,",
    "BACH_CANTATAS,140_EN1,4,47": "her light becomes bright, her star rises.",
    "BACH_CANTATAS,140_EN1,4,48": "Now come, precious crown,",
    "BACH_CANTATAS,140_EN1,4,49": "Lord Jesus, the Son of God!",
    "BACH_CANTATAS,140_EN1,4,50": "Hosannah!",
    "BACH_CANTATAS,140_EN1,4,51": "We all follow",
    "BACH_CANTATAS,140_EN1,4,52": "to the hall of joy",
    "BACH_CANTATAS,140_EN1,4,53": "and hold the evening meal together.",
    "BACH_CANTATAS,140_EN1,5,55": "5. Recitative B",
    "BACH_CANTATAS,140_EN1,5,56": "So come in to me,",
    "BACH_CANTATAS,140_EN1,5,57": "you my chosen bride!",
    "BACH_CANTATAS,140_EN1,5,58": "I have to you",
    "BACH_CANTATAS,140_EN1,5,59": "eternally betrothed myself.",
    "BACH_CANTATAS,140_EN1,5,60": "I will set you upon my heart,",
    "BACH_CANTATAS,140_EN1,5,61": "upon my arm as a seal,",
    "BACH_CANTATAS,140_EN1,5,62": "and delight your troubled eye.",
    "BACH_CANTATAS,140_EN1,5,63": "Forget, O soul, now",
    "BACH_CANTATAS,140_EN1,5,64": "the fear, the pain",
    "BACH_CANTATAS,140_EN1,5,65": "which you have had to suffer;",
    "BACH_CANTATAS,140_EN1,5,66": "upon my left hand you shall rest,",
    "BACH_CANTATAS,140_EN1,5,67": "and my right hand shall kiss you.",
    "BACH_CANTATAS,140_EN1,6,69": "6. Aria - Duet S B (Dialogue - Soul, Jesus)",
    "BACH_CANTATAS,140_EN1,6,70": "My friend is mine,",
    "BACH_CANTATAS,140_EN1,6,71": "– and I am yours, –",
    "BACH_CANTATAS,140_EN1,6,72": "love will never part us.",
    "BACH_CANTATAS,140_EN1,6,73": "I will with you",
    "BACH_CANTATAS,140_EN1,6,74": "– you will with me –",
    "BACH_CANTATAS,140_EN1,6,75": "graze among heaven’s roses,",
    "BACH_CANTATAS,140_EN1,6,76": "where complete pleasure and delight will be.",
    "BACH_CANTATAS,140_EN1,7,78": "7. Chorale",
    "BACH_CANTATAS,140_EN1,7,79": "Let Gloria be sung to you",
    "BACH_CANTATAS,140_EN1,7,80": "with mortal and angelic tongues,",
    "BACH_CANTATAS,140_EN1,7,81": "with harps and even with cymbals.",
    "BACH_CANTATAS,140_EN1,7,82": "Of twelve pearls the portals are made,",
    "BACH_CANTATAS,140_EN1,7,83": "In your city we are companions",
    "BACH_CANTATAS,140_EN1,7,84": "Of the angels high around your throne.",
    "BACH_CANTATAS,140_EN1,7,85": "No eye has ever perceived,",
    "BACH_CANTATAS,140_EN1,7,86": "no ear has ever heard",
    "BACH_CANTATAS,140_EN1,7,87": "such joy",
    "BACH_CANTATAS,140_EN1,7,88": "as our happiness,",
    "BACH_CANTATAS,140_EN1,7,89": "io, io,",
    "BACH_CANTATAS,140_EN1,7,90": "eternally in dulci jubilo!",
    "BACH_CANTATAS,140_FR1,篇名": "BWV 140 - Réveillez-vous, la voix nous appelle",
    "BACH_CANTATAS,140_FR1,1,3": "1. Chœur",
    "BACH_CANTATAS,140_FR1,1,4": "Réveillez-vous, la voix nous appelle",
    "BACH_CANTATAS,140_FR1,1,5": "Celle du veilleur en haut du rempart,",
    "BACH_CANTATAS,140_FR1,1,6": "Réveille-toi, cité de Jérusalem !",
    "BACH_CANTATAS,140_FR1,1,7": "Cette heure est appelée minuit ;",
    "BACH_CANTATAS,140_FR1,1,8": "Ils nous appellent d'une voix claire :",
    "BACH_CANTATAS,140_FR1,1,9": "Où êtes-vous sages vierges ?",
    "BACH_CANTATAS,140_FR1,1,10": "debout, le fiancé arrive ;",
    "BACH_CANTATAS,140_FR1,1,11": "Levez-vous et prenez vos lampes ;",
    "BACH_CANTATAS,140_FR1,1,12": "Alléluia !",
    "BACH_CANTATAS,140_FR1,1,13": "Préparez-vous",
    "BACH_CANTATAS,140_FR1,1,14": "Pour les noces,",
    "BACH_CANTATAS,140_FR1,1,15": "Vous devez aller à sa rencontre.",
    "BACH_CANTATAS,140_FR1,2,17": "2. Récitatif",
    "BACH_CANTATAS,140_FR1,2,18": "Il arrive, il arrive,",
    "BACH_CANTATAS,140_FR1,2,19": "Le fiancé arrive !",
    "BACH_CANTATAS,140_FR1,2,20": "O filles de Sion, venez dehors,",
    "BACH_CANTATAS,140_FR1,2,21": "Il hâte son départ d'en haut",
    "BACH_CANTATAS,140_FR1,2,22": "Versqui comme un la maison de votre mère.",
    "BACH_CANTATAS,140_FR1,2,23": "Le fiancé arrive, comme un chevreuil",
    "BACH_CANTATAS,140_FR1,2,24": "Et un jeune cerf",
    "BACH_CANTATAS,140_FR1,2,25": "Saute sur les collines",
    "BACH_CANTATAS,140_FR1,2,26": "Et vous apporte la fête du mariage.",
    "BACH_CANTATAS,140_FR1,2,27": "Réveillez-vous, levez-vous",
    "BACH_CANTATAS,140_FR1,2,28": "Pour embrasser le fiancé ;",
    "BACH_CANTATAS,140_FR1,2,29": "Là, regardez, il arrive par ici.",
    "BACH_CANTATAS,140_FR1,3,31": "3. Air (Duetto)",
    "BACH_CANTATAS,140_FR1,3,32": "Quand viens-tu, mon sauveur ?",
    "BACH_CANTATAS,140_FR1,3,33": "J'arrive, comme ta partie.",
    "BACH_CANTATAS,140_FR1,3,34": "J'attends avec l'huile brûlante.",
    "BACH_CANTATAS,140_FR1,3,35": "{Ouvre, J'ouvre}",
    "BACH_CANTATAS,140_FR1,3,36": "la salle",
    "BACH_CANTATAS,140_FR1,3,37": "Pour le repas céleste",
    "BACH_CANTATAS,140_FR1,3,38": "Viens, Jésus !",
    "BACH_CANTATAS,140_FR1,3,39": "Viens, âme délicieuse !",
    "BACH_CANTATAS,140_FR1,4,41": "4. Choral",
    "BACH_CANTATAS,140_FR1,4,42": "Sion entend le veilleur chanter,",
    "BACH_CANTATAS,140_FR1,4,43": "Son cœur saute de joie en elle,",
    "BACH_CANTATAS,140_FR1,4,44": "Elle s'éveille et se lève en hâte.",
    "BACH_CANTATAS,140_FR1,4,45": "Son ami arrive du ciel dans sa slendeur,",
    "BACH_CANTATAS,140_FR1,4,46": "Fort de miséricorde, puissant de vérité,",
    "BACH_CANTATAS,140_FR1,4,47": "Sa lumière devient brillante, son étoile se lève.",
    "BACH_CANTATAS,140_FR1,4,48": "Viens maintenant, précieuse couronne,",
    "BACH_CANTATAS,140_FR1,4,49": "Seigneur Jésus, fils de Dieu !",
    "BACH_CANTATAS,140_FR1,4,50": "Hosanna !",
    "BACH_CANTATAS,140_FR1,4,51": "Nous suivons tous",
    "BACH_CANTATAS,140_FR1,4,52": "Jusqu'à la salle de joie",
    "BACH_CANTATAS,140_FR1,4,53": "Et partageons le repas du soir.",
    "BACH_CANTATAS,140_FR1,5,55": "5. Récitatif",
    "BACH_CANTATAS,140_FR1,5,56": "Aussi viens en moi,",
    "BACH_CANTATAS,140_FR1,5,57": "Toi, la fiancée que j'ai choisie pour moi !",
    "BACH_CANTATAS,140_FR1,5,58": "Avec toi je me suis",
    "BACH_CANTATAS,140_FR1,5,59": "Fiancé pour toujours.",
    "BACH_CANTATAS,140_FR1,5,60": "Je te poserai sur mon cœur",
    "BACH_CANTATAS,140_FR1,5,61": "Sur mon bras comme un sceau",
    "BACH_CANTATAS,140_FR1,5,62": "Et pour réjouir tes yeux chagrinés.",
    "BACH_CANTATAS,140_FR1,5,63": "Oublie maintenant, ô âme,",
    "BACH_CANTATAS,140_FR1,5,64": "L'angoisse, le chagrin,",
    "BACH_CANTATAS,140_FR1,5,65": "Que tu as dû endurer ;",
    "BACH_CANTATAS,140_FR1,5,66": "Sur ma main gauche tu dois reposer",
    "BACH_CANTATAS,140_FR1,5,67": "Et ma main droite veut t'embrasser.",
    "BACH_CANTATAS,140_FR1,6,69": "6. Air (Duetto)",
    "BACH_CANTATAS,140_FR1,6,70": "Mon ami est mien,",
    "BACH_CANTATAS,140_FR1,6,71": "Et je suis le tien,",
    "BACH_CANTATAS,140_FR1,6,72": "Rien ne séparera notre amour.",
    "BACH_CANTATAS,140_FR1,6,73": "Je veux paître",
    "BACH_CANTATAS,140_FR1,6,74": "Tu veux paître",
    "BACH_CANTATAS,140_FR1,6,75": "sur les roses du ciel avec {toi, moi},",
    "BACH_CANTATAS,140_FR1,6,76": "Il y aura plein de joie, il y aura du bonheur.",
    "BACH_CANTATAS,140_FR1,7,78": "7. Choral",
    "BACH_CANTATAS,140_FR1,7,79": "Que Gloria soit chanté pour toi",
    "BACH_CANTATAS,140_FR1,7,80": "Avec des langues mortelles et des langues angéliques,",
    "BACH_CANTATAS,140_FR1,7,81": "Avec des harpes et mêmes des cymbales.",
    "BACH_CANTATAS,140_FR1,7,82": "De douze perles sont faites les portes,",
    "BACH_CANTATAS,140_FR1,7,83": "Dans ta ville nous sommes compagnons",
    "BACH_CANTATAS,140_FR1,7,84": "Des anges autour de ton trône.",
    "BACH_CANTATAS,140_FR1,7,85": "Aucun œil n'a jamais perçu,",
    "BACH_CANTATAS,140_FR1,7,86": "Aucune oreille n'a jamais entendu",
    "BACH_CANTATAS,140_FR1,7,87": "Une telle joie.",
    "BACH_CANTATAS,140_FR1,7,88": "Donc nous sommes joyeux,",
    "BACH_CANTATAS,140_FR1,7,89": "Hourra, hourra !",
    "BACH_CANTATAS,140_FR1,7,90": "Éternellement in dulci jubilo.",
    "BACH_CANTATAS,140_ZH1,篇名": "BWV 140 - 醒来，声音召唤我们",
    "BACH_CANTATAS,140_ZH1,1,3": "合唱 S A T B",
    "BACH_CANTATAS,140_ZH1,1,4": "醒来，声音召唤我们",
    "BACH_CANTATAS,140_ZH1,1,5": "是城垛高岗上的哨卫，",
    "BACH_CANTATAS,140_ZH1,1,6": "醒来，以色列之城！",
    "BACH_CANTATAS,140_ZH1,1,7": "此刻是午夜；",
    "BACH_CANTATAS,140_ZH1,1,8": "他们清晰的嗓音召唤我们：",
    "BACH_CANTATAS,140_ZH1,1,9": "你们在何处，智慧圣女？",
    "BACH_CANTATAS,140_ZH1,1,10": "起来，新郎来到；",
    "BACH_CANTATAS,140_ZH1,1,11": "起立，带上灯盏！",
    "BACH_CANTATAS,140_ZH1,1,12": "哈利路亚！",
    "BACH_CANTATAS,140_ZH1,1,13": "准备好",
    "BACH_CANTATAS,140_ZH1,1,14": "为了婚礼，",
    "BACH_CANTATAS,140_ZH1,1,15": "你必去会他！",
    "BACH_CANTATAS,140_ZH1,2,17": "宣叙调 T",
    "BACH_CANTATAS,140_ZH1,2,18": "他到来，他到来了，",
    "BACH_CANTATAS,140_ZH1,2,19": "新郎到来了！",
    "BACH_CANTATAS,140_ZH1,2,20": "你们为锡安之女，出来，",
    "BACH_CANTATAS,140_ZH1,2,21": "他匆匆从高处出发",
    "BACH_CANTATAS,140_ZH1,2,22": "赶至你们母亲之所。",
    "BACH_CANTATAS,140_ZH1,2,23": "新郎到来，如动狍",
    "BACH_CANTATAS,140_ZH1,2,24": "又如雄鹿",
    "BACH_CANTATAS,140_ZH1,2,25": "跃动山间",
    "BACH_CANTATAS,140_ZH1,2,26": "为你们带来婚礼盛典。",
    "BACH_CANTATAS,140_ZH1,2,27": "醒来，你们当起！",
    "BACH_CANTATAS,140_ZH1,2,28": "起迎新郎！",
    "BACH_CANTATAS,140_ZH1,2,29": "彼处，看，他从此道来。",
    "BACH_CANTATAS,140_ZH1,3,31": "咏叹调 （二重唱） S （灵魂） B （耶稣）",
    "BACH_CANTATAS,140_ZH1,3,32": "你何时到来，我的救主？",
    "BACH_CANTATAS,140_ZH1,3,33": "我已到，为你的一部分。",
    "BACH_CANTATAS,140_ZH1,3,34": "我点燃（灯）油候君。",
    "BACH_CANTATAS,140_ZH1,3,35": "请敞开大堂。",
    "BACH_CANTATAS,140_ZH1,3,36": "我已敞开大堂。",
    "BACH_CANTATAS,140_ZH1,3,37": "迎向天国盛宴",
    "BACH_CANTATAS,140_ZH1,3,38": "到来，耶稣！",
    "BACH_CANTATAS,140_ZH1,3,39": "到来，可爱灵魂！",
    "BACH_CANTATAS,140_ZH1,4,41": "圣咏 T",
    "BACH_CANTATAS,140_ZH1,4,42": "锡安听闻哨卫歌声，",
    "BACH_CANTATAS,140_ZH1,4,43": "她心欢愉跃动，",
    "BACH_CANTATAS,140_ZH1,4,44": "她醒来匆忙起迎。",
    "BACH_CANTATAS,140_ZH1,4,45": "她的挚友从天国光荣莅临，",
    "BACH_CANTATAS,140_ZH1,4,46": "慈悲满载，真理服人。",
    "BACH_CANTATAS,140_ZH1,4,47": "她的光耀转明，她的主星升起。",
    "BACH_CANTATAS,140_ZH1,4,48": "请到来，尊贵之冠，",
    "BACH_CANTATAS,140_ZH1,4,49": "主耶稣，上帝子！",
    "BACH_CANTATAS,140_ZH1,4,50": "和散那！",
    "BACH_CANTATAS,140_ZH1,4,51": "我等皆跟从",
    "BACH_CANTATAS,140_ZH1,4,52": "至那欢乐之堂",
    "BACH_CANTATAS,140_ZH1,4,53": "分享主的晚宴。",
    "BACH_CANTATAS,140_ZH1,5,55": "宣叙调 B",
    "BACH_CANTATAS,140_ZH1,5,56": "请进驻我，",
    "BACH_CANTATAS,140_ZH1,5,57": "你是我所选的新娘，",
    "BACH_CANTATAS,140_ZH1,5,58": "我已与你许配",
    "BACH_CANTATAS,140_ZH1,5,59": "做永恒约定。",
    "BACH_CANTATAS,140_ZH1,5,60": "我愿意置你于心间，",
    "BACH_CANTATAS,140_ZH1,5,61": "胶合于怀抱",
    "BACH_CANTATAS,140_ZH1,5,62": "取悦你悲伤的眼睛。",
    "BACH_CANTATAS,140_ZH1,5,63": "现在忘掉，啊灵魂，",
    "BACH_CANTATAS,140_ZH1,5,64": "伤痛，悲哀，",
    "BACH_CANTATAS,140_ZH1,5,65": "这些你所曾经受过的；",
    "BACH_CANTATAS,140_ZH1,5,66": "安于我左手，",
    "BACH_CANTATAS,140_ZH1,5,67": "让我右手吻你。",
    "BACH_CANTATAS,140_ZH1,6,69": "咏叹调 （二重唱）S （灵魂） B （耶稣）",
    "BACH_CANTATAS,140_ZH1,6,70": "我友属我，",
    "BACH_CANTATAS,140_ZH1,6,71": "而我也属你，",
    "BACH_CANTATAS,140_ZH1,6,72": "我们的爱不分。",
    "BACH_CANTATAS,140_ZH1,6,73": "我愿与你",
    "BACH_CANTATAS,140_ZH1,6,74": "你将与我",
    "BACH_CANTATAS,140_ZH1,6,75": "共赏天堂玫瑰，",
    "BACH_CANTATAS,140_ZH1,6,76": "此间充满幸福，充满欢愉",
    "BACH_CANTATAS,140_ZH1,7,78": "圣咏 S A T B",
    "BACH_CANTATAS,140_ZH1,7,79": "送你荣耀之歌，",
    "BACH_CANTATAS,140_ZH1,7,80": "以人类和天使之声的演绎，",
    "BACH_CANTATAS,140_ZH1,7,81": "伴以竖琴和钹声。",
    "BACH_CANTATAS,140_ZH1,7,82": "十二珍珠为门，",
    "BACH_CANTATAS,140_ZH1,7,83": "在你城中我们伴随",
    "BACH_CANTATAS,140_ZH1,7,84": "于高处环绕你宝座的天使。",
    "BACH_CANTATAS,140_ZH1,7,85": "前所未见，",
    "BACH_CANTATAS,140_ZH1,7,86": "前所未闻",
    "BACH_CANTATAS,140_ZH1,7,87": "如此极乐。",
    "BACH_CANTATAS,140_ZH1,7,88": "故我们欢悦，",
    "BACH_CANTATAS,140_ZH1,7,89": "io, io！ （欢呼之声）",
    "BACH_CANTATAS,140_ZH1,7,90": "永恒甜美欢畅。"
}