{
    "140_ZH1": {
        "篇名": "BWV 140 - 醒来，声音召唤我们",
        "1": {
            "3": "合唱 S A T B",
            "4": "醒来，声音召唤我们",
            "5": "是城垛高岗上的哨卫，",
            "6": "醒来，以色列之城！",
            "7": "此刻是午夜；",
            "8": "他们清晰的嗓音召唤我们：",
            "9": "你们在何处，智慧圣女？",
            "10": "起来，新郎来到；",
            "11": "起立，带上灯盏！",
            "12": "哈利路亚！",
            "13": "准备好",
            "14": "为了婚礼，",
            "15": "你必去会他！"
        },
        "2": {
            "17": "宣叙调 T",
            "18": "他到来，他到来了，",
            "19": "新郎到来了！",
            "20": "你们为锡安之女，出来，",
            "21": "他匆匆从高处出发",
            "22": "赶至你们母亲之所。",
            "23": "新郎到来，如动狍",
            "24": "又如雄鹿",
            "25": "跃动山间",
            "26": "为你们带来婚礼盛典。",
            "27": "醒来，你们当起！",
            "28": "起迎新郎！",
            "29": "彼处，看，他从此道来。"
        },
        "3": {
            "31": "咏叹调 （二重唱） S （灵魂） B （耶稣）",
            "32": "你何时到来，我的救主？",
            "33": "我已到，为你的一部分。",
            "34": "我点燃（灯）油候君。",
            "35": "请敞开大堂。",
            "36": "我已敞开大堂。",
            "37": "迎向天国盛宴",
            "38": "到来，耶稣！",
            "39": "到来，可爱灵魂！"
        },
        "4": {
            "41": "圣咏 T",
            "42": "锡安听闻哨卫歌声，",
            "43": "她心欢愉跃动，",
            "44": "她醒来匆忙起迎。",
            "45": "她的挚友从天国光荣莅临，",
            "46": "慈悲满载，真理服人。",
            "47": "她的光耀转明，她的主星升起。",
            "48": "请到来，尊贵之冠，",
            "49": "主耶稣，上帝子！",
            "50": "和散那！",
            "51": "我等皆跟从",
            "52": "至那欢乐之堂",
            "53": "分享主的晚宴。"
        },
        "5": {
            "55": "宣叙调 B",
            "56": "请进驻我，",
            "57": "你是我所选的新娘，",
            "58": "我已与你许配",
            "59": "做永恒约定。",
            "60": "我愿意置你于心间，",
            "61": "胶合于怀抱",
            "62": "取悦你悲伤的眼睛。",
            "63": "现在忘掉，啊灵魂，",
            "64": "伤痛，悲哀，",
            "65": "这些你所曾经受过的；",
            "66": "安于我左手，",
            "67": "让我右手吻你。"
        },
        "6": {
            "69": "咏叹调 （二重唱）S （灵魂） B （耶稣）",
            "70": "我友属我，",
            "71": "而我也属你，",
            "72": "我们的爱不分。",
            "73": "我愿与你",
            "74": "你将与我",
            "75": "共赏天堂玫瑰，",
            "76": "此间充满幸福，充满欢愉"
        },
        "7": {
            "78": "圣咏 S A T B",
            "79": "送你荣耀之歌，",
            "80": "以人类和天使之声的演绎，",
            "81": "伴以竖琴和钹声。",
            "82": "十二珍珠为门，",
            "83": "在你城中我们伴随",
            "84": "于高处环绕你宝座的天使。",
            "85": "前所未见，",
            "86": "前所未闻",
            "87": "如此极乐。",
            "88": "故我们欢悦，",
            "89": "io, io！ （欢呼之声）",
            "90": "永恒甜美欢畅。"
        }
    }
}