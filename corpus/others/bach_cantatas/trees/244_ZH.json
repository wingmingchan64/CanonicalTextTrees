{
    "244_ZH": {
        "篇名": "BWV 244 - 馬太受難曲",
        "1": {
            "3": "第一部分"
        },
        "2": {
            "5": "1. 合唱",
            "6": "（錫安的女儿、信眾）",
            "7": "來吧！錫安的女儿們！跟我一起哀歎。",
            "8": "看哪 - 看誰？ - 看新郎。",
            "9": "看他 - 他怎麼了？ - 他像一隻（待宰的）羔羊。",
            "10": "看哪 - 看甚麼？ - 看他怎麼忍受（痛苦）。",
            "11": "看哪 - 看哪兒？ - 看我們（身上）的罪惡。",
            "12": "看他怎樣爲了（對我們的）愛和恩，",
            "13": "自己背負木十字架。",
            "14": "噢，上帝聖潔的羔羊，",
            "15": "在十字架上被屠宰。",
            "16": "一直默默忍受，",
            "17": "不管遭了多少輕蔑。",
            "18": "你背負所有的罪咎，",
            "19": "否則，絕望只屬我們。",
            "20": "耶穌啊！憐憫我們！",
            "21": "(\"O Lamm Gottes unschuldig,\" verse 1)"
        },
        "3": {
            "23": "2. 宣敍調 - 傳道者",
            "24": "耶穌說完了那個，就對門徒說："
        },
        "4": {
            "26": "耶穌",
            "27": "你們都知道，過兩天就是逾越節了，人子將被交出去，要釘在十字架上。"
        },
        "5": {
            "29": "3. 聖詩",
            "30": "親愛的耶穌啊，你犯了甚麼法，",
            "31": "要遭此重判？",
            "32": "你作了甚麼惡？",
            "33": "逮著你甚麼差錯？",
            "34": "(\"Herzliebster Jesu,\" verse 1)"
        },
        "6": {
            "36": "4a.  宣敍調 - 傳道者",
            "37": "那時，祭司長、經學家、民眾中的耆老，聚集在被稱爲該亞法的大祭司的宮殿裏，一起商議如何以詭計捉拿、除掉耶穌。只是大家說："
        },
        "7": {
            "39": "4b. 合唱",
            "40": "不能在節日期間進行，以免引起民間騷亂。"
        },
        "8": {
            "42": "4c.  宣敍調 - 傳道者",
            "43": "耶穌到了伯大尼，住在麻風西門家裏。有個女人提著盛有貴重的香膏的水甁，向他走過來；在他坐在桌旁的那一刻，以香膏澆在他頭上。眾門徒看見了，就很不高興，說道："
        },
        "9": {
            "45": "4d. 合唱",
            "46": "幹嘛這麼浪費？這香膏可賣個好價錢，用來救濟窮人。"
        },
        "10": {
            "48": "4f. 宣敍調 - 傳道者",
            "49": "耶穌聽見了，就跟他們說："
        },
        "11": {
            "51": "4f. 耶穌",
            "52": "爲甚麼要爲難這個女人呢？她爲我做了一件好事。窮人會一直在你們身邊；可是我卻不會長伴著你們。她用香膏澆在我身上，是因爲我將被埋葬。說眞的，將來在普天之下，不管在何處傳福音，人們都會爲了紀念這女人，述說著她（今天）的所作所爲。"
        },
        "12": {
            "54": "5. 宣敍調",
            "55": "你啊，親愛的救主你啊，",
            "56": "若是你的門徒，",
            "57": "只是因爲這善良的女人",
            "58": "要爲你卽將入土的軀體塗香膏",
            "59": "而爭吵不休，",
            "60": "那此時此刻，",
            "61": "請容我淚流成河，",
            "62": "讓淚水傾灑在你頭上。"
        },
        "13": {
            "64": "6. 詠歎調",
            "65": "懺悔與愧疚，",
            "66": "碾碎了我負罪的心，",
            "67": "那請讓我以淚水爲引",
            "68": "化成你喜歡的香膏",
            "69": "獻給你，信實的耶穌。"
        },
        "14": {
            "71": "7. 宣敍調 - 傳道者",
            "72": "接著，十二門徒中一個稱爲加略人猶大的，去求見祭司長，說道："
        },
        "15": {
            "74": "猶大",
            "75": "我把他交給你們，你們給我甚麼報酬？"
        },
        "16": {
            "77": "傳道者",
            "78": "他們給了他三十塊銀元。從那一刻開始，他就不斷尋找出賣耶穌的機會。"
        },
        "17": {
            "80": "8. 詠歎調",
            "81": "充滿愛的心啊，讓鮮血流淌吧！",
            "82": "嗨！你親手拉扯大",
            "83": "吮吸你乳汁成長的孩子，",
            "84": "卻變成一條毒蛇，",
            "85": "威脅殺害養育他的人。"
        },
        "18": {
            "87": "9a. 傳道者",
            "88": "除酵節的頭一天，眾門徒來問耶穌："
        },
        "19": {
            "90": "9b. 合唱",
            "91": "你想讓我們在哪兒準備你逾越節的筵席？"
        },
        "20": {
            "93": "9c. 宣敍調 - 傳道者",
            "94": "他說："
        },
        "21": {
            "96": "耶穌",
            "97": "你們到城裏去，照著某人，跟他說：主讓我們跟你說，他的時辰到了，我要跟我的門徒在你家守逾越節。"
        },
        "22": {
            "99": "傳道者",
            "100": "門徒遵從耶穌的吩咐，籌辦逾越節筵席。到了晚上，耶穌和門徒入席，正吃著，耶穌說："
        },
        "23": {
            "102": "耶穌",
            "103": "我實實在在告訴你們，在你們中間，有個人要背叛我。"
        },
        "24": {
            "105": "9d. 傳道者",
            "106": "他們聽了，變得很憂愁，一個接一個地問耶穌："
        },
        "25": {
            "108": "9e. 合唱",
            "109": "主啊，你是說我嗎？"
        },
        "26": {
            "111": "10. 聖詩",
            "112": "親愛的耶穌啊，你犯了甚麼法，",
            "113": "要遭此重判？",
            "114": "你作了甚麼惡？",
            "115": "逮著你甚麼差錯？",
            "116": "(\"O Welt, sieh heir dein Leben,\" verse 5)"
        },
        "27": []
    }
}