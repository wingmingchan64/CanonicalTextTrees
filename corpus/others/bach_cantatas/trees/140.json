{
    "140": {
        "篇名": "BWV 140 - \"Wachet auf, ruft uns die Stimme\"",
        "1": {
            "3": "1. Choral",
            "4": "Wachet auf, ruft uns die Stimme,",
            "5": "der Wächter sehr hoch auf der Zinne,",
            "6": "wach auf, du Stadt Jerusalem!",
            "7": "Mitternacht heißt diese Stunde,",
            "8": "sie rufen uns mit hellem Munde,",
            "9": "wo seid ihr klugen Jungfrauen?",
            "10": "Wohl auf, der Bräut’gam kömmt,",
            "11": "steht auf, die Lampen nehmt,",
            "12": "Alleluia!",
            "13": "Macht euch bereit",
            "14": "zu der Hochzeit,",
            "15": "ihr müsset ihm entgegen gehn."
        },
        "2": {
            "17": "2. Rezitativ T",
            "18": "Er kommt, er kommt,",
            "19": "der Bräut’gam kommt,",
            "20": "ihr Töchter Zions, kommt heraus,",
            "21": "Sein Ausgang eilet aus der Höhe",
            "22": "in euer Mutter Haus.",
            "23": "Der Bräut’gam kommt, der einen Rehe",
            "24": "und jungen Hirschen gleich",
            "25": "auf denen Hügeln springt",
            "26": "und euch das Mahl der Hochzeit bringt.",
            "27": "Wacht auf, ermuntert euch,",
            "28": "den Bräut’gam zu empfangen;",
            "29": "dort, sehet, kommt er hergegangen."
        },
        "3": {
            "31": "3. Arie- Duett S B (Dialog - Seele, Jesus)",
            "32": "Wenn kömmst du, mein Heil?",
            "33": "- Ich komme, dein Teil. -",
            "34": "Ich warte mit brennenden Öle.",
            "35": "Eröffne den Saal",
            "36": "- Ich öffne den Saal -",
            "37": "zum himmlischen Mahl.",
            "38": "Komm, Jesu.",
            "39": "- Ich komme, komm, liebliche Seele. -"
        },
        "4": {
            "41": "4. Choral T",
            "42": "Zion hört die Wächter singen,",
            "43": "das Herz tut ihr vor Freuden springen,",
            "44": "sie wachet und steht eilend auf.",
            "45": "Ihr Freund kommt von Himmel prächtig,",
            "46": "von Gnaden stark, von Wahrheit mächtig,",
            "47": "ihr Licht wird hell, ihr Stern geht auf.",
            "48": "Nun komm, du werte Kron’,",
            "49": "Herr Jesu, Gottes Sohn,",
            "50": "Hosianna!",
            "51": "Wir folgen all",
            "52": "zum Freudensaal",
            "53": "und halten mit das Abendmahl."
        },
        "5": {
            "55": "5. Rezitativ B",
            "56": "So geh herein zu mir,",
            "57": "du mir erwählte Braut!",
            "58": "Ich habe mich mit dir",
            "59": "von Ewigkeit vertraut.",
            "60": "Dich will ich auf mein Herz,",
            "61": "auf meinen Arm gleich wie ein Sigel setzen,",
            "62": "und dein betrübtes Aug’ ergötzen.",
            "63": "Vergiß, o Seele, nun",
            "64": "die Angst, den Schmerz,",
            "65": "den du erdulden müssen;",
            "66": "auf meiner Linken sollst du ruhn,",
            "67": "und meine Rechte soll dich küssen."
        },
        "6": {
            "69": "6. Arie - Duett S B (Dialog - Seele, Jesus)",
            "70": "Mein Freund ist mein,",
            "71": "-und ich bin sein,-",
            "72": "die Liebe soll nichts scheiden.",
            "73": "Ich will mit dir",
            "74": "-du sollst mit mir",
            "75": "im Himmels Rosen weiden,",
            "76": "da Freude die Fülle, da Wonne wird sein."
        },
        "7": {
            "78": "7. Choral",
            "79": "Gloria sei dir gesungen,",
            "80": "mit Menschen- und englischen Zungen,",
            "81": "mit Harfen und mit Zimbeln schon.",
            "82": "Von zwölf Perlen sind die Pforten,",
            "83": "an deiner Stadt sind wir Konsorten",
            "84": "der Engel hoch um deine Thron.",
            "85": "Kein Aug’ hat je gespürt,",
            "86": "kein Ohr hat je gehört",
            "87": "solche Freude,",
            "88": "des sind wir froh,",
            "89": "io, io,",
            "90": "ewig in dulci jubilo."
        }
    }
}