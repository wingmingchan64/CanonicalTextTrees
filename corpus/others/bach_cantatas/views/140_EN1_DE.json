{
    "140": {
        "篇名": {
            "EN1": "BWV 140 - Awake, calls the voice to us",
            "DE": "BWV 140 - \"Wachet auf, ruft uns die Stimme\""
        },
        "1": {
            "3": {
                "EN1": "1. Chorus",
                "DE": "1. Choral"
            },
            "4": {
                "EN1": "Awake, calls the voice to us",
                "DE": "Wachet auf, ruft uns die Stimme,"
            },
            "5": {
                "EN1": "of the watchmen high up in the tower;",
                "DE": "der Wächter sehr hoch auf der Zinne,"
            },
            "6": {
                "EN1": "awake, you city of Jerusalem.",
                "DE": "wach auf, du Stadt Jerusalem!"
            },
            "7": {
                "EN1": "Midnight the hour is named;",
                "DE": "Mitternacht heißt diese Stunde,"
            },
            "8": {
                "EN1": "they call to us with bright voices;",
                "DE": "sie rufen uns mit hellem Munde,"
            },
            "9": {
                "EN1": "where are you, wise virgins?",
                "DE": "wo seid ihr klugen Jungfrauen?"
            },
            "10": {
                "EN1": "Indeed, the Bridegroom comes;",
                "DE": "Wohl auf, der Bräut’gam kömmt,"
            },
            "11": {
                "EN1": "rise up and take your lamps,",
                "DE": "steht auf, die Lampen nehmt,"
            },
            "12": {
                "EN1": "Alleluia!",
                "DE": "Alleluia!"
            },
            "13": {
                "EN1": "Make yourselves ready",
                "DE": "Macht euch bereit"
            },
            "14": {
                "EN1": "for the wedding,",
                "DE": "zu der Hochzeit,"
            },
            "15": {
                "EN1": "you must go to meet him.",
                "DE": "ihr müsset ihm entgegen gehn."
            }
        },
        "2": {
            "17": {
                "EN1": "2. Recitative T",
                "DE": "2. Rezitativ T"
            },
            "18": {
                "EN1": "He comes, he comes,",
                "DE": "Er kommt, er kommt,"
            },
            "19": {
                "EN1": "the Bridegroom comes,",
                "DE": "der Bräut’gam kommt,"
            },
            "20": {
                "EN1": "O daughters of Zion, come out,",
                "DE": "ihr Töchter Zions, kommt heraus,"
            },
            "21": {
                "EN1": "his course runs from the heights",
                "DE": "Sein Ausgang eilet aus der Höhe"
            },
            "22": {
                "EN1": "into your mother's house.",
                "DE": "in euer Mutter Haus."
            },
            "23": {
                "EN1": "The Bridegroom comes, who like a roe",
                "DE": "Der Bräut’gam kommt, der einen Rehe"
            },
            "24": {
                "EN1": "and young stag",
                "DE": "und jungen Hirschen gleich"
            },
            "25": {
                "EN1": "leaps upon the hills;",
                "DE": "auf denen Hügeln springt"
            },
            "26": {
                "EN1": "to you he brings the wedding feast.",
                "DE": "und euch das Mahl der Hochzeit bringt."
            },
            "27": {
                "EN1": "Rise up, take heart,",
                "DE": "Wacht auf, ermuntert euch,"
            },
            "28": {
                "EN1": "to embrace the bridegroom;",
                "DE": "den Bräut’gam zu empfangen;"
            },
            "29": {
                "EN1": "there, look, he comes this way.",
                "DE": "dort, sehet, kommt er hergegangen."
            }
        },
        "3": {
            "31": {
                "EN1": "3. Aria - Duet S B (Dialogue - Soul, Jesus)",
                "DE": "3. Arie- Duett S B (Dialog - Seele, Jesus)"
            },
            "32": {
                "EN1": "When will you come, my Savior?",
                "DE": "Wenn kömmst du, mein Heil?"
            },
            "33": {
                "EN1": "– I come, as your portion. –",
                "DE": "- Ich komme, dein Teil. -"
            },
            "34": {
                "EN1": "I wait with burning oil.",
                "DE": "Ich warte mit brennenden Öle."
            },
            "35": {
                "EN1": "Now open the hall",
                "DE": "Eröffne den Saal"
            },
            "36": {
                "EN1": "– I open the hall –",
                "DE": "- Ich öffne den Saal -"
            },
            "37": {
                "EN1": "for the heavenly meal.",
                "DE": "zum himmlischen Mahl."
            },
            "38": {
                "EN1": "Come, Jesus!",
                "DE": "Komm, Jesu."
            },
            "39": {
                "EN1": "– I come, come, beloved soul! –",
                "DE": "- Ich komme, komm, liebliche Seele. -"
            }
        },
        "4": {
            "41": {
                "EN1": "4. Chorale T",
                "DE": "4. Choral T"
            },
            "42": {
                "EN1": "Zion hears the watchmen sing,",
                "DE": "Zion hört die Wächter singen,"
            },
            "43": {
                "EN1": "her heart leaps for joy within her,",
                "DE": "das Herz tut ihr vor Freuden springen,"
            },
            "44": {
                "EN1": "she wakens and hastily arises.",
                "DE": "sie wachet und steht eilend auf."
            },
            "45": {
                "EN1": "Her glorious beloved comes from heaven,",
                "DE": "Ihr Freund kommt von Himmel prächtig,"
            },
            "46": {
                "EN1": "strong in mercy, powerful in truth,",
                "DE": "von Gnaden stark, von Wahrheit mächtig,"
            },
            "47": {
                "EN1": "her light becomes bright, her star rises.",
                "DE": "ihr Licht wird hell, ihr Stern geht auf."
            },
            "48": {
                "EN1": "Now come, precious crown,",
                "DE": "Nun komm, du werte Kron’,"
            },
            "49": {
                "EN1": "Lord Jesus, the Son of God!",
                "DE": "Herr Jesu, Gottes Sohn,"
            },
            "50": {
                "EN1": "Hosannah!",
                "DE": "Hosianna!"
            },
            "51": {
                "EN1": "We all follow",
                "DE": "Wir folgen all"
            },
            "52": {
                "EN1": "to the hall of joy",
                "DE": "zum Freudensaal"
            },
            "53": {
                "EN1": "and hold the evening meal together.",
                "DE": "und halten mit das Abendmahl."
            }
        },
        "5": {
            "55": {
                "EN1": "5. Recitative B",
                "DE": "5. Rezitativ B"
            },
            "56": {
                "EN1": "So come in to me,",
                "DE": "So geh herein zu mir,"
            },
            "57": {
                "EN1": "you my chosen bride!",
                "DE": "du mir erwählte Braut!"
            },
            "58": {
                "EN1": "I have to you",
                "DE": "Ich habe mich mit dir"
            },
            "59": {
                "EN1": "eternally betrothed myself.",
                "DE": "von Ewigkeit vertraut."
            },
            "60": {
                "EN1": "I will set you upon my heart,",
                "DE": "Dich will ich auf mein Herz,"
            },
            "61": {
                "EN1": "upon my arm as a seal,",
                "DE": "auf meinen Arm gleich wie ein Sigel setzen,"
            },
            "62": {
                "EN1": "and delight your troubled eye.",
                "DE": "und dein betrübtes Aug’ ergötzen."
            },
            "63": {
                "EN1": "Forget, O soul, now",
                "DE": "Vergiß, o Seele, nun"
            },
            "64": {
                "EN1": "the fear, the pain",
                "DE": "die Angst, den Schmerz,"
            },
            "65": {
                "EN1": "which you have had to suffer;",
                "DE": "den du erdulden müssen;"
            },
            "66": {
                "EN1": "upon my left hand you shall rest,",
                "DE": "auf meiner Linken sollst du ruhn,"
            },
            "67": {
                "EN1": "and my right hand shall kiss you.",
                "DE": "und meine Rechte soll dich küssen."
            }
        },
        "6": {
            "69": {
                "EN1": "6. Aria - Duet S B (Dialogue - Soul, Jesus)",
                "DE": "6. Arie - Duett S B (Dialog - Seele, Jesus)"
            },
            "70": {
                "EN1": "My friend is mine,",
                "DE": "Mein Freund ist mein,"
            },
            "71": {
                "EN1": "– and I am yours, –",
                "DE": "-und ich bin sein,-"
            },
            "72": {
                "EN1": "love will never part us.",
                "DE": "die Liebe soll nichts scheiden."
            },
            "73": {
                "EN1": "I will with you",
                "DE": "Ich will mit dir"
            },
            "74": {
                "EN1": "– you will with me –",
                "DE": "-du sollst mit mir"
            },
            "75": {
                "EN1": "graze among heaven’s roses,",
                "DE": "im Himmels Rosen weiden,"
            },
            "76": {
                "EN1": "where complete pleasure and delight will be.",
                "DE": "da Freude die Fülle, da Wonne wird sein."
            }
        },
        "7": {
            "78": {
                "EN1": "7. Chorale",
                "DE": "7. Choral"
            },
            "79": {
                "EN1": "Let Gloria be sung to you",
                "DE": "Gloria sei dir gesungen,"
            },
            "80": {
                "EN1": "with mortal and angelic tongues,",
                "DE": "mit Menschen- und englischen Zungen,"
            },
            "81": {
                "EN1": "with harps and even with cymbals.",
                "DE": "mit Harfen und mit Zimbeln schon."
            },
            "82": {
                "EN1": "Of twelve pearls the portals are made,",
                "DE": "Von zwölf Perlen sind die Pforten,"
            },
            "83": {
                "EN1": "In your city we are companions",
                "DE": "an deiner Stadt sind wir Konsorten"
            },
            "84": {
                "EN1": "Of the angels high around your throne.",
                "DE": "der Engel hoch um deine Thron."
            },
            "85": {
                "EN1": "No eye has ever perceived,",
                "DE": "Kein Aug’ hat je gespürt,"
            },
            "86": {
                "EN1": "no ear has ever heard",
                "DE": "kein Ohr hat je gehört"
            },
            "87": {
                "EN1": "such joy",
                "DE": "solche Freude,"
            },
            "88": {
                "EN1": "as our happiness,",
                "DE": "des sind wir froh,"
            },
            "89": {
                "EN1": "io, io,",
                "DE": "io, io,"
            },
            "90": {
                "EN1": "eternally in dulci jubilo!",
                "DE": "ewig in dulci jubilo."
            }
        }
    }
}