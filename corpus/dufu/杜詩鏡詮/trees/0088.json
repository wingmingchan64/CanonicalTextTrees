{
    "0088": {
        "篇名": "贈田九判官梁丘",
        "1": {
            "3": "在哥舒翰幕。"
        },
        "2": {
            "5": "從主人說起。"
        },
        "3": {
            "7": "言崆峒地勢之高。"
        },
        "4": {
            "9": "《王師禮傳》：十三載吐谷渾蘇毗王款塞，詔翰至磨環川接應之。仇注：使節西往，而降王入款，見翰能威名遠服也。"
        },
        "5": {
            "11": "承降王。"
        },
        "6": {
            "13": "《漢書》：大宛馬嗜苜蓿，上遣使者持謀祭酒，管記室。仇注：指高適也。"
        },
        "7": {
            "15": "《三輔決錄》：田鳳爲郎，容儀端正。靈帝目送之，題柱曰：堂堂乎張，京兆田郎。"
        },
        "8": {
            "17": "反句。"
        },
        "9": {
            "19": "浦二田云：用事典切，風格高渾，律詩正法眼藏。",
            "20": "◯朱瀚曰：苜蓿嫖姚，亦用疊韻作對。"
        },
        "10": {
            "22": "美",
            "23": "一作入。"
        },
        "11": {
            "25": "===== STABLE BOUNDARY =====",
            "26": "重現名單：0557"
        },
        "12": []
    }
}