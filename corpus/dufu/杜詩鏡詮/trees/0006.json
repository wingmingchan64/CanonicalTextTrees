{
    "0006": {
        "篇名": "與任城許主簿遊南池",
        "1": {
            "3": "《唐書》：任城縣屬兗州。"
        },
        "2": {
            "5": "結借秋意入鄕思。",
            "6": "《世說》：王獻之夜臥齋中，有盜入室。獻之語曰：青氈我家舊物，可特置之。"
        },
        "3": {
            "8": "仇滄柱云：公詩善記節候，此詩晨朝降白露，明日白露節也。《秦州詩》露從今夜白，今日白露節也。"
        },
        "4": {
            "10": "張上若云：寫景甚細。"
        }
    }
}