{
    "0086": {
        "篇名": "驄馬行",
        "1": {
            "3": "原注：太常梁卿敕賜馬也，李鄧公愛而有之，命甫製詩。"
        },
        "2": {
            "5": "二字詩眼。"
        },
        "3": {
            "7": "《晉書》：王濟有馬癖。"
        },
        "4": {
            "9": "精神先從對面託出。"
        },
        "5": {
            "11": "並傳馬之神情。"
        },
        "6": {
            "13": "《西京賦》：隅目高匡。注：隅目謂目有角也。夾鏡注已見。"
        },
        "7": {
            "15": "騣，馬鬣也。《舊唐書》：開元二十九年，滑州刺史李邕獻馬，肉騣麟臆。",
            "16": "《爾雅》：靑驪驎曰驒。注：色有深淺斑駮如魚鱗。今連錢騣也。蔡注：碨礧謂肉騣突起。連錢謂馬文點綴。"
        },
        "8": {
            "18": "補敍來歷含末句。"
        },
        "9": {
            "20": "邵云：用賦語，錘鍊深渾。"
        },
        "10": {
            "22": "《赭白馬賦》：旦刷幽燕，晝秣荊楚。",
            "23": "《說文》：刷，刮也。",
            "24": "張溍注：涇渭二水在西，幽幷二州在北，相去幾千里。晝洗涇渭，夜刷幽幷，言其疾也。"
        },
        "11": {
            "26": "《穆天子傳》：八駿曰赤驥、盜驪、白羲、踰輪、山子、渠黃、驊騮、騄耳。"
        },
        "12": {
            "28": "結處人馬雙關喩奇材必當大用。"
        },
        "13": {
            "30": "《春秋考異記》：地生月精爲馬，月數十二，故馬十二月而生。雲霧晦冥，龍馬降生時也。"
        },
        "14": {
            "32": "朱注：言時方下求馬之詔，此馬必當騰躍天衢，殆以況李鄧公也，。"
        },
        "15": {
            "34": "沈確士云：老杜詠馬詩並皆佳妙，而用意用筆無一處相似，此老胸中具有造化。"
        },
        "16": {
            "36": "寫花驄雄姿，又與驃騎別。"
        },
        "17": {
            "38": "蔣云：愛良馬如美人，爲癖字傳神。"
        },
        "18": {
            "40": "烏罪切。"
        },
        "19": {
            "42": "力罪切。"
        },
        "20": {
            "44": "少"
        },
        "21": {
            "46": "取",
            "47": "之"
        },
        "22": {
            "49": "===== STABLE BOUNDARY =====",
            "50": "重現名單：0608",
            "51": "公,馬,人,得,聞,來,朝,下,此"
        }
    }
}