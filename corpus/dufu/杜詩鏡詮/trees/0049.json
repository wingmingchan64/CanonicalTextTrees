{
    "0049": {
        "篇名": "白絲行",
        "1": {
            "3": "首句乃有激之詞。喩奔競之徒，但希榮進，不須名節也。"
        },
        "2": {
            "5": "烏閑切。"
        },
        "3": {
            "7": "食亦切。"
        },
        "4": {
            "9": "陟略切。"
        },
        "5": {
            "11": "媚人取說之影。"
        },
        "6": {
            "13": "起結無限悲慨。"
        },
        "7": {
            "15": "邵子湘云：得梁陳《樂府》之遺。◯《白絲行》，卽墨子悲素絲意也。歎士人媚時，徒失其身，終歸棄置。故有志者，寧守貧賤也。全首託興，正意只結處一點。"
        },
        "8": {
            "17": "蔣云：寫妙技不覺說入自家話，微乎其微。"
        },
        "9": {
            "19": "慧心香口，直似飛卿，公詩眞無所不有。"
        }
    }
}