    "0042": {
        "詩題": {
            "題": "遊龍門奉先寺",
            "a": {
                "楊": "<p class=\"題解\">龍門卽伊闕。《元和郡縣志》：伊闕山在河南府伊闕縣北，非《禹貢》之龍門。<\/p>"
            }
        },
        "3": {
            "1": {
                "1": "已",
                "2": "從",
                "3": "招",
                "4": "提",
                "5": "遊",
                "p": "。",
                "a": ""
            },
            "2": {
                "1": "更",
                "2": "宿",
                "3": "招",
                "4": "提",
                "5": "境",
                "p": "。",
                "a": ""
            },
            "a": {
                "楊": "<span class=\"旁注\">題是遊詩只寫宿。<\/span><span class=\"注釋\">《僧輝記》：招提者，梵言「拓鬭提奢」，唐言四方僧物，傳筆者訛「拓」爲「招」，去「鬭奢」字。卽今十方住持是也。《唐會要》：官賜額爲寺，私造者爲招提蘭若。<\/span>"
            }
        },
        "4": {
            "1": {
                "1": "陰",
                "2": "壑",
                "3": "生",
                "4": "虛<span class=\"異文\">一作靈。<\/span>",
                "5": "籟<span class=\"注釋\">虛籟謂風也。莊子有天籟、地籟、人籟。<\/span>",
                "p": "。",
                "a": ""
            },
            "2": {
                "1": "月",
                "2": "林",
                "3": "散",
                "4": "清",
                "5": "影",
                "p": "。",
                "a": ""
            },
            "a": ""
        },
        "5": {
            "1": {
                "1": "天",
                "2": "闚<span class=\"異文\">一作闕。<\/span>",
                "3": "象",
                "4": "緯",
                "5": "逼",
                "p": "。",
                "a": ""
            },
            "2": {
                "1": "雲",
                "2": "臥",
                "3": "衣",
                "4": "裳",
                "5": "冷",
                "p": "。",
                "a": ""
            },
            "a": {
                "楊": "<span class=\"注釋\">楊愼曰：天闚雲臥乃倒字法，闚天則星辰垂地，臥雲則空翠濕衣，見山寺高寒殊於人境也。《庚溪詩話》引韋述《東都記》，謂天闕卽指龍門，究於對屬未稱。<\/span>"
            }
        },
        "6": {
            "1": {
                "1": "欲",
                "2": "覺<span class=\"夾注\">古效切。<\/span>",
                "3": "聞",
                "4": "晨",
                "5": "鐘",
                "p": "。",
                "a": ""
            },
            "2": {
                "1": "令",
                "2": "人",
                "3": "發",
                "4": "深",
                "5": "省",
                "p": "。",
                "a": ""
            },
            "a": {
                "楊": "<span class=\"注釋\">王嗣奭曰：人在塵溷中終日碌碌，一當靜境，不覺萬慮皆空。結語具有解悟。<\/span>"
            }
        },
        "a": {
            "楊": "<td class=\"眉批\">李子德云：氣體高妙，澹然自足。<\/td>"
        }
