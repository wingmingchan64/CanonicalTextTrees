{
    "0067": {
        "篇名": "九日曲江",
        "1": {
            "3": "《荊楚歲時記》：茱萸九月九日熟，味辛色赤，摘其房插頭，可辟惡氣。"
        },
        "2": {
            "5": "《爾雅》：荷，芙渠，其花菡萏。"
        },
        "3": {
            "7": "時公年四十餘。"
        },
        "4": {
            "9": "言悲秋兼傷老也。"
        },
        "5": {
            "11": "夢弼曰：曲江以江水屈曲故名。"
        },
        "6": {
            "13": "《九域志》：江陵府龍山上有孟嘉落帽臺，其地在荊門東，言風景似龍山也。"
        },
        "7": {
            "15": "殷仲文詩：獨有淸秋日，能使高興盡。"
        },
        "8": {
            "17": "語淡而悲，律中陶句。"
        }
    }
}