{
    "0015": {
        "篇名": "龍門",
        "1": {
            "3": "前有《遊龍門奉先寺》五古，此當係途次再經作。"
        },
        "2": {
            "5": "邵云：好起。"
        },
        "3": {
            "7": "仇注：《水經注》：禹疏伊水，北流兩山相對，望之若闕。卽所謂橫野斷也。韋應物《龍門遊眺詩》亦云：鑿山導伊流，中斷若天闕。"
        },
        "4": {
            "9": "言山斷處遠望見城邊之樹，舊解俱混。"
        },
        "5": {
            "11": "承二。"
        },
        "6": {
            "13": "承一。"
        },
        "7": {
            "15": "《唐書》：東都皇城，前直伊闕，後據邙山。"
        },
        "8": {
            "17": "舊注：佛地有金色世界，銀色世界。元人《龍門記》：舊有八寺。"
        },
        "9": {
            "19": "歎未知何日方免奔馳也。"
        },
        "10": {
            "21": "上四寫景，下四感懷。"
        }
    }
}