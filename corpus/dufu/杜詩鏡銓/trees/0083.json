{
    "0083": {
        "篇名": "夏日李公〈異文*詩題*一云李家令〉見訪",
        "1": {
            "3": "仇注：《宗室世系考》：蔡王房炎爲太子家令。疑卽此人。"
        },
        "2": {
            "5": "朱注：公居在長安城南，所謂城南韋杜也。"
        },
        "3": {
            "7": "防鳩切。"
        },
        "4": {
            "9": "村居眞率光景如畫。"
        },
        "5": {
            "11": "《古今注》：芙蓉名荷華，一名水花。"
        },
        "6": {
            "13": "張云：了而不了。"
        },
        "7": {
            "15": "景眞語曠，絕似淵明。"
        },
        "8": {
            "17": "巢多六句，總見所居幽靜，卻以一反一正出之，便非恆筆。"
        },
        "9": {
            "19": "淨"
        },
        "10": {
            "21": "===== STABLE BOUNDARY =====",
            "22": "重現名單：0462",
            "23": "過"
        }
    }
}