{
    "0082": {
        "篇名": "戲簡鄭廣文〈題注*詩題*虔〉兼呈蘇司業",
        "1": {
            "3": "源明。《唐書·蘇源明傳》：出爲東平太守，召爲國子司業。"
        },
        "2": {
            "5": "可見並無一事。"
        },
        "3": {
            "7": "邱旣切，一作與。"
        },
        "4": {
            "9": "《朱買臣傳》：吏卒更乞丐之。師古曰：乞讀氣，與也。又《廣韻》：乞，與人也。"
        },
        "5": {
            "11": "蔣云：嬉笑之音，過於慟哭。"
        },
        "6": {
            "13": "才",
            "14": "三"
        },
        "7": {
            "16": "乞"
        },
