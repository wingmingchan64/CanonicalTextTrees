{
    "0103": {
        "篇名": "避地",
        "1": {
            "3": "集外詩，見趙次公本。"
        },
        "2": {
            "5": "孔安國尙書序：及秦滅典籍，我先人用藏其家書於屋壁。言値世亂，詩書將無所用也。"
        },
        "3": {
            "7": "盧注：當時賊黨如田乾眞、蔡希德、崔乾祐之徒，各擁旌旄。舊注謂指朝廷將士，非是。"
        },
        "4": {
            "9": "時肅宗已卽位靈武。"
        },
        "5": {
            "11": "唐高祖稱神堯皇帝。"
        },
        "6": {
            "13": "猶逐也。"
        },
        "7": {
            "15": "腥臊，犬羊也。指祿山。"
        },
        "8": {
            "17": "李云：朴老之氣，一往孤行，遂字、且字，定非公不能下。"
        },
        "9": {
            "19": "===== STABLE BOUNDARY =====",
            "20": "重現名單：0745"
        },
