    "0091": {
        "篇名": "九日楊奉先會白水崔明府",
        "1": {
            "3": "《唐書》：白水縣屬同州。"
        },
        "2": {
            "5": "《晉書·潘岳傳》：岳爲河陽令轉懷令。",
            "6": "《陸雲傳》：以太子舍人出補浚儀令。"
        },
        "3": {
            "8": "《水經注》：河東郡民劉白墮，采挹河流，醞成芳酎，熟於桑落之辰，故酒得其名。庾信《就蒲州使君乞酒》詩：蒲城桑葉落，灞岸菊花秋。蓋桑落正菊開之時也。"
        },
        "4": {
            "10": "言其時。"
        },
        "5": {
            "12": "言其地。"
        },
        "6": {
            "14": "旣切九日，又關合奉先，用事巧切。"
        },
