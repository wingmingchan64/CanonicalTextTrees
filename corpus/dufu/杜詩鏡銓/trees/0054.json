{
    "0054": {
        "篇名": "送韋書記赴安西",
        "1": {
            "3": "《唐書》：元帥節度府有掌書記一人，關預軍中機密。安西注見一卷。"
        },
        "2": {
            "5": "二句言向日。"
        },
        "3": {
            "7": "趙注：謂無所倚藉。"
        },
        "4": {
            "9": "唐制，御史賜金印朱紱，時韋必兼官御史。"
        },
        "5": {
            "11": "二句言當下。"
        },
        "6": {
            "13": "《漢書注》：公車令屬衞尉，上書者所詣。時公方待制集賢。"
        },
        "7": {
            "15": "言知己去而己亦將遯矣。"
        },
        "8": {
            "17": "結語前路茫茫，眞覺黯然涕下。"
        },
        "9": []
    }
}