{
    "0102": {
        "篇名": "三川觀水漲二十韻",
        "1": {
            "3": "舊唐書：三川縣屬鄜州。鶴注：時公自白水之鄜州，道出華原，聞肅宗卽位，遂寄家口於鄜，己欲詣靈武。是年史不書大水，可以補史之闕。"
        },
        "2": {
            "5": "長安志：華原縣屬雍州。"
        },
        "3": {
            "7": "張云：北方山川如此。"
        },
        "4": {
            "9": "連天謂連日。"
        },
        "5": {
            "11": "音灰。"
        },
        "6": {
            "13": "多雨乃水漲之由。◯豗，水相擊。海賦：磊匒匌而相豗。"
        },
        "7": {
            "15": "烏孔切。"
        },
        "8": {
            "17": "口答切。"
        },
        "9": {
            "19": "蓊匌謂水氣蓊鬱而匌匝也。"
        },
        "10": {
            "21": "浦云：色帶山土故黃。連山屈蟠，故會空曲。二句確是山內暴水。"
        },
        "11": {
            "23": "音匐。"
        },
        "12": {
            "25": "去聲。"
        },
        "13": {
            "27": "恐泥借用論語字，廣韻：泥，滯也，陷也。"
        },
        "14": {
            "29": "槎同。"
        },
        "15": {
            "31": "洛罪切。"
        },
        "16": {
            "33": "力罪切。"
        },
        "17": {
            "35": "叶粟。査，水中浮木。礧磈，砂石也。"
        },
        "18": {
            "37": "邵云：警絕寫得駭人。"
        },
        "19": {
            "39": "開筆承上起下。"
        },
        "20": {
            "41": "朱注：謝靈運詩：圻岸屢崩奔。按玉篇：圻，一音魚斤切，與垠同。岸也，界也。《文選》注音祈，恐誤。"
        },
        "21": {
            "43": "《抱朴子》：地有三千六百軸，名山大川，孔穴相連。"
        },
        "22": {
            "45": "《舊唐書》：洛交縣屬鄜州，洛水之交，故名。"
        },
        "23": {
            "47": "關謂潼關也，關在華山之東。"
        },
        "24": {
            "49": "洛水發源鄜州白於山，合漆沮水至同州朝邑縣入河，其勢最大而疾，故有數州沉沒之懼。"
        },
        "25": {
            "51": "按黲當作墋，楚錦切。陸機高祖功臣贊：芒芒宇宙，下墋上黷。注：墋，不澄清貌。黷，媟也。"
        },
        "26": {
            "53": "寓言拯溺無人。"
        },
        "27": {
            "55": "浦二田云：每述一事，必極其情狀，仿像飛動，雕鎪刻深，遂爲昌黎鬥雞石鼎等聯句及宋元以來體物諸詩之祖。"
        },
        "28": {
            "57": "首從山行敍起。"
        },
        "29": {
            "59": "此記山水之漲。"
        },
        "30": {
            "61": "此記川水之漲。"
        },
        "31": {
            "63": "以憫亂意作結，復有舉世淪胥之慨。"
        },
        "32": {
            "65": "===== STABLE BOUNDARY =====",
            "66": "重現名單：0725",
            "67": "不,山,天,窮,雲,無,時,川,氣,清,陰,人,有,萬,何,及,未"
        }
    }
}