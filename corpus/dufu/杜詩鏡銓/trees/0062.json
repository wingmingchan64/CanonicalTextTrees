{
    "0062": {
        "篇名": "醉歌行",
        "1": {
            "3": "原注：別從姪勤落第歸。"
        },
        "2": {
            "5": "臧榮緖《晉書》：機少襲父兵爲牙門將軍，年二十而吳滅，退臨舊里，與弟雲勤學。機妙解情理，心識文體，故作《文賦》。"
        },
        "3": {
            "7": "承綴文。"
        },
        "4": {
            "9": "《益州記》：明月峽、巫山峽、廣谿峽，謂之三峽。"
        },
        "5": {
            "11": "承草書。"
        },
        "6": {
            "13": "王羲之《題衞夫人筆陣圖》：紙者陣也，筆者刀矟也，墨者鍪甲也，硯者城池也，本領者將軍也，心意者副將也。"
        },
        "7": {
            "15": "《戰國策》：楚有養由基者，去柳葉百步而射之，百發百中。"
        },
        "8": {
            "17": "仇注：蹶蹄應驊騮，惜其不遇也。排風應鷙鳥，望其終達也。"
        },
        "9": {
            "19": "上文多少解慰，只兩句合到自家，自見嗚咽。"
        },
        "10": {
            "21": "趙壹詩："
        },
        "11": {
            "23": "沈云：咳唾自成珠。"
        },
        "12": {
            "25": "二句謂汝自無憾，但我年不再少也。"
        },
        "13": {
            "27": "一作澹。"
        },
        "14": {
            "29": "徒可切。"
        },
        "15": {
            "31": "富嘉謨詩：春光淡沱度千門。淡沱，猶淡蕩也。"
        },
        "16": {
            "33": "寫景極其慘黯。"
        },
        "17": {
            "35": "陳子高詩：花片攪春心。"
        },
        "18": {
            "37": "此首醉歌意只末處一點。"
        },
        "19": {
            "39": "浦二田云：以半老人送少年，以落魄人送下第，情緖自爾纏綿愷惻。◯首贊其才，中慰其遇，後惜其別，章法易明。"
        },
        "20": {
            "41": "李云：眞氣溢於行間。"
        },
        "21": {
            "43": "沈云：送別情景突然接入，開後人無限法門。"
        },
        "22": {
            "45": "劉須溪云：人有此情，寫得不濃至而止。"
        }
    }
}