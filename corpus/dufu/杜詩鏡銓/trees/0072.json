{
    "0072": {
        "篇名": "城西陂泛舟",
        "1": {
            "3": "西陂卽渼陂，上詩已見。"
        },
        "2": {
            "5": "二句承樓船。"
        },
        "3": {
            "7": "《古詩》：象牙作帆檣。"
        },
        "4": {
            "9": "《吳志》：甘寧嘗以繒錦維舟，去輒割棄。張正見詩：金堤分錦纜。"
        },
        "5": {
            "11": "仇注：搖指水中扇影。"
        },
        "6": {
            "13": "末二正以襯出末二正以襯出。"
        },
        "7": {
            "15": "濃麗猶近初唐。◯此詩當有所指，如《麗人行》之類。觀「在」字自是望中，不必身與。"
        },
