{
    "0089": {
        "篇名": "送蔡希魯〈異文*題注*一作曾〉都尉還隴右因寄高三十五書記",
        "1": {
            "3": "原注：時哥舒入奏，勒蔡子先歸。《舊唐書》：諸府折衝都尉各一人，季冬敎軍陣戰鬥之法。朱注：天寶十四載春，哥舒翰入朝，道得風疾，遂留京師。故蔡都尉先歸而公送之也。"
        },
        "2": {
            "5": "先形容志氣。"
        },
        "3": {
            "7": "次形容才技。"
        },
        "4": {
            "9": "《韻會》：匼匝，周繞貌。謂金絡馬頭。"
        },
        "5": {
            "11": "次寫往來行色。"
        },
        "6": {
            "13": "《唐書》：哥舒翰在隴右，每遣使入奏，常乘白橐駝，日馳五百里。錦模糊，謂以錦帕蒙之。"
        },
        "7": {
            "15": "《元和郡國志》：雪山在瓜州，南連吐谷渾界。"
        },
        "8": {
            "17": "方及送還隴右。"
        },
        "9": {
            "19": "指哥舒。"
        },
        "10": {
            "21": "《唐志》：涼州爲武威郡。",
            "22": "《通典》：涼州貢白小麥十石。"
        },
        "11": {
            "24": "末帶寄高。"
        },
        "12": {
            "26": "朱注：好在乃存問之詞。《通鑑》：高力士宣上皇誥曰：諸將士各好在。"
        },
        "13": {
            "28": "全首警拔。◯蔣云：代說二句，如聞其聲。"
        },
        "14": {
            "30": "徒了且。"
        },
        "15": {
            "32": "模"
        },
        "16": {
            "34": "一作水。"
        },
        "17": {
            "36": "===== STABLE BOUNDARY =====",
            "37": "重現名單：0622",
            "38": "上"
        }
    }
}