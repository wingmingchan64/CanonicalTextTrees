{
    "0004": {
        "篇名": "題張氏隱居二首",
        "1": {
            "3": "次首當是數至後再題。"
        },
        "2": {
            "5": "與鳥鳴山更幽同旨。"
        },
        "3": {
            "7": "王阮亭云：情景倶佳。"
        },
        "4": {
            "9": "邵子湘云：中有至理。"
        },
        "5": {
            "11": "《史·天官書》：敗軍場，亡國之墟，下有積錢，金寶之上皆有氣，不可不察。按：南史載梁隱士孔祐至行通神，嘗見四明山谷中有錢數百斛，視之如瓦石，樵人競取，入手卽成沙礫。又東坡謂深山大澤，有天地之寶，惟無意於寶者能識之。卽此句義也。"
        },
        "6": {
            "13": "謂如入桃源。"
        },
        "7": {
            "15": "謂無心與化。",
            "16": "《莊子》：方舟而濟於河，有虛船來觸舟，雖褊心之人不怒。"
        },
        "8": {
            "18": "用經不腐。"
        },
        "9": {
            "20": "《急就篇》注：杜康作秫酒。"
        },
        "10": {
            "22": "潘岳《閒居賦》：張公大谷之梨。"
        },
        "11": {
            "24": "蔣弱六云：寫其居其人，皆迥絕塵凡，杳不可卽。"
        },
        "12": {
            "26": "顧修遠云：巧對蘊藉不覺。"
        }
    }
}