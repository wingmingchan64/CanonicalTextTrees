{
    "0077": {
        "篇名": "苦雨奉寄隴西公兼呈王徵士",
        "1": {
            "3": "原注：隴西公，卽漢中王瑀。徵士，琅邪王澈。《舊唐書》：瑀，讓皇帝第六子，初封隴西公，十五載從玄宗幸蜀，因封漢中王，乃汝陽王璡之弟。"
        },
        "2": {
            "5": "以下寄隴西。"
        },
        "3": {
            "7": "音產。"
        },
        "4": {
            "9": "潘岳《西征賦》：南有玄灞、素滻。",
            "10": "《長安志》：滻水在萬年縣流入渭。"
        },
        "5": {
            "12": "《三輔黃圖》：渭水貫都，以象天漢。"
        },
        "6": {
            "14": "《周禮》：馬八尺以上爲龍，七尺以上爲騋，六尺爲馬。"
        },
        "7": {
            "16": "趙曰：鴻孤飛則逐伴而急疾，此言身跨馬背若飛鴻孤征也。"
        },
        "8": {
            "18": "以下呈王。"
        },
        "9": {
            "20": "張華《鷦鷯賦》；蒼鷹鷙而受緤，屈猛志以服養。"
        },
        "10": {
            "22": "言求食無所。"
        },
        "11": {
            "24": "謂王。"
        },
        "12": {
            "26": "自指。"
        },
        "13": {
            "28": "四句欲約王同遊以遣愁寂。"
        },
        "14": {
            "30": "張云：二句寫盡久雨氤氳光景。"
        },
        "15": {
            "32": "===== STABLE BOUNDARY =====",
            "33": "重現名單：0476",
            "34": "所,悄,迢"
        }
    }
}