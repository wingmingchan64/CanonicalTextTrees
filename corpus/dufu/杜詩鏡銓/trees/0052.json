{
    "0052": {
        "篇名": "送裴二虬尉永嘉",
        "1": {
            "3": "《唐書》：永嘉縣屬溫州。"
        },
        "2": {
            "5": "謝靈運有《登江中孤嶼詩》。《寰宇記》：孤嶼在永嘉江中，嶼有二峯，謝靈運所遊，後人建亭其上。"
        },
        "3": {
            "7": "起五六。"
        },
        "4": {
            "9": "起七八。"
        },
        "5": {
            "11": "《漢書》：梅福補南昌尉，棄妻子去隱於會稽，至今傳爲仙。"
        },
        "6": {
            "13": "前四格高，倒起有憑虛御風之致。"
        }
    }
}