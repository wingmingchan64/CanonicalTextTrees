{
    "0100": {
        "篇名": "送率府程錄事還鄕",
        "1": {
            "3": "原注：程攜酒饌相就取別。唐六典：太子左右衞率府有錄事參軍。"
        },
        "2": {
            "5": "張云：與下聰明相反。"
        },
        "3": {
            "7": "對衰謝。"
        },
        "4": {
            "9": "對傑立。◯《易》：龍蛇之蟄，以存身也。言己之避亂潛踪，如修蛇之蟄，而程之義足以相感動也。"
        },
        "5": {
            "11": "楊子：墨突不黔。黔，黑也。"
        },
        "6": {
            "13": "言程方啟行，己不能設餞而反蒙饋遺也。"
        },
        "7": {
            "15": "二句感此觸彼情緒宛然。"
        },
        "8": {
            "17": "二句述時景兼影世事。"
        },
        "9": {
            "19": "按戢羽卽指還鄕言，下句乃戒其輕出也。"
        },
        "10": {
            "21": "盧注：鶻聞人呼則向禽而擊。朱注：上云與語才傑立，意程錄事必負才敢爲者。然世難方殷，當思斂戢，故又以向禽之鶻戒之。"
        },
        "11": {
            "23": "===== STABLE BOUNDARY =====",
            "24": "重現名單：0710",
            "25": "人,不,相,見"
        }
    }
}