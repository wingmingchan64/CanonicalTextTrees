{
    "0024": {
        "篇名": "送孔巢父謝病歸遊江東兼呈李白",
        "1": {
            "3": "一云。三珠樹。",
            "4": "虵",
            "5": "隂",
            "6": "廻",
            "7": "旡",
            "8": "丗",
            "9": "一云。我欲苦留君富貴。何如草頭易晞露。",
            "10": "歳",
            "11": "一云。深山大澤龍虵遠。華繁草青風景暮。仙人玉女回雲車。指點虛旡引歸路。若逢李白騎鯨魚。道甫問信今何如。"
        },
        "2": {
            "13": "===== STABLE BOUNDARY =====",
            "14": "重現名單：0111",
            "15": "頭,留,欲,是,君,有,何,如,何如"
        }
    }
